e, reportReturnType=false, reportAssignmentType=false, reportOptionalOperand=false, reportUnnecessaryComparison=false, reportUnusedFunction=false, reportUnusedVariable=false, reportUnboundVariable=false, reportUnknownLambdaType=false, reportUnusedClass=false\n","import time as _time\n","from datetime import datetime as _dt, timezone as _tz\n","from collections.abc import Callable\n","\n","def build_few_shot_prompt(question: str) -> str:\n","    \"\"\"Build few-shot prompt with full DDL and worked examples.\"\"\"\n","    examples_text = \"\"\n","    for ex in FEW_SHOT_EXAMPLES:\n","        examples_text += f\"Q: {ex['question']}\\nSQL: {ex['sql']}\\n\\n\"\n","    return FEW_SHOT_PROMPT.format(\n","        schema=SCHEMA_DDL,\n","        examples=examples_text.strip(),\n","        question=question\n","    )\n","\n","def evaluate_generated_sql(conn: sqlite3.Connection, generated_sql: str, question_id: str) -> dict[str, object]:\n","    \"\"\"Execute generated SQL and compare to ground truth.\"\"\"\n","    result = {\"executed\": False, \"correct\": False, \"error\": None, \"rows\": 0}\n","    try:\n","        h, n_rows, err = get_result_hash(conn, generated_sql)\n","        if err:\n","            result[\"error\"] = err\n","            return result\n","        result[\"executed\"] = True\n","        result[\"rows\"] = n_rows\n","        result[\"hash\"] = h\n","        if question_id in GROUND_TRUTH:\n","            result[\"correct\"] = (h == GROUND_TRUTH[question_id])\n","    except Exception as e:\n","        result[\"error\"] = str(e)\n","    return result\n","\n","def run_benchmark(\n","    model_keys: list[str],\n","    questions: list[dict[str, str]] | None = None,\n","    strategy: str = \"few_shot\",\n","    prompt_builder: Callable[[str], str] | None = None,\n","    conn: sqlite3.Connection | None = None,  # type: ignore[assignment]\n",") -> pd.DataFrame:\n","    \"\"\"Run full benchmark: models × questions → results DataFrame.\"\"\"\n","    if questions is