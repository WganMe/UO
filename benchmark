    "                    \"U\": round(stat, 2), \"p_mwu\": round(p, 6),\n",
    "                    \"cliffs_d\": d, \"effect_label\": cliffs_delta_label(d),\n",
    "                    \"cohens_h\": cohens_h(p1, p2),\n",
