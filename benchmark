b.md5(result_str.encode()).hexdigest(), len(rows), None\n","    except Exception as e:\n","        return None, 0, str(e)\n","\n","# === SQLite UDF helpers (also redefined in next cell) ===\n","import sqlite3, math\n","class _Variance:\n","    \"\"\"Population variance aggregate: VAR_POP / VARIANCE.\"\"\"\n","    def __init__(self):\n","        self.vals: list[float] = []\n","    def step(self, value):\n","        if value is not None:\n","            self.vals.append(float(value))\n","    def finalize(self):\n","        if not self.vals:\n","            return None\n","        mu = sum(self.vals) / len(self.vals)\n","        return sum((x - mu) ** 2 for x in self.vals) / len(self.vals)\n","\n","class _StdDev:\n","    \"\"\"Population standard deviation aggregate: STDDEV / STDEV / STDDEV_POP.\"\"\"\n","    def __init__(self):\n","        self.vals: list[float] = []\n","    def step(self, value):\n","        if value is not None:\n","            self.vals.append(float(value))\n","    def finalize(self):\n","        if not self.vals:\n","            return None\n","        mu = sum(self.vals) / len(self.vals)\n","        var = sum((x - mu) ** 2 for x in self.vals) / len(self.vals)\n","        return math.sqrt(var)\n","\n","class _StdDevSamp:\n","    \"\"\"Sample standard deviation aggregate: STDDEV_SAMP.\"\"\"\n","    def __init__(self):\n","        self.vals: list[float] = []\n","    def step(self, value):\n","        if value is not None:\n","            self.vals.append(float(value))\n","    def finalize(self):\n","        if len(self.vals) < 2:\n","            return None\n","        mu = sum(self.vals) / len(self.vals)\n","        var = sum((x - mu) ** 2 for x in self.vals) / (len(self.vals) - 1)\n","        return math.sqrt(var)\n","\n","def _register_sqlite_udfs(conn: sqlite3.Connection):\n","    \"\"\"Register common statistical functions that SQLite lacks natively.\"\"\"\n","    conn.create_aggregate(\"VARIANCE\", 1, _Variance)\n","    conn.create_aggregate(\"VAR_POP\", 1, _Variance)\n","    conn.create_aggregate(\"STDDEV\", 1, _StdDev)\n","    conn.create_aggregate(\"STDEV\", 1, _StdDev)\n","    conn.create_aggregate(\"STDDEV_POP\", 1, _StdDev)\n","    conn.create_aggregate(\"STDDEV_SAMP\", 1, _StdDevSamp)\n","    # DATEDIFF(unit, start, end) — returns integer difference\n","    def _datediff(unit, start, end):\n","        from datetime import datetime\n","        try:\n","            fmt = \"%Y-%m-%dT%H:%M:%S\" if \"T\" in str(start) else \"%Y-%m-%d %H:%M:%S\"\n","            d1 = datetime.strptime(str(start)[:19], fmt)\n","            d2 = datetime.strptime(str(end)[:19], fmt)\n","            delta = d2 - d1\n","            unit = str(unit).upper()\n","            if unit in (\"DAY\", \"DAYS\", \"D\", \"DD\"):\n","                return delta.days\n","            if unit in (\"HOUR\", \"HOURS\", \"HH\"):\n","                return int(delta.total_seconds() // 3600)\n","            if unit in (\"MINUTE\", \"MINUTES\", \"MI\", \"N\"):\n","                return int(delta.total_seconds() // 60)\n","            if unit in (\"SECOND\", \"SECONDS\", \"SS\", \"S\"):\n","                return int(delta.total_seconds())\n","            return delta.days  # default to days\n","        except Exception:\n","            return None\n","    conn.create_function(\"DATEDIFF\", 3, _datediff)\n","\n","validation_conn = sqlite3.connect(DB_PATH)\n","_register_sqlite_udfs(validation_conn)\n","results: list[dict[str, object]] = []\n","for q in BENCHMARK_QUESTIONS:\n","    h, n_rows, err = get_result_hash(validation_conn, q[\"sql\"])\n","    results.append({\n","        \"id\": q[\"id\"], \"tier\": q[\"tier\"],\n","        \"hash\": h, \"rows\": n_rows, \"error\": err\n","    })\n","    status = f\"OK ({n_rows} rows)\" if err is None else f\"ERROR: {err}\"\n","    print(f\"  {q['id']}: {status}\")\n","\n","passed = sum(1 for r in results if r[\"error\"] is None)\n","print(f\"\\\n","Validation: {passed}/{len(BENCHMARK_QUESTIONS)} queries executed successfully\")\n","\n","# Store ground-truth hashes for later comparison\n","GROUND_TRUTH = {r[\"id\"]: r[\"hash\"] for r in results if r[\"error\"] is None}\n","print(f\"Ground-truth hashes stored: {len(GROUND_TRUTH)}\")\n","validation_conn.close()\n"]},{"cell_type":"code","execution_count":30,"id":"5d026e64","metadata":{"execution":{"iopub.execute_input":"2026-08-30T04:35:28.191231Z","iopub.status.busy":"2026-08-30T04:35:28.190467Z","iopub.status.idle":"2026-08-30T04:35:28.231026Z","shell.execute_reply":"2026-08-30T04:35:28.229796Z"},"papermill":{"duration":0.103311,"end_time":"2026-08-30T04:35:28.233434","exception":false,"start_time":"2026-08-30T04:35:28.130123","status":"completed"},"tags":[]},"outputs":[],"source":["# pyright: reportUnknownMemberType=false, reportUnknownVariableType=false, reportUnknownArgumentType=false, reportMissingTypeStubs=false, reportIndexIssue=false, reportUnknownParameterType=false, reportAttributeAccessIssue=false, reportCallIssue=false, reportOperatorIssue=false, reportConstantRedefinition=false, reportPossiblyUnboundVariable=false, reportMissingImports=false, reportUnnecessaryIsInstance=false, reportPrivateImportUsage=false, reportMissingParameterType=false, reportUnusedImport=false, reportArgumentType=false, reportMissingTypeArgument=false, reportUndefinedVariable=false, reportGeneralTypeIssues=false, reportOptionalMemberAccess=false, reportOptionalSubscript=false, reportOptionalIterable=false, reportOptionalCall=false, reportReturnType=false, reportAssignmentType=false, reportOptionalOperand=false, reportUnnecessaryComparison=false, reportUnusedFunction=false, reportUnusedVariable=false, reportUnboundVariable=false, reportUnknownLambdaType=false, reportUnusedClass=false\n","# ── NL-to-SQL Benchmark Runner ────────────────────────────────────────────────\n","# Runs BENCHMARK_QUESTIONS × MODEL_PANEL, executes each SQL against the\n","# SQLite database, saves a row per (question, model) to CSV after every call\n","# so the