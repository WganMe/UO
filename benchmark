    "# pyright: reportUnknownMemberType=false, reportUnknownVariableType=false, reportUnknownArgumentType=false, reportMissingTypeStubs=false, reportIndexIssue=false, reportUnknownParameterType=false, reportAttributeAccessIssue=false, reportCallIssue=false, reportOperatorIssue=false, reportConstantRedefinition=false, reportPossiblyUnboundVariable=false, reportMissingImports=false, reportUnnecessaryIsInstance=false, reportPrivateImportUsage=false, reportMissingParameterType=false, reportUnusedImport=false, reportArgumentType=false, reportMissingTypeArgument=false, reportUndefinedVariable=false, reportGeneralTypeIssues=false, reportOptionalMemberAccess=false, reportOptionalSubscript=false, reportOptionalIterable=false, reportOptionalCall=false, reportReturnType=false, reportAssignmentType=false, reportOptionalOperand=false, reportUnnecessaryComparison=false, reportUnusedFunction=false, reportUnusedVariable=false, reportUnboundVariable=false, reportUnknownLambdaType=false, reportUnusedClass=false\n",
    "# === Kaggle Secrets loader with retry/poll (no-op outside Kaggle) ===\n",
    "# Kaggle attaches secrets *asynchronously* on Save Version: the kernel can\n",
    "# start before the secret store is populated. This cell polls until either\n",
    "# the critical secrets appear or the timeout elapses, then exposes a helper\n",
    "# `ensure_secrets()` that downstream cells can call before they actually need\n",
    "# the env vars (cheap no-op once secrets are loaded).\n",
    "import os, time\n",
    "\n",
    "# Critical secrets — at least ONE of these must be present for the LLM\n",
    "# benchmark cell (cell 50) to do anything useful.\n",
    "_CRITICAL_KEYS = [\"GITHUB_PAT\"]\n",
    "\n",
    "# All secrets the notebook knows about. We keep trying for any that are\n",
    "# missing as long as the kernel is alive (downstream call to ensure_secrets()).\n",
    "_SECRET_KEYS = [\n",
    "    \"GITHUB_PAT\",\n",
    "    \"HF_TOKEN\",\n",
    "    \"KAGGLE_API_TOKEN\",\n",
    "    \"KAGGLE_KEY\",\n",
    "    \"KAGGLE_USERNAME\",\n",
    "    \"NGROK_AUTHTOKEN\",\n",
    "    \"OLLAMA_KEEP_ALIVE\",\n",
    "    \"OLLAMA_MAX_LOADED_MODELS\",\n",
    "]\n",
    "\n",
    "def _apply_aliases() -> None:\n",
    "    \"\"\"Mirror primary keys onto the canonical aliases used elsewhere.\"\"\"\n",
    "    if os.environ.get(\"GITHUB_PAT\") and not os.environ.get(\"GITHUB_TOKEN\"):\n",
    "        os.environ[\"GITHUB_TOKEN\"] = os.environ[\"GITHUB_PAT\"]\n",
    "\n",
    "def _try_load_once(client) -> tuple[list[str], list[str]]:\n",
    "    \"\"\"Single pass over _SECRET_KEYS; returns (loaded, missing).\"\"\"\n",
    "    loaded, missing = [], []\n",
    "    for k in _SECRET_KEYS:\n",
    "        if os.environ.get(k):\n",
    "            loaded.append(k)\n",
    "            continue\n",
    "        try:\n",
    "            v = client.get_secret(k)\n",
    "            if v:\n",
    "                os.environ[k] = v\n",
    "                loaded.append(k)\n",
    "            else:\n",
    "                missing.append(k)\n",
    "        except Exception:\n",
    "            missing.append(k)\n",
