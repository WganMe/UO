eping it cached makes kbench's import raise\n","        # \"A Message class can only inherit from Message\" on its own gencode.\n","        _purge_prefixes = (\n","            \"google.protobuf\",\n","            \"google._upb\",\n","            \"kaggle\",\n","            \"kaggle_benchmarks\",\n","            \"kagglesdk\",\n","            \"grpc\",\n","            \"googleapiclient\",\n","        )\n","        for _m in list(_sys.modules):\n","            if any(_m == p or _m.startswith(p + \".\") for p in _purge_prefixes):\n","                del _sys.modules[_m]\n","        import kaggle_benchmarks as kbench  # type: ignore\n","        _KBENCH_LLMS = dict(kbench.llms)\n","        _KBENCH_AVAILABLE = bool(_KBENCH_LLMS)\n","        _names = sorted(_KBENCH_LLMS.keys())\n","        if _names:\n","            print(f\"✓ kaggle_benchmarks: {len(_names)} LLMs available\")\n","            for _n in _names:\n","                print(f\"    - {_n}\")\n","            # Curated 10-model frontier subset to stay inside the\n","            # $10/day Daily AI quota. Frontier picks for thesis value:\n","            # Claude Opus/Sonnet, Gemini Pro, GPT-5.x, Grok-4.20, Qwen3-Coder, GLM-5.\n","            _KBENCH_PRIORITY = [\n","                \"anthropic/claude-opus-4-7@default\",\n","                \"anthropic/claude-sonnet-4-6@default\",\n","                \"google/gemini-3.1-pro-preview\",\n","                \"google/gemini-2.5-pro\",\n","                \"google/gemini-2.5-flash\",\n","                \"openai/gpt-5.5-2026-04-23\",\n","                \"openai/gpt-5.4-mini-2026-03-17\",\n","                \"xai/grok-4.20-0309-reasoning\",\n","                \"qwen/qwen3-coder-480b-a35b-instruct\",\n","                \"zai/glm-5\",\n","            ]\n","            _kb_panel = [f\"kbench/{_n}\" for _n in _KBENCH_PRIORITY if _n in _KBENCH_LLMS]\n","            _skipped = [_n for _n in _names if _n not in _KBENCH_PRIORITY]\n","            _existing = set(MODEL_PANEL)\n"