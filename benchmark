    "# pyright: reportUnknownMemberType=false, reportUnknownVariableType=false, reportUnknownArgumentType=false, reportMissingTypeStubs=false, reportIndexIssue=false, reportUnknownParameterType=false, reportAttributeAccessIssue=false, reportCallIssue=false, reportOperatorIssue=false, reportConstantRedefinition=false, reportPossiblyUnboundVariable=false, reportMissingImports=false, reportUnnecessaryIsInstance=false, reportPrivateImportUsage=false, reportMissingParameterType=false, reportUnusedImport=false, reportArgumentType=false, reportMissingTypeArgument=false, reportUndefinedVariable=false, reportGeneralTypeIssues=false, reportOptionalMemberAccess=false, reportOptionalSubscript=false, reportOptionalIterable=false, reportOptionalCall=false, reportReturnType=false, reportAssignmentType=false, reportOptionalOperand=false, reportUnnecessaryComparison=false, reportUnusedFunction=false, reportUnusedVariable=false, reportUnboundVariable=false, reportUnknownLambdaType=false, reportUnusedClass=false\n",
    "# === Incremental top-up: fetch ONLY the gap (archive_max_ts → now) ===\n",
    "# Uses Parquet column statistics (footer metadata) — never loads any data\n",
    "# into RAM. Memory cost is O(n_files) ≈ tens of MB, NOT O(n_rows).\n",
    "\n",
    "from datetime import datetime, timezone\n",
    "\n",
    "TOPUP_PATH = DATA_EXPORT / \"archive_topup.parquet\"\n",
    "\n",
    "\n",
    "def archive_max_timestamp() -> datetime | None:\n",
    "    \"\"\"Return the latest timestamp in the bulk archive, read from Parquet\n",
    "    footer statistics. Does not load any row data.\"\"\"\n",
    "    if not ARCHIVE_BULK_AVAILABLE or not ARCHIVE_FILES:\n",
    "        return None\n",
    "    best: datetime | None = None\n",
    "    for p in ARCHIVE_FILES:\n",
    "        try:\n",
    "            pf = pq.ParquetFile(p)\n",
    "            md = pf.metadata\n",
    "            names = pf.schema_arrow.names\n",
    "            if \"timestamp\" not in names:\n",
    "                continue\n",
    "            col_idx = names.index(\"timestamp\")\n",
    "            for rg in range(md.num_row_groups):\n",
    "                stats = md.row_group(rg).column(col_idx).statistics\n",
    "                if stats is None or stats.max is None:\n",
    "                    continue\n",
    "                v = stats.max\n",
    "                if isinstance(v, datetime):\n",
    "                    if v.tzinfo is None:\n",
    "                        v = v.replace(tzinfo=timezone.utc)\n",
    "                    if best is None or v > best:\n",
    "                        best = v\n",
    "        except Exception:\n",
    "            continue\n",
    "    return best\n",
    "\n",
    "\n",
    "def topup_archive(run: bool = False) -> None:\n",
    "    \"\"\"Fetch only the API window (archive_max_ts → now) for ALL_VARIABLES.\"\"\"\n",
    "    if not ARCHIVE_BULK_AVAILABLE:\n",
    "        print(\"ARCHIVE_BULK missing -> nothing to top up.\")\n",
    "        return\n",
    "    max_ts = archive_max_timestamp()\n",
    "    if max_ts is None:\n",
