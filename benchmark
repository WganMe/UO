    "_SNAPSHOT_MIN_INTERVAL_S = 60.0  # at most one push per minute\n",
    "def _snapshot_results_csv(reason: str = \"\", csv_name: str = \"all_experiment_results.csv\"):\n",
    "    \"\"\"Best-effort dataset version push. Silent on failure; non-blocking on success.\"\"\"\n",
    "    try:\n",
    "        _is_kg = bool(os.environ.get(\"KAGGLE_KERNEL_RUN_TYPE\")) or Path(\"/kaggle/working\").exists()\n",
    "    except Exception:\n",
    "        _is_kg = False\n",
    "    if not _is_kg:\n",
    "        return\n",
    "    _now = time.time()\n",
    "    if _now - _LAST_SNAPSHOT_T[0] < _SNAPSHOT_MIN_INTERVAL_S:\n",
    "        return\n",
    "    _csv = Path(f\"/kaggle/working/data_export/{csv_name}\")\n",
    "    if not _csv.exists() or _csv.stat().st_size == 0:\n",
    "        return\n",
    "    try:\n",
    "        _stage = Path(\"/kaggle/working/_results_snapshot\")\n",
    "        _stage.mkdir(parents=True, exist_ok=True)\n",
    "        _sh.copy2(_csv, _stage / csv_name)\n",
    "        _user = os.environ.get(\"KAGGLE_USERNAME\", _KAGGLE_USER_FALLBACK)\n",
    "        # The kaggle CLI needs KAGGLE_USERNAME + KAGGLE_KEY, not the bare\n",
    "        # KAGGLE_API_TOKEN secret name. Auto-bridge if needed.\n",
    "        if os.environ.get(\"KAGGLE_API_TOKEN\") and not os.environ.get(\"KAGGLE_KEY\"):\n",
