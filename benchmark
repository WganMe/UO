Issue=false, reportOperatorIssue=false, reportConstantRedefinition=false, reportPossiblyUnboundVariable=false, reportMissingImports=false, reportUnnecessaryIsInstance=false, reportPrivateImportUsage=false, reportMissingParameterType=false, reportUnusedImport=false, reportArgumentType=false, reportMissingTypeArgument=false, reportUndefinedVariable=false, reportGeneralTypeIssues=false, reportOptionalMemberAccess=false, reportOptionalSubscript=false, reportOptionalIterable=false, reportOptionalCall=false, reportReturnType=false, reportAssignmentType=false, reportOptionalOperand=false, reportUnnecessaryComparison=false, reportUnusedFunction=false, reportUnusedVariable=false, reportUnboundVariable=false, reportUnknownLambdaType=false, reportUnusedClass=false\n","# Full Newcastle Urban Observatory area (WGS84)\n","# Covers the entire metropolitan sensor deployment (~2,100 sensors)\n","# from Lemington in the west to Wallsend in the east,\n","# and from Gateshead/Bensham in the south to Gosforth in the north.\n","BBOX_NEWCASTLE = [-1.75, 54.93, -1.45, 55.03]\n","\n","# Also keep the city-centre sub-box for quick exploratory queries\n","BBOX_CITY_CENTRE = [-1.652756, 54.973377, -1.620483, 54.983721]\n","\n","# Fetch ALL sensor locations across the full area via pagination.\n","# The API rejects limit=-1 (500 error); we page in fixed batches until empty.\n","import pandas as pd\n","_PAGE = 500\n","_frames, _offset = [], 0\n","while True:\n","    try:\n","        _batch = uo_pyfetch.get_sensors(limit=_PAGE, offset=_offset, bbox=BBOX_NEWCASTLE)\n","    except Exception as _e:\n","        print(f\"  page offset={_offset} failed: {_e}\")\n","        break\n","    if _batch is None or len(_batch) == 0:\n","        break\n","    _frames.append(_batch)\n","    if len(_batch) < _PAGE:\n","        break\n","    _offset += _PAGE\n","sensors_df = pd.concat(_frames, ignore_index=True) if _frames else pd.DataFrame()\n","\n","# Fallback: if the live API is down (returns 500 on every call), derive\n","# distinct sensor metadata from the parquet snapshot. This keeps downstream\n","# cells (maps, summaries) usable without depending on the live service.\n","if len(sensors_df) == 0:\n","    print(\"  live API unavailable — deriving sensor list from parquet snapshot\")\n","    try:\n","        import duckdb, glob, os\n","        _candidates = []\n","        for _root in (\"/kaggle/input\", \".\"):\n","            _candidates.extend(glob.glob(os.path.join(_root, \"**\", \"*.parquet\"),\n","                                         recursive=True))\n","        if _candidates:\n","            _con = duckdb.connect()\n","            _glob = _candidates[0].rsplit(\"/\", 1)[0] + \"/*.parquet\"\n","            try:\n","                # Inspect schema first; UO parquet uses underscores not spaces.\n","                _cols = _con.execute(\n","                    f\"SELECT * FROM read_parquet('{_glob}') LIMIT 0\"\n","                ).df().columns.tolist()\n","                # Pick the right column names (handles both naming styles)\n","                def _pick(cands):\n","                    for c in cands:\n","                        if c in _cols: return c\n","                    return None\n","                _name = _pick([\"Sensor_Name\", \"Sensor Name\", \"sensor_name\"])\n","                _lon  = _pick([\"Sensor_Centroid_Longitude\", \"Sensor Centroid Longitude\", \"longitude\"])\n","                _lat  = _pick([\"Sensor_Centroid_Latitude\",  \"Sensor Centroid Latitude\",  \"latitude\"])\n","                if not (_name and _lon and _lat):\n","                    raise RuntimeError(f\"missing expected columns; have {_cols[:8]}…\")\n","                sensors_df = _con.execute(f\"\"\"\n","                    SELECT DISTINCT \"{_name}\" AS \"Sensor Name\",\n","                           \"{_lon}\"  AS \"Sensor Centroid Longitude\",\n","                           \"{_lat}\"  AS \"Sensor Centroid Latitude\"\n","                    FROM read_parquet('{_glob}')\n","                    WHERE \"{_lon}\" BETWEEN {BBOX_NEWCASTLE[0]} AND {BBOX_NEWCASTLE[2]}\n","                      AND \"{_lat}\" BETWEEN {BBOX_NEWCASTLE[1]} AND {BBOX_NEWCASTLE[3]}\n","                \"\"\").df()\n","            except Exception as _e:\n","                print(f\"  parquet snapshot query failed: {_e}\")\n","            _con.close()\n","    except Exception as _e:\n","        print(f\"  parquet fallback failed: {_e}\")\n","\n","print(f\"Sensors found in full UO area : {len(sensors_df)}\")\n","print(f\"(City-centre sub-box previously returned only 56)\")\n","if len(sensors_df):\n","    print(f\"Columns: {list(sensors_df.columns)}\")\n","    print()\n","sensors_df.head(10)"]},{"cell_type":"markdown","id":"f10b4e9b","metadata":{"papermill":{"duration":0.039015,"end_time":"2026-08-30T04:34:19.352894","exception":false,"start_time":"2026-08-30T04:34:19.313879","status":"completed"},"tags":[]},"source":["## 5. Normalize JSON Responses into DataFrames"]},{"cell_type":"code","execution_count":11,"id":"436181a2","metadata":{"execution":{"iopub.execute_input":"2026-08-30T04:34:19.428097Z","iopub.status.busy":"2026-08-30T04:34:19.427446Z","iopub.status.idle":"2026-08-30T04:34:23.784322Z","shell.execute_reply":"2026-08-30T04:34:23.782911Z"},"papermill":{"duration":4.398719,"end_time":"2026-08-30T04:34:23.786772","exception":false,"start_time":"2026-08-30T04:34:19.388053","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Raw JSON keys: ['Readings', 'Sensors', 'Start', 'End', 'Pagination']\n","Readings count: 5\n","Sensors dict keys: ['PER_AIRMON_MESH1907150', 'PER_AIRMON_MESH1921150', 'PER_AIRMON_MESH1965150']\n","\n"]},{"name":"stdout","output_type":"stream","text":["DataFrame shape: (100, 12)\n","Dtypes:\n","Sensor_Name                                   object\n","Variable                                      object\n","Value                                        float64\n","Timestamp                   