    "        correct=(\"correct\", \"sum\"),\n",
    "    ).reset_index()\n",
    "    summary[\"accuracy\"]   = (summary[\"correct\"] / summary[\"n\"]).round(4)\n",
    "    summary[\"wilson_ci\"]  = summary.apply(\n",
    "        lambda r: wilson_ci(int(r[\"correct\"]), int(r[\"n\"])), axis=1)\n",
    "    summary[\"bootstrap_ci\"] = summary.apply(\n",
    "        lambda r: bootstrap_ci(\n",
    "            df[(df[\"strategy\"] == r[\"strategy\"]) &\n",
    "               (df[\"model_label\"] == r[\"model_label\"])][\"correct\"].tolist()), axis=1)\n",
    "    analysis[\"overall\"] = summary\n",
    "\n",
    "    # ── Per-tier accuracy ─────────────────────────────────────────────────\n",
    "    tier_summary = df.groupby([\"strategy\", \"model_label\", \"tier\"]).agg(\n",
    "        n=(\"correct\", \"count\"),\n",
    "        correct=(\"correct\", \"sum\"),\n",
