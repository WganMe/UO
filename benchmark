    "    conn.create_aggregate(\"STDEV\", 1, _StdDev)\n",
    "    conn.create_aggregate(\"STDDEV_POP\", 1, _StdDev)\n",
    "    conn.create_aggregate(\"STDDEV_SAMP\", 1, _StdDevSamp)\n",
    "    # DATEDIFF(unit, start, end) — returns integer difference\n",
    "    def _datediff(unit, start, end):\n",
    "        from datetime import datetime\n",
    "        try:\n",
    "            fmt = \"%Y-%m-%dT%H:%M:%S\" if \"T\" in str(start) else \"%Y-%m-%d %H:%M:%S\"\n",
    "            d1 = datetime.strptime(str(start)[:19], fmt)\n",
    "            d2 = datetime.strptime(str(end)[:19], fmt)\n",
    "            delta = d2 - d1\n",
    "            unit = str(unit).upper()\n",
    "            if unit in (\"DAY\", \"DAYS\", \"D\", \"DD\"):\n",
    "                return delta.days\n",
    "            if unit in (\"HOUR\", \"HOURS\", \"HH\"):\n",
    "                return int(delta.total_seconds() // 3600)\n",
    "            if unit in (\"MINUTE\", \"MINUTES\", \"MI\", \"N\"):\n",
    "                return int(delta.total_seconds() // 60)\n",
    "            if unit in (\"SECOND\", \"SECONDS\", \"SS\", \"S\"):\n",
    "                return int(delta.total_seconds())\n",
    "            return delta.days  # default to days\n",
    "        except Exception:\n",
    "            return None\n",
    "    conn.create_function(\"DATEDIFF\", 3, _datediff)\n",
    "\n",
    "validation_conn = sqlite3.connect(DB_PATH)\n",
    "_register_sqlite_udfs(validation_conn)\n",
