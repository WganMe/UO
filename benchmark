    "        if not os.environ.get(\"KAGGLE_USERNAME\"):\n",
    "            os.environ[\"KAGGLE_USERNAME\"] = _user\n",
    "        _meta = {\n",
    "            \"title\": \"Urban Observatory — Benchmark Results (rolling)\",\n",
    "            \"id\": f\"{_user}/urban-observatory-results\",\n",
    "            \"licenses\": [{\"name\": \"CC0-1.0\"}],\n",
    "        }\n",
    "        (_stage / \"dataset-metadata.json\").write_text(_json.dumps(_meta, indent=2))\n",
    "        try:\n",
    "            _n = sum(1 for _ in open(_csv)) - 1\n",
