    "        _gh_avail_fn = globals().get(\"_gh_available\", lambda m: True)\n",
    "\n",
    "        _consecutive_stalls = 0\n",
    "        while _models_active:\n",
    "            _progress = False\n",
    "            for _model in list(_models_active):\n",
    "                if not _pending[_model]:\n",
    "                    _models_active.remove(_model); continue\n",
    "                # Skip GitHub Models that are still in cooldown.\n",
    "                if not _gh_avail_fn(_model):\n",
    "                    continue\n",
    "                # Skip cooled Ollama models too\n",
    "                _ol_avail_fn = globals().get(\"_ollama_available\", lambda m: True)\n",
    "                if _model.startswith(\"ollama/\") and not _ol_avail_fn(_model[len(\"ollama/\"):]):\n",
    "                    continue\n",
    "                _q = _pending[_model].popleft()\n",
    "                _i += 1\n",
    "                _prompt = _build_prompt(_q[\"question\"])\n",
    "                _t0 = time.time()\n",
    "                try:\n",
