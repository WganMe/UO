    "        ops = [0]\n",
    "        def _abort():\n",
    "            ops[0] += 1\n",
    "            if ops[0] > (SQL_MAX_OPS // 1000):\n",
    "                return 1\n",
    "            # Check wall-clock every ~500k VM ops to avoid syscall overhead\n",
    "            if ops[0] % 50 == 0 and _t.monotonic() > _deadline:\n",
    "                return 1\n",
    "            return 0\n",
    "        conn.set_progress_handler(_abort, 1000)\n",
    "        cur  = conn.execute(sql)\n",
    "        rows = cur.fetchmany(SQL_MAX_ROWS + 1)\n",
    "        if len(rows) > SQL_MAX_ROWS:\n",
    "            return None, f\"result too large (>{SQL_MAX_ROWS} rows)\"\n",
    "        return rows, None\n",
    "    except Exception as e:\n",
    "        msg = str(e)\n",
    "        if \"interrupted\" in msg.lower():\n",
    "            msg = f\"query timeout ({timeout_s:.0f}s)\"\n",
    "        return None, msg\n",
    "    finally:\n",
    "        if conn is not None:\n",
    "            try: conn.close()\n",
