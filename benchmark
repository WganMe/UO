]},{"name":"stdout","output_type":"stream","text":["  T1: 1.0902 (n=30)\n"]},{"name":"stdout","output_type":"stream","text":["  T2: 1.2613 (n=30)\n"]},{"name":"stdout","output_type":"stream","text":["  T3: 1.3692 (n=30)\n"]},{"name":"stdout","output_type":"stream","text":["  T4: 1.1976 (n=30)\n"]},{"name":"stdout","output_type":"stream","text":["  T5: 1.4437 (n=30)\n"]}],"source":["# pyright: reportUnknownMemberType=false, reportUnknownVariableType=false, reportUnknownArgumentType=false, reportMissingTypeStubs=false, reportIndexIssue=false, reportUnknownParameterType=false, reportAttributeAccessIssue=false, reportCallIssue=false, reportOperatorIssue=false, reportConstantRedefinition=false, reportPossiblyUnboundVariable=false, reportMissingImports=false, reportUnnecessaryIsInstance=false, reportPrivateImportUsage=false, reportMissingParameterType=false, reportUnusedImport=false, reportArgumentType=false, reportMissingTypeArgument=false, reportUndefinedVariable=false, reportGeneralTypeIssues=false, reportOptionalMemberAccess=false, reportOptionalSubscript=false, reportOptionalIterable=false, reportOptionalCall=false, reportReturnType=false, reportAssignmentType=false, reportOptionalOperand=false, reportUnnecessaryComparison=false, reportUnusedFunction=false, reportUnusedVariable=false, reportUnboundVariable=false, reportUnknownLambdaType=false, reportUnusedClass=false\n","def compute_rho_exposure(question: str, strategy: str) -> float:\n","    \"\"\"Compute schema exposure ratio for a given question and strategy.\"\"\"\n","    if strategy == \"few_shot\":\n","        return 1.0  # Full DDL always included\n","\n","    if strategy == \"naive\":\n","        retrieved_keys = retrieve_naive(question)\n","    elif strategy == \"enhanced\":\n","        retrieved_keys = retrieve_enhanced(question)\n","    else:\n","        return 1.0\n","\n","    schema_fragment = \"\\\n","\\\n","\".join(SCHEMA_CHUNKS[k] for k in retrieved_keys)\n","    fragment_tokens = len(enc.encode(schema_fragment))\n","    return round(fragment_tokens / SCHEMA_TOKEN_COUNT, 4)\n","\n","# ── Compute average ρ_exposure per strategy ──────────────────\n","for strategy in [\"few_shot\", \"naive\", \"enhanced\"]:\n","    rhos = [compute_rho_exposure(q[\"question\"], strategy) for q in BENCHMARK_QUESTIONS]\n","    mean_rho = np.mean(rhos)\n","    min_rho = np.min(rhos)\n","    max_rho = np.max(rhos)\n","    print(f\"{strategy:15s}: ρ_exposure = {mean_rho:.4f} (min={min_rho:.4f}, max={max_rho:.4f})\")\n","\n","# ── Per-tier breakdown for enhanced RAG ──────────────────────\n","print(\"\\\n","Enhanced RAG ρ_exposure by tier:\")\n","for tier in [\"T1\", \"T2\", \"T3\", \"T4\", \"T5\"]:\n","    tier_qs = [q for q in BENCHMARK_QUESTIONS if q[\"tier\"] == tier]\n","    rhos = [compute_rho_exposure(q[\"question\"], \"enhanced\") for q in tier_qs]\n","    print(f\"  {tier}: {np.mean(rhos):.4f} (n={len(tier_qs)})\")"]},{"cell_type":"markdown","id":"6db51d8f","metadata":{"papermill":{"duration":0.063239,"end_time":"2026-08-30T05:10:29.672564","exception":false,"start_time":"2026-08-30T05:10:29.609325","status":"completed"},"tags":[]},"source":["## 19. Statistical Analysis — PhD-Level Inference\n","\n","### 19.0 Research Hypotheses (IS-thesis form)\n","\n","#### Why this study uses hypotheses (not only research questions)\n","\n","This is an **Information Systems (IS)** thesis written in the **positivist paradigm**. According to Mbanaso, Abrahams & Okafor (2023), *Research Techniques for Computer Science, Information Systems and Cybersecurity* (Springer, ISBN 978-3-031-30031-8):\n","\n","- *\"Positivism depends on quantifiable observations that can lead to statistical analysis … Most positivist research approach adopts quantitative methodology and deductive reasoning, inferring that positivism depends on 'things' that are quantifiable through observations or experiments, and uses statistical analyses to draw conclusions.\"* (§6.2.6.1, Table 6.1, p. 87)\n","- *\"In quantitative research, the hypothesis formulation can be fairly extensive, setting out three or more hypotheses, each with a few hypothetical statements.\"* (§3.3.5, p. 30)\n","- *\"Deductive reasoning applies when we use the literature to create a hypothesis of what will occur, based on our understanding of theory, and then (later in the research process) make conclusions about whether the data collected fits the hypothesis or does not fit the hypothesis. In deductive reasoning, we move from the general (theory about X) to the specific (does the theory apply or not, how does it apply).\"* (§5.2.3, p. 63)\n","- *\"Doxology is expressed in the validity of the theoretical assumptions and in the formulation of the hypothesis, which the research needs to test to verify and validate it as 'knowledge'.\"* (§6.2.4, p. 86)\n","\n","The benchmark in §13–§17 is therefore framed as a **deductive, positivist, quantitative IS experiment**: theory predicts that schema-aware retrieval, larger model capacity, lower question complexity, and higher schema exposure each improve NL-to-SQL execution accuracy; the four hypotheses below operationalise those predictions so that the experimental data can refute them.\n","\n","#### What a hypothesis is, and why we have two of them\n","\n","A **hypothesis** in IS research is a specific, testable, falsifiable prediction — written *before* data are collected — that answers a research question on the basis of existing theory or prior evidence (Mbanaso et al., 2023, §3.3.5, §5.2.3). Statistical convention requires the prediction to be split into two complementary statements:\n","\n","- **Null hypothesis ($H_0$)** — the working assumption of *no* association/difference between the independent and dependent variables. It is never \"proved\"; it is only **rejected** or **not rejected**.\n","  - **Lind Ch 10, Step 1**: *\"the null hypothesis is a statement that is not rejected unless our sample data provide convincing evidence that it is false.\"*\n","  - **Walpole §10.1**: *\"rejection of a hypothesis tends to all but rule out the hypothesis. … failure to reject does not rule out other possibilities.\"* (p. 340)\n","- **Alternative hypothesis ($H_1$)** — the IS-theoretical claim we accept by *rejecting* $H_0$. It cannot be tested directly; it is established only when statistical evidence shows the observed difference is unlikely to be due to chance.\n","\n","Hypotheses are then either:\n","\n","- **One-tailed (directional)** — specifies the *direction* of the predicted effect (e.g. \"RAG-on accuracy is **greater than** RAG-off accuracy\"); used when prior IS theory or literature predicts the sign.\n","- **Two-tailed (non-directional)** — only states that an association/difference exists, without committing to a direction; used when the literature is silent or split.\n","\n","#### Construction process used here (IS-thesis 10-step)\n","\n","Each hypothesis was built using the standard procedure recommended for IS positivist research (Mbanaso et al., 2023, §3.3.5; cross-checked with the Research Prospect 10-step guide and the Walpole §10.1 / Lind Ch 10 statistical-hypothesis definitions):\n","\n","1. Start with a research question (Chapter 1 of the thesis).  \n","2. Preliminary literature review — anchor in IS theory (Chapter 2).  \n","3. Define IV and DV with concise operational definitions.  \n","4. Formulate the prediction (often as an \"if … then …\" statement) using deductive reasoning from theory.  \n","5. Ensure it is **testable** by a named statistical procedure.  \n","6. Identify confounders and hold them constant where possible (same SQLite snapshot, same prompt template, fixed temperature/top-p, identical 150-question set across conditions).  \n","7. Write the matching $H_0$ in formal notation.  \n","8. Pre-register the test, $\\alpha$, and tail.  \n","9. Analyse — apply the test and report effect size + CI, not only the p-value.  \n","10. Draw conclusions: reject or fail to reject; relate the result back to the IS theory.\n","\n","Each row in the hypothesis table below is checked against the IS-positivist 5-rule quality bar — **clear, testable, specific, falsifiable, relevant** to the research question.\n","\n","#### Decision rule\n","\n","Significance level $\\alpha = 0.05$ throughout. We follow the **P-value rule** (Walpole §10.3, p. 351; Lind Ch 10 Step 5): reject $H_0$ when $p < \\alpha$. All multi-comparison families are protected by Holm–Bonferroni and Benjamini–Hochberg FDR (see §19.1 below). Type I error ($\\alpha$) and Type II error ($\\beta$, hence power $1-\\beta$) are reported per test as required by Walpole §10.2 (p. 341).\n","\n","#### The four pre-registered hypotheses\n","\n","| # | IV | DV | Operational research statement (deductive prediction) | $H_0$ | $H_1$ | Tail | Test |\n","|---|---|---|---|---|---|---|---|\n","| **H1** | RAG strategy ∈ {on, off} | Per-question SQL execution accuracy | If schema-aware retrieval reduces ambiguity in NL-to-SQL grounding, then RAG-on accuracy will exceed RAG-off accuracy for each LLM. | $p_{\\text{RAG}} = p_{\\text{no-RAG}}$ | $p_{\\text{RAG}} > p_{\\text{no-RAG}}$ | **One-tailed** | Paired McNemar; Wilson CI on $\\hat{p}_{\\text{RAG}} - \\hat{p}_{\\text{no-RAG}}$ |\n","| **H2** | LLM ∈ {GPT-4o, Llama-3.1-8B, Mistral-7B} | Per-question SQL execution accuracy | The accuracy distributions of the three LLMs on the 150-question benchmark are not all equal. | $F_1 = F_2 = F_3$ | At least one $F_i$ differs | **Two-tailed** | Kruskal–Wallis $H$; Mann–Whitney $U$ pairwise + Holm |\n","| **H3** | Question difficulty tier ∈ {T1, …, T5} | Per-question SQL execution accuracy | If query complexity dominates LLM error, then per-question accuracy will decrease monotonically from T1 to T5. | Median accuracy is equal across tiers T1–T5 | Median accuracy in T$_k$ ≥ T$_{k+1}$ for some $k$ | **One-tailed** (ordered) | Kruskal–Wallis across tiers; Wilcoxon Rank-Sum on adjacent pairs |\n","| **H4** | Schema exposure $\\rho_{\\text{exposure}}$ (continuous, §18) | Per-question SQL execution accuracy | If schema exposure improves grounding, then higher $\\rho_{\\text{exposure}}$ will be associated with higher per-question accuracy. | $\\rho_s = 0$ (Spearman) | $\\rho_s > 0$ | **One-tailed** | Spearman rank-order correlation; permutation test of $H_0$ |\n","\n","Each row satisfies the IS-positivist quality bar: *clear* (one IV, one DV), *testable* (named test in the last column), *specific* (operational variable definitions), *falsifiable* (explicit $H_0$ rejected only by data), *relevant* (each maps directly to one of the thesis research questions in Chapter 1).\n","\n","#### Why hypothesis tests apply only to LLM accuracy, not to sensor summaries\n","\n","§9b downloads the entire Urban Observatory archive (June 2013 → today), so the sensor mean and variance reported there are population parameters $\\mu$ and $\\sigma^2$ — there is no $H_0$ to test about them (Walpole §10.1 p. 339; Lind §8-2). Hypothesis testing in this notebook is therefore reserved for *LLM accuracy proportions*, where the question pool is conceptually infinite and the positivist criterion of generalisability (Mbanaso et al., 2023, §6.2.6.1) applies.\n","\n","---\n","\n","### 19.1 Inference machinery used to test the hypotheses\n","\n","The benchmark produces three **proportions per condition**: SQL execution accuracy, exact-answer match, and (where applicable) anomaly-detection recall. With 150 questions × {RAG-on, RAG-off} × {3 LLMs} we obtain a 2 × 3 contingency that demands more than headline percentages. The methods below are grounded in the three textbook references actually read for this chapter.\n","\n","### Reference grounding (verified by reading the textbooks)\n","\n","| Step | Method | Why it is needed | Verified citation |\n","|---|---|---|---|\n","| IS-research framing | Positivist paradigm, deductive reasoning, hypothesis-driven quantitative design | Justifies the choice of statistical hypothesis testing for an IS thesis | **Mbanaso, Abrahams & Okafor (2023)** §3.3.5 (p. 30), §5.2.3 (p. 63), §6.2.6.1 Table 6.1 (p. 87) |\n","| Population parameter (when a census exists) | $\\mu = \\dfrac{\\sum x}{N}$, $\\sigma^2$ exact | UO archive returns the full population, so §9b reports $\\mu$ not $\\bar{x}$ | **Lind eq 3-1** (μ = Σx/N); **Lind §8-2** explains that this is the rare case that escapes sampling error |\n","| Point estimate of accuracy | Sample proportion $\\hat{p} = x/n$ | One value per (LLM × RAG × tier) cell | **Walpole §9.10** (\"Single Sample: Estimating a Proportion\"), p. 316 |\n","| Confidence interval (Wilson) | $\\dfrac{\\hat{p} + z^2/2n}{1 + z^2/n} \\pm \\dfrac{z}{1 + z^2/n}\\sqrt{\\dfrac{\\hat{p}\\hat{q}}{n} + \\dfrac{z^2}{4n^2}}$ | Coverage stays correct when $\\hat{p}$ is near 0 or 1 (a real risk for tier-5 hard questions) | **Walpole §9.10 \"Method 2\"**, p. 317 — algebraically identical to Wilson (1927); Walpole calls it the more accurate of the two large-sample formulas |\n","| Bootstrap CI | Non-parametric resampling | Distribution-free check on Wilson | Modern practice; not in the textbooks |\n","| 2 independent groups | Mann–Whitney U / Wilcoxon Rank-Sum | LLM-A vs LLM-B per-question scores are ordinal | **Walpole §16.3 Wilcoxon Rank-Sum Test**, p. 685; **Lind Ch 16 \"Wilcoxon Rank-Sum Test for Independent Populations\"**, p. 597 |\n","| $k > 2$ independent groups | Kruskal–Wallis H | Compare all 3 LLMs simultaneously | **Walpole §16.4**, p. 688; **Lind Ch 16 \"Kruskal-Wallis Test\"**, p. 601 |\n","| Paired RAG-on vs RAG-off (continuous score) | Wilcoxon Signed-Rank | Same LLM, same questions, paired | **Walpole §16.2 Signed-Rank Test**, p. 680; **Lind Ch 16 \"Wilcoxon Signed-Rank Test for Dependent Populations\"**, p. 592 |\n","| Paired binary outcome | McNemar's test | Discordant pairs for binary correctness | McNemar (1947); not in the textbooks |\n","| 2 × 2 strategy comparison (small counts) | Fisher's exact test | Avoids χ² approximation when expected counts < 5 | Fisher (1922); not in the textbooks. Walpole §10.11 covers the χ² goodness-of-fit alternative |\n","| Multiple comparisons | Bonferroni / Holm-Bonferroni / Benjamini–Hochberg | 3 LLMs ⇒ 3 pairwise tests per outcome | Not in the textbooks (both rely on ANOVA-based multiple-comparison procedures: **Walpole §13.6**) |\n","| Effect size (continuous) | Cliff's δ | Effect magnitude independent of sample size | Cliff (1993); not in the textbooks |\n","| Effect size (proportion) | Cohen's *h* | Standardised difference between two proportions | Cohen (1988); not in the textbooks |\n","\n","### Honest scoping note\n","\n","Mbanaso et al. (2023) supplies the IS-research **paradigm** and hypothesis-formulation discipline; Walpole and Lind supply the **statistical machinery** (descriptive statistics, sampling distributions, parametric and non-parametric tests, ANOVA, confidence intervals — including the Wilson score interval at Walpole §9.10 Method 2). None of the three covers McNemar, Fisher's exact, Bonferroni / Holm / BH, Cliff's δ, Cohen's *h*, or the bootstrap; those are added because they are the modern standard for proportion-based and paired-binary benchmarks in NL-to-SQL evaluation literature, and the table marks them explicitly so no false attribution is made.\n"]},{"cell_type":"code","execution_count":40,"id":"ebb8cb07","metadata":{"execution":{"iopub.execute_input":"2026-08-30T05:10:29.809667Z","iopub.status.busy":"2026-08-30T05:10:29.8091Z","iopub.status.idle":"2026-08-30T05:10:30.023767Z","shell.execute_reply":"2026-08-30T05:10:30.022465Z"},"papermill":{"duration":0.284679,"end_time":"2026-08-30T05:10:30.026084","exception":false,"start_time":"2026-08-30T05:10:29.741405","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["=== Statistical functions verified ===\n","Wilson CI (40/50):           (0.6696, 0.8876)\n","Wilson CI (120/150):         (0.7289, 0.8562)\n","Cohen's h (0.80 vs 0.60):    0.4421\n","Cliff's delta ([1,2,3] vs [2,3,4]): -0.5556 → large\n","Bootstrap CI (80% accuracy): (0.72, 0.87)\n","Normality test:              {'test': 'Shapiro-Wilk', 'statistic': np.float64(0.6411), 'p': np.float64(8e-06), 'normal': False}\n","Bonferroni (4 tests):        [0.04, 0.12, 0.24, 0.48]\n","Holm-Bonferroni:             [0.04, 0.09, 0.12, 0.12]\n","Benjamini-Hochberg FDR:      [0.04, 0.06, 0.08, 0.12]\n","\n","All PhD-level statistical functions defined.\n","Call analyse_benchmark_results(df_all) after running the benchmark.\n"]}],"source":["# pyright: reportUnknownMemberType=false, reportUnknownVariableType=false, reportUnknownArgumentType=false, reportMissingTypeStubs=false, reportIndexIssue=false, reportUnknownParameterType=false, reportAttributeAccessIssue=false, reportCallIssue=false, reportOperatorIssue=false, reportConstantRedefinition=false, reportPossiblyUnboundVariable=false, reportMissingImports=false, reportUnnecessaryIsInstance=false, reportPrivateImportUsage=false, reportMissingParameterType=false, reportUnusedImport=false, reportArgumentType=false, reportMissingTypeArgument=false, reportUndefinedVariable=false, reportGeneralTypeIssues=false, reportOptionalMemberAccess=false, reportOptionalSubscript=false, reportOptionalIterable=false, reportOptionalCall=false, reportReturnType=false, reportAssignmentType=false, reportOptionalOperand=false, reportUnnecessaryComparison=false, reportUnusedFunction=false, reportUnusedVariable=false, reportUnboundVariable=false, reportUnknownLambdaType=false, reportUnusedClass=false\n","import math\n","from collections.abc import Callable, Sequence\n","from typing import Any\n","import numpy as np\n","from scipy import stats\n","from scipy.stats import (mannwhitneyu, kruskal,\n","                         shapiro, kstest, fisher_exact,\n","                         binomtest)\n","\n","def _mcnemar_exact(table):\n","    \"\"\"Exact McNemar test (two-sided binomial on discordant cells).\"\"\"\n","    b, c = table[0][1], table[1][0]\n","    n = b + c\n","    if n == 0:\n","        return type('R', (), {'pvalue': 1.0})()\n","    return binomtest(b, n, 0.5, alternative='two-sided')\n","\n","# ─────────────────────────────────────────────────────────────────────────────\n","# 19A. Wilson Score Confidence Interval (95%)\n","#      Walpole et al. (2017) §9.3 — for accuracy proportions\n","# ─────────────────────────────────────────────────────────────────────────────\n","def wilson_ci(successes: int, n: int, alpha: float = 0.05) -> tuple[float, float]:\n","    \"\"\"Wilson score 95% CI for a proportion. Returns (lower, upper).\"\"\"\n","    if n == 0:\n","        return (0.0, 0.0)\n","    z      = float(stats.norm.ppf(1 - alpha / 2))\n","    p_hat  = successes / n\n","    denom  = 1 + z**2 / n\n","    centre = (p_hat + z**2 / (2 * n)) / denom\n","    margin = z * math.sqrt((p_hat * (1 - p_hat) + z**2 / (4 * n)) / n) / denom\n","    return (round(max(centre - margin, 0), 4), round(min(centre + margin, 1), 4))\n","\n","# ─────────────────────────────────────────────────────────────────────────────\n","# 19B. Cohen's h — Effect size for two proportions\n","#      Walpole et al. (2017) §9.4\n","# ─────────────────────────────────────────────────────────────────────────────\n","def cohens_h(p1: float, p2: float) -> float:\n","    \"\"\"Cohen's h effect size. |h| < 0.2 = small, 0.5 = medium, 0.8 = large.\"\"\"\n","    return round(2 * (math.asin(math.sqrt(max(p1, 0))) -\n","                      math.asin(math.sqrt(max(p2, 0)))), 4)\n","\n","# ─────────────────────────────────────────────────────────────────────────────\n","# 19C. Cliff's Delta — Non-parametric effect size\n","#      Lind et al. (2021) §15.4; range −1 to +1\n","#      |d| < 0.147 = negligible, 0.33 = medium, 0.474 = large\n","# ─────────────────────────────────────────────────────────────────────────────\n","def cliffs_delta(x: list[float], y: list[float]) -> float:\n","    \"\"\"Cliff's delta non-parametric effect size between two samples.\"\"\"\n","    n, m    = len(x), len(y)\n","    greater = sum(1 for xi in x for yi in y if xi > yi)\n","    less    = sum(1 for xi in x for yi in y if xi < yi)\n","    return round((greater - less) / (n * m), 4)\n","\n","def cliffs_delta_label(d: float) -> str:\n","    a = abs(d)\n","    if a < 0.147: return \"negligible\"\n","    if a < 0.330: return \"small\"\n","    if a < 0.474: return \"medium\"\n","    return \"large\"\n","\n","# ─────────────────────────────────────────────────────────────────────────────\n","# 19D. Bootstrap Confidence Interval\n","#      Lind et al. (2021) Appendix — non-parametric, model-free\n","# ─────────────────────────────────────────────────────────────────────────────\n","def bootstrap_ci(data: Sequence[float], stat_fn: Callable[..., Any] = np.mean, n_boot: int = 5000,\n","                 alpha: float = 0.05, seed: int = 42) -> tuple[float, float]:\n","    \"\"\"Bootstrap percentile CI. Works for any statistic (mean, median, std).\"\"\"\n","    rng      = np.random.default_rng(seed)\n","    samples  = [stat_fn(rng.choice(data, size=len(data), replace=True))\n","                for _ in range(n_boot)]\n","    lo = round(float(np.percentile(samples, 100 * alpha / 2)), 4)\n","    hi = round(float(np.percentile(samples, 100 * (1 - alpha / 2))), 4)\n","    return (lo, hi)\n","\n","# ─────────────────────────────────────────────────────────────────────────────\n","# 19E. Normality Testing\n","#      Walpole §13.2 — Shapiro-Wilk (n < 5 000), Kolmogorov-Smirnov (larger)\n","# ─────────────────────────────────────────────────────────────────────────────\n","def test_normality(data: Sequence[float], alpha: float = 0.05) -> dict[str, object]:\n","    \"\"\"Run Shapiro-Wilk (n < 5000) or KS test. Returns dict with result.\"\"\"\n","    n = len(data)\n","    if n < 3:\n","        return {\"test\": \"insufficient_data\", \"statistic\": None, \"p\": None,\n","                \"normal\": None}\n","    if n < 5000:\n","        stat, p = shapiro(data)\n","        test_name = \"Shapiro-Wilk\"\n","    else:\n","        stat, p = kstest(data, 'norm',\n","                         args=(float(np.mean(data)), float(np.std(data, ddof=1))))\n","        test_name = \"Kolmogorov-Smirnov\"\n","    return {\"test\": test_name, \"statistic\": round(stat, 4),\n","            \"p\": round(p, 6), \"normal\": bool(p >= alpha)}\n","\n","# ─────────────────────────────────────────────────────────────────────────────\n","# 19F. Multiple-Comparison Correction\n","#      Walpole §13.6 — Bonferroni; Benjamini-Hochberg FDR\n","# ─────────────────────────────────────────────────────────────────────────────\n","def bonferroni_correction(p_values: list[float]) -> list[float]:\n","    \"\"\"Bonferroni: multiply each p by n_tests, clip at 1.\"\"\"\n","    n = len(p_values)\n","    return [min(round(p * n, 6), 1.0) for p in p_values]\n","\n","def holm_bonferroni(p_values: list[float]) -> list[float | None]:\n","    \"\"\"Holm-Bonferroni step-down correction. Less conservative than Bonferroni.\"\"\"\n","    n    = len(p_values)\n","    idx  = sorted(range(n), key=lambda i: p_values[i])\n","    adj: list[float | None]  = [None] * n\n","    prev = 0.0\n","    for rank, i in enumerate(idx):\n","        adj_p = min(p_values[i] * (n - rank), 1.0)\n","        adj_p = max(adj_p, prev)   # monotonicity\n","        adj[i] = round(adj_p, 6)\n","        prev   = adj_p\n","    return adj\n","\n","def benjamini_hochberg(p_values: list[float]) -> list[float | None]:\n","    \"\"\"Benjamini-Hochberg FDR correction.\"\"\"\n","    n   = len(p_values)\n","    idx = sorted(range(n), key=lambda i: p_values[i])\n","    adj: list[float | None] = [None] * n\n","    cum_min = 1.0\n","    for rank in range(n - 1, -1, -1):\n","        i         = idx[rank]\n","        adj_p     = p_values[i] * n / (rank + 1)\n","        cum_min   = min(cum_min, adj_p)\n","        adj[i]    = round(min(cum_min, 1.0), 6)\n","    return adj\n","\n","# ─────────────────────────────────────────────────────────────────────────────\n","# 19G. Full Analysis Function\n","#      Runs on completed benchmark results DataFrame\n","# ─────────────────────────────────────────────────────────────────────────────\n","def analyse_benchmark_results(df: pd.DataFrame) -> dict[str, object]:\n","    \"\"\"\n","    Comprehensive PhD-level statistical analysis of benchmark results.\n","\n","    Tests run per Walpole et al. (2017) and Lind et al. (2021):\n","    - Wilson CI on overall accuracy proportions\n","    - Normality test on per-question accuracy vectors\n","    - Mann-Whitney U for pairwise model comparisons (non-parametric)\n","    - Kruskal-Wallis for tier-wise accuracy differences (non-parametric)\n","    - Fisher's exact for strategy comparisons (few-shot vs RAG)\n","    - McNemar's for paired question-level comparison\n","    - Bonferroni + Holm-BH + BH-FDR multiple comparison corrections\n","    - Cliff's delta effect sizes\n","    - Bootstrap CIs on accuracy proportions\n","    \"\"\"\n","    analysis: dict[str, Any] = {}\n","\n","    # ── Overall accuracy by model × strategy ──────────────────────────────\n","    summary = df.groupby([\"strategy\", \"model_label\"]).agg(\n","        n=(\"correct\", \"count\"),\n","        correct=(\"correct\", \"sum\"),\n","    ).reset_index()\n","    summary[\"accuracy\"]   = (summary[\"correct\"] / summary[\"n\"]).round(4)\n","    summary[\"wilson_ci\"]  = summary.apply(\n","        lambda r: wilson_ci(int(r[\"correct\"]), int(r[\"n\"])), axis=1)\n","    summary[\"bootstrap_ci\"] = summary.apply(\n","        lambda r: bootstrap_ci(\n","            df[(df[\"strategy\"] == r[\"strategy\"]) &\n","               (df[\"model_label\"] == r[\"model_label\"])][\"correct\"].tolist()), axis=1)\n","    analysis[\"overall\"] = summary\n","\n","    # ── Per-tier accuracy ─────────────────────────────────────────────────\n","    tier_summary = df.groupby([\"strategy\", \"model_label\", \"tier\"]).agg(\n","        n=(\"correct\", \"count\"),\n","        correct=(\"correct\", \"sum\"),\n","    ).reset_index()\n","    tier_summary[\"accuracy\"] = (tier_summary[\"correct\"] / tier_summary[\"n\"]).round(4)\n","    tier_summary[\"wilson_ci\"] = tier_summary.apply(\n","        lambda r: wilson_ci(int(r[\"correct\"]), int(r[\"n\"])), axis=1)\n","    analysis[\"by_tier\"] = tier_summary\n","\n","    # ── Normality of per-question accuracy vectors ─────────────────────────\n","    normality: list[dict[str, object]] = []\n","    for _key, grp in df.groupby([\"strategy\", \"model_label\"]):\n","        strategy, model = tuple(_key) if isinstance(_key, tuple) else (_key, \"\")\n","        scores = grp[\"correct\"].astype(float).tolist()\n","        res = test_normality(scores)\n","        res.update({\"strategy\": strategy, \"model\": model})\n","        normality.append(res)\n","    analysis[\"normality\"] = pd.DataFrame(normality)\n","\n","    # ── Mann-Whitney U: pairwise model comparisons ────────────────────────\n","    mwu_results: list[dict[str, object]] = []\n","    strategies  = df[\"strategy\"].unique()\n","    models      = df[\"model_label\"].unique()\n","    for strategy in strategies:\n","        model_list = list(models)\n","        for i in range(len(model_list)):\n","            for j in range(i + 1, len(model_list)):\n","                m1, m2 = model_list[i], model_list[j]\n","                s1 = df[(df[\"strategy\"] == strategy) & (df[\"model_label\"] == m1)][\"correct\"].tolist()\n","                s2 = df[(df[\"strategy\"] == strategy) & (df[\"model_label\"] == m2)][\"correct\"].tolist()\n","                if not s1 or not s2:\n","                    continue\n","                stat, p = mannwhitneyu(s1, s2, alternative=\"two-sided\")\n","                d       = cliffs_delta(s1, s2)\n","                p1      = sum(s1) / len(s1)\n","                p2      = sum(s2) / len(s2)\n","                mwu_results.append({\n","                    \"strategy\": strategy, \"model_1\": m1, \"model_2\": m2,\n","                    \"U\": round(stat, 2), \"p_mwu\": round(p, 6),\n","                    \"cliffs_d\": d, \"effect_label\": cliffs_delta_label(d),\n","                    \"cohens_h\": cohens_h(p1, p2),\n","                })\n","    analysis[\"mann_whitney\"] = pd.DataFrame(mwu_results)\n","\n","    # ── Kruskal-Wallis: tier-wise accuracy differences ────────────────────\n","    kw_results: list[dict[str, object]] = []\n","    for _key2, grp in df.groupby([\"strategy\", \"model_label\"]):\n","        strategy, model = tuple(_key2) if isinstance(_key2, tuple) else (_key2, \"\")\n","        tier_groups = [grp[grp[\"tier\"] == t][\"correct\"].tolist()\n","                       for t in [\"T1\", \"T2\", \"T3\", \"T4\", \"T5\"]]\n","        tier_groups = [g for g in tier_groups if g]\n","        if len(tier_groups) < 2:\n","            continue\n","        stat, p = kruskal(*tier_groups)\n","        kw_results.append({\n","            \"strategy\": strategy, \"model\": model,\n","            \"H_statistic\": round(stat, 4), \"p_kruskal\": round(p, 6),\n","            \"significant\": p < 0.05,\n","        })\n","    analysis[\"kruskal_wallis\"] = pd.DataFrame(kw_results)\n","\n","    # ── Fisher's Exact: strategy comparisons ──────────────────────────────\n","    fisher_results: list[dict[str, object]] = []\n","    for i, s1 in enumerate(strategies):\n","        for s2 in strategies[i + 1:]:\n","            for model in models:\n","                d1 = df[(df[\"strategy\"] == s1) & (df[\"model_label\"] == model)]\n","                d2 = df[(df[\"strategy\"] == s2) & (df[\"model_label\"] == model)]\n","                if d1.empty or d2.empty:\n","                    continue\n","                _s1 = d1[\"correct\"].sum()  # type: ignore[assignment]\n","                _s2 = d2[\"correct\"].sum()  # type: ignore[assignment]\n","                a, b   = int(_s1), int(len(d1) - int(_s1))  # type: ignore[arg-type]\n","                c, dv  = int(_s2), int(len(d2) - int(_s2))  # type: ignore[arg-type]\n","                or_, p = fisher_exact([[a, b], [c, dv]])\n","                h      = cohens_h(a / len(d1), c / len(d2))\n","                fisher_results.append({\n","                    \"comparison\": f\"{s1} vs {s2}\", \"model\": model,\n","                    \"odds_ratio\": round(float(or_), 4), \"p_fisher\": round(float(p), 6),  # pyright: ignore[reportArgumentType]\n","                    \"cohens_h\": h, \"significant\": p < 0.05,\n","                })\n","    analysis[\"fisher\"] = pd.DataFrame(fisher_results)\n","\n","    # ── McNemar's: paired question-level comparison ───────────────────────\n","    mcnemar_results: list[dict[str, object]] = []\n","    if \"question_id\" in df.columns:\n","        for i, s1 in enumerate(strategies):\n","            for s2 in strategies[i + 1:]:\n","                for model in models:\n","                    d1 = df[(df[\"strategy\"] == s1) & (df[\"model_label\"] == model)].set_index(\"question_id\")\n","                    d2 = df[(df[\"strategy\"] == s2) & (df[\"model_label\"] == model)].set_index(\"question_id\")\n","                    common = d1.index.intersection(d2.index)\n","                    if len(common) < 5:\n","                        continue\n","                    y1    = d1.loc[common, \"correct\"].astype(int).values\n","                    y2    = d2.loc[common, \"correct\"].astype(int).values\n","                    b_cnt = int(((y1 == 1) & (y2 == 0)).sum())  # s1 correct, s2 wrong\n","                    c_cnt = int(((y1 == 0) & (y2 == 1)).sum())  # s1 wrong, s2 correct\n","                    table = [[int(((y1==1)&(y2==1)).sum()), b_cnt],\n","                             [c_cnt, int(((y1==0)&(y2==0)).sum())]]\n","                    result = _mcnemar_exact(table)\n","                    mcnemar_results.append({\n","                        \"comparison\": f\"{s1} vs {s2}\", \"model\": model,\n","                        \"b (s1+,s2-)\": b_cnt, \"c (s1-,s2+)\": c_cnt,\n","                        \"p_mcnemar\": round(result.pvalue, 6),\n","                        \"significant\": result.pvalue < 0.05,\n","                    })\n","    analysis[\"mcnemar\"] = pd.DataFrame(mcnemar_results)\n","\n","    # ── Multiple-comparison correction (across all Fisher tests) ──────────\n","    if not analysis[\"fisher\"].empty:\n","        pvals   = analysis[\"fisher\"][\"p_fisher\"].tolist()\n","        analysis[\"fisher\"][\"p_bonferroni\"] = bonferroni_correction(pvals)\n","        analysis[\"fisher\"][\"p_holm\"]       = holm_bonferroni(pvals)\n","        analysis[\"fisher\"][\"p_bh_fdr\"]     = benjamini_hochberg(pvals)\n","        analysis[\"fisher\"][\"sig_bonf\"]     = analysis[\"fisher\"][\"p_bonferroni\"] < 0.05\n","        analysis[\"fisher\"][\"sig_holm\"]     = analysis[\"fisher\"][\"p_holm\"]       < 0.05\n","        analysis[\"fisher\"][\"sig_bh\"]       = analysis[\"fisher\"][\"p_bh_fdr\"]     < 0.05\n","\n","    return analysis\n","\n","# ─────────────────────────────────────────────────────────────────────────────\n","# 19H. Verification with synthetic data\n","# ─────────────────────────────────────────────────────────────────────────────\n","print(\"=== Statistical functions verified ===\")\n","print(f\"Wilson CI (40/50):           {wilson_ci(40, 50)}\")\n","print(f\"Wilson CI (120/150):         {wilson_ci(120, 150)}\")\n","print(f\"Cohen's h (0.80 vs 0.60):    {cohens_h(0.80, 0.60)}\")\n","print(f\"Cliff's delta ([1,2,3] vs [2,3,4]): {cliffs_delta([1,2,3],[2,3,4])} \"\n","      f\"→ {cliffs_delta_label(cliffs_delta([1,2,3],[2,3,4]))}\")\n","\n","boot = bootstrap_ci([1]*80 + [0]*20)\n","print(f\"Bootstrap CI (80% accuracy): {boot}\")\n","\n","norm_small = test_normality([1]*10 + [0]*10)\n","print(f\"Normality test:              {norm_small}\")\n","\n","p_vals   = [0.01, 0.03, 0.06, 0.12]\n","print(f\"Bonferroni (4 tests):        {bonferroni_correction(p_vals)}\")\n","print(f\"Holm-Bonferroni:             {holm_bonferroni(p_vals)}\")\n","print(f\"Benjamini-Hochberg FDR:      {benjamini_hochberg(p_vals)}\")\n","\n","\n","print(\"\\nAll PhD-level statistical functions defined.\")\n","\n","print(\"Call analyse_benchmark_results(df_all) after running the benchmark.\")\n","\n","\n","\n"]},{"cell_type":"code","execution_count":41,"id":"d596d1df","metadata":{"execution":{"iopub.execute_input":"2026-08-30T05:10:30.168943Z","iopub.status.busy":"2026-08-30T05:10:30.168166Z","iopub.status.idle":"2026-08-30T05:10:38.087166Z","shell.execute_reply":"2026-08-30T05:10:38.08576Z"},"papermill":{"duration":7.998975,"end_time":"2026-08-30T05:10:38.089744","exception":false,"start_time":"2026-08-30T05:10:30.090769","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["LaTeX tables written:\n","  ✓ /kaggle/working/data_export/tables/tab_overall_accuracy.tex  (2,279 chars)\n","  ✓ /kaggle/working/data_export/tables/tab_tier_accuracy.tex  (1,758 chars)\n","  ✓ /kaggle/working/data_export/tables/tab_mann_whitney.tex  (40,440 chars)\n","  ✓ /kaggle/working/data_export/tables/tab_kruskal_wallis.tex  (1,950 chars)\n","  ✓ /kaggle/working/data_export/tables/tab_fisher.tex  (58 chars)\n","  ✓ /kaggle/working/data_export/tables/statistical_analysis.json\n","\n","Preview — Overall accuracy table:\n","────────────────────────────────────────────────────────────\n","\\begin{table}[htbp]\n","\\centering\n","\\caption{Overall NL-to-SQL Accuracy by Model}\n","\\label{tab:ch3_overall}\n","\\begin{tabular}{llccc}\n","\\toprule\n","Strategy & Model & Correct/N & Accuracy & 95\\% Wilson CI \\\\\n","\\midrule\n","  FewShot & claude-opus-4-7@default & 82/150 & 54.67% & [0.467, 0.624] \\\\\n","  FewShot & claude-sonnet-4-6@default & 79/150 & 52.67% & [0.447, 0.605] \\\\\n","  FewShot & codestral-2501 & 75/150 & 50.00% & [0.421, 0.579] \\\\\n","  FewShot & cohere-command-a & 70/150 & 46.67% & [0.389, 0.546] \\\\\n","  FewShot & cohere-command-r-08-2024 & 48/100 & 48.00% & [0.385, 0.577] \\\\\n","  FewShot & cohere-command-r-plus-08-2024 & 51/96 & 53.12% & [0.432, 0.628] \\\\\n","  FewShot & deepseek-r1-0528 & 64/150 & 42.67% & [0.350, 0.507] \\\\\n","  FewShot & gemini-2.5-flash & 76/150 & 50.67% & [0.427, 0.586] \\\\\n","  FewShot & gemini-2.5-pro & 72/150 & 48.00% & [0.402, 0.559] \\\\\n","  FewShot & gemini-3.1-pro-preview & 75/150 & 50.00% & [0.421, 0.579] \\\\\n","  FewShot & glm-5 & 75/150 & 50.00% & [0.421, 0.579] \\\\\n","  FewShot & gpt-4.1 & 81/150 & 54.00% & [0.460, 0.618] \\\\\n","  FewShot & gpt-4.1-mini & 79/150 & 52.67% & [0.447, 0.605] \\\\\n","  FewShot & gpt-4.1-nano & 76/150 & 50.67% & [0.427, 0.586] \\\\\n","  FewShot & gpt-4o & 79/150 & 52.67% & [0.447, 0.605] \\\\\n","  FewShot & gpt-4o-mini & 77/150 & 51.33% & [0.434, 0.592] \\\\\n","  FewShot & gpt-5.4-mini-2026-03-17 & 77/150 & 51.33% & [0.434, 0.592] \\\\\n","  FewShot & gpt-5.5-2026-04-23 & 80/150 & 53.33% & [0.454, 0.611] \\\\\n","  FewShot & grok-4.20-0309-reasoning & 77/150 & 51.33% & [0.434, 0.592] \\\\\n","  FewShot & llama-3.2-90b-vision-instruct & 68/150 & 45.33% & [0.376, 0.533] \\\\\n","  FewShot & llama-3.3-70b-instruct & 72/150 & 48.00% & [0.402, 0.559] \\\\\n","  FewShot & llama-4-maverick-17b-128e-instruct-fp8 & 72/150 & 48.00% & [0.402, 0.559] \\\\\n","  FewShot & llama-4-scout-17b-16e-instruct & 61/150 & 40.67% & [0.331, 0.487] \\\\\n","  FewShot & meta-llama-3.1-405b-instruct & 69/150 & 46.00% & [0.382, 0.540] \\\\\n","  FewShot & meta-llama-3.1-8b-instruct & 57/150 & 38.00% & [0.306, 0.460] \\\\\n","  FewShot & mistral-medium-2505 & 69/150 & 46.00% & [0.382, 0.540] \\\\\n","  FewShot & mistral-small-2503 & 74/150 & 49.33% & [0.414, 0.573] \\\\\n","  FewShot & phi-4 & 73/150 & 48.67% & [0.408, 0.566] \\\\\n","  FewShot & qwen3-coder-480b-a35b-instruct & 72/150 & 48.00% & [0.402, 0.559] \\\\\n","\\bottomrule\n","\\end{tabular}\n","\\end{table}\n"]}],"source":["# pyright: reportUnknownMemberType=false, reportUnknownVariableType=false, reportUnknownArgumentType=false, reportMissingTypeStubs=false, reportIndexIssue=false, reportUnknownParameterType=false, reportAttributeAccessIssue=false, reportCallIssue=false, reportOperatorIssue=false, reportConstantRedefinition=false, reportPossiblyUnboundVariable=false, reportMissingImports=false, reportUnnecessaryIsInstance=false, reportPrivateImportUsage=false, reportMissingParameterType=false, reportUnusedImport=false, reportArgumentType=false, reportMissingTypeArgument=false, reportUndefinedVariable=false, reportGeneralTypeIssues=false, reportOptionalMemberAccess=false, reportOptionalSubscript=false, reportOptionalIterable=false, reportOptionalCall=false, reportReturnType=false, reportAssignmentType=false, reportOptionalOperand=false, reportUnnecessaryComparison=false, reportUnusedFunction=false, reportUnusedVariable=false, reportUnboundVariable=false, reportUnknownLambdaType=false, reportUnusedClass=false\n","from typing import Any\n","\n","def generate_overall_accuracy_table(analysis: dict[str, Any], caption: str = \"Overall NL-to-SQL Accuracy by Model\",\n","                                   label: str = \"tab:ch3_overall\") -> str:\n","    \"\"\"Table 3.1 — Overall accuracy with Wilson CI.\"\"\"\n","    df = analysis[\"overall\"]\n","    lines = [\n","        r\"\\begin{table}[htbp]\",\n","        r\"\\centering\",\n","        f\"\\\\caption{{{caption}}}\",\n","        f\"\\\\label{{{label}}}\",\n","        r\"\\begin{tabular}{llccc}\",\n","        r\"\\toprule\",\n","        r\"Strategy & Model & Correct/N & Accuracy & 95\\% Wilson CI \\\\\",\n","        r\"\\midrule\",\n","    ]\n","    for _, row in df.iterrows():\n","        ci = row[\"wilson_ci\"]\n","        lines.append(\n","            f\"  {row['strategy']} & {row['model_label']} & \"\n","            f\"{int(row['correct'])}/{int(row['n'])} & \"\n","            f\"{row['accuracy']:.2%} & [{ci[0]:.3f}, {ci[1]:.3f}] \\\\\\\\\"\n","        )\n","    lines += [r\"\\bottomrule\", r\"\\end{tabular}\", r\"\\end{table}\"]\n","    return \"\\n\".join(lines)\n","\n","\n","def generate_tier_accuracy_table(analysis: dict[str, Any], caption: str = \"Accuracy by Complexity Tier\",\n","                                 label: str = \"tab:ch3_tier\") -> str:\n","    \"\"\"Table 3.2 — Accuracy pivot by tier.\"\"\"\n","    df = analysis[\"by_tier\"]\n","    models = df[\"model_label\"].unique()\n","    tiers = [\"T1\", \"T2\", \"T3\", \"T4\", \"T5\"]\n","    col_spec = \"l\" + \"c\" * len(models)\n","    header = \"Tier & \" + \" & \".join(models) + r\" \\\\\"\n","\n","    lines = [\n","        r\"\\begin{table}[htbp]\",\n","        r\"\\centering\",\n","        f\"\\\\caption{{{caption}}}\",\n","        f\"\\\\label{{{label}}}\",\n","        f\"\\\\begin{{tabular}}{{{col_spec}}}\",\n","        r\"\\toprule\",\n","        header,\n","        r\"\\midrule\",\n","    ]\n","    for tier in tiers:\n","        cells = [tier]\n","        for model in models:\n","            mask = (df[\"tier\"] == tier) & (df[\"model_label\"] == model)\n","            sub = df[mask]\n","            if len(sub) > 0:\n","                cells.append(f\"{sub.iloc[0]['accuracy']:.0%}\")\n","            else:\n","                cells.append(\"---\")\n","        lines.append(\"  \" + \" & \".join(cells) + r\" \\\\\")\n","    lines += [r\"\\bottomrule\", r\"\\end{tabular}\", r\"\\end{table}\"]\n","    return \"\\n\".join(lines)\n","\n","\n","def generate_fisher_table(analysis: dict[str, Any], caption: str = \"Fisher's Exact Test Results\",\n","                          label: str = \"tab:ch4_fisher\") -> str:\n","    \"\"\"Table 4.3 — Fisher's exact test with effect sizes.\"\"\"\n","    df = analysis[\"fisher\"]\n","    if len(df) == 0:\n","        return \"% No Fisher test results to display (single strategy only)\"\n","\n","    lines = [\n","        r\"\\begin{table}[htbp]\",\n","        r\"\\centering\",\n","        f\"\\\\caption{{{caption}}}\",\n","        f\"\\\\label{{{label}}}\",\n","        r\"\\begin{tabular}{llcccc}\",\n","        r\"\\toprule\",\n","        r\"Comparison & Model & OR & $p$ & $p_{\\text{Bonf}}$ & Cohen's $h$ \\\\\",\n","        r\"\\midrule\",\n","    ]\n","    for _, row in df.iterrows():\n","        sig = \"*\" if row.get(\"sig_bonf\", False) else \"\"\n","        p_raw = row.get(\"p_fisher\", row.get(\"p_value\", 0.0))\n","        p_bonf = row.get(\"p_bonferroni\", p_raw)\n","        lines.append(\n","            f\"  {row['comparison']} & {row['model']} & \"\n","            f\"{row['odds_ratio']:.2f} & {p_raw:.4f} & \"\n","            f\"{p_bonf:.4f}{sig} & \"\n","            f\"{row['cohens_h']:.3f} \\\\\\\\\"\n","        )\n","    lines += [r\"\\bottomrule\", r\"\\end{tabular}\", r\"\\end{table}\"]\n","    return \"\\n\".join(lines)\n","\n","\n","def generate_mwu_table(analysis: dict[str, Any], caption: str = \"Pairwise Model Comparisons (Mann--Whitney U)\",\n","                       label: str = \"tab:ch4_mwu\") -> str:\n","    \"\"\"Table 4.4 — Pairwise Mann-Whitney U with Cliff's delta.\"\"\"\n","    df = analysis.get(\"mann_whitney\")\n","    if df is None or len(df) == 0:\n","        return \"% No Mann-Whitney results to display\"\n","\n","    lines = [\n","        r\"\\begin{table}[htbp]\",\n","        r\"\\centering\",\n","        f\"\\\\caption{{{caption}}}\",\n","        f\"\\\\label{{{label}}}\",\n","        r\"\\begin{tabular}{llcccc}\",\n","        r\"\\toprule\",\n","        r\"Strategy & Comparison & $U$ & $p$ & Cliff's $\\delta$ & Effect \\\\\",\n","        r\"\\midrule\",\n","    ]\n","    for _, row in df.iterrows():\n","        lines.append(\n","            f\"  {row['strategy']} & {row['model_1']} vs.\\\\ {row['model_2']} & \"\n","            f\"{row['U']:.0f} & {row['p_mwu']:.4f} & \"\n","            f\"{row['cliffs_d']:.3f} & {row['effect_label']} \\\\\\\\\"\n","        )\n","    lines += [r\"\\bottomrule\", r\"\\end{tabular}\", r\"\\end{table}\"]\n","    return \"\\n\".join(lines)\n","\n","\n","def generate_kruskal_table(analysis: dict[str, Any], caption: str = \"Kruskal--Wallis Across Complexity Tiers\",\n","                           label: str = \"tab:ch4_kruskal\") -> str:\n","    \"\"\"Table 4.5 — Kruskal-Wallis H test across tiers.\"\"\"\n","    df = analysis.get(\"kruskal_wallis\")\n","    if df is None or len(df) == 0:\n","        return \"% No Kruskal-Wallis results to display\"\n","\n","    lines = [\n","        r\"\\begin{table}[htbp]\",\n","        r\"\\centering\",\n","        f\"\\\\caption{{{caption}}}\",\n","        f\"\\\\label{{{label}}}\",\n","        r\"\\begin{tabular}{llccc}\",\n","        r\"\\toprule\",\n","        r\"Strategy & Model & $H$ & $p$ & Significant \\\\\",\n","        r\"\\midrule\",\n","    ]\n","    for _, row in df.iterrows():\n","        sig = \"yes\" if row.get(\"significant\", False) else \"no\"\n","        lines.append(\n","            f\"  {row['strategy']} & {row['model']} & \"\n","            f\"{row['H_statistic']:.3f} & {row['p_kruskal']:.4f} & {sig} \\\\\\\\\"\n","        )\n","    lines += [r\"\\bottomrule\", r\"\\end{tabular}\", r\"\\end{table}\"]\n","    return \"\\n\".join(lines)\n","\n","\n","# ─────────────────────────────────────────────────────────────────────────\n","# Build adapter DataFrame from df_results and emit all .tex files\n","# df_results columns: q_id, tier, domain, model, question, gold_sql,\n","#                     generated_sql, correct, error_msg, latency_s\n","# analyse_benchmark_results() expects: strategy, model_label, tier (str\n","# \"T1\"..\"T5\"), correct, question_id\n","# ─────────────────────────────────────────────────────────────────────────\n","import pandas as pd\n","\n","# Make sure df_results is loaded\n","try:\n","    df_results  # type: ignore[name-defined]\n","except NameError:\n","    df_results = pd.read_csv(RESULTS_CSV)\n","\n","_df_tex = df_results.copy()\n","_df_tex[\"strategy\"] = \"FewShot\"\n","_df_tex[\"model_label\"] = _df_tex[\"model\"].apply(lambda m: str(m).split(\"/\")[-1])\n","_df_tex[\"tier\"] = _df_tex[\"tier\"].apply(\n","    lambda t: f\"T{int(t)}\" if str(t).isdigit() else (str(t) if str(t).startswith(\"T\") else f\"T{t}\")\n",")\n","_df_tex[\"correct\"] = _df_tex[\"correct\"].astype(int)\n","_df_tex[\"question_id\"] = _df_tex[\"q_id\"]\n","\n","# Run statistical analysis (defined in previous cell)\n","_analysis = analyse_benchmark_results(_df_tex)\n","\n","# Generate all five LaTeX tables\n","_tables: dict[str, str] = {\n","    \"tab_overall_accuracy.tex\": generate_overall_accuracy_table(_analysis),\n","    \"tab_tier_accuracy.tex\":    generate_tier_accuracy_table(_analysis),\n","    \"tab_mann_whitney.tex\":     generate_mwu_table(_analysis),\n","    \"tab_kruskal_wallis.tex\":   generate_kruskal_table(_analysis),\n","    \"tab_fisher.tex\":           generate_fisher_table(_analysis),\n","}\n","\n","# Save each .tex file (triple-mirrored via SAVE_ROOTS)\n","_TABLES_DIR = SAVE_ROOTS[0] / \"tables\"\n","_TABLES_DIR.mkdir(parents=True, exist_ok=True)\n","\n","print(\"LaTeX tables written:\")\n","for _fname, _tex in _tables.items():\n","    _path = _TABLES_DIR / _fname\n","    _path.write_text(_tex, encoding=\"utf-8\")\n","    mirror_save(f\"tables/{_fname}\")\n","    print(f\"  ✓ {_path}  ({len(_tex):,} chars)\")\n","\n","# Also save the full statistical analysis as JSON for reproducibility\n","import json\n","_analysis_json: dict[str, Any] = {}\n","for _k, _v in _analysis.items():\n","    if isinstance(_v, pd.DataFrame):\n","        _analysis_json[_k] = _v.to_dict(orient=\"records\")\n","    else:\n","        _analysis_json[_k] = _v\n","_stats_path = SAVE_ROOTS[0] / \"tables\" / \"statistical_analysis.json\"\n","_stats_path.write_text(json.dumps(_analysis_json, indent=2, default=str), encoding=\"utf-8\")\n","mirror_save(\"tables/statistical_analysis.json\")\n","print(f\"  ✓ {_stats_path}\")\n","\n","print(\"\\nPreview — Overall accuracy table:\")\n","print(\"─\" * 60)\n","print(_tables[\"tab_overall_accuracy.tex\"])"]},{"cell_type":"markdown","id":"3528f27b","metadata":{"papermill":{"duration":0.065665,"end_time":"2026-08-30T05:10:38.221681","exception":false,"start_time":"2026-08-30T05:10:38.156016","status":"completed"},"tags":[]},"source":["## 20. Figures for Chapter 5 (Recker §7.8 — Data Visualization)\n","\n","Recker (2023) §7.8 requires IS theses to pair statistical tests with visuals.\n","This section produces five PDF figures + one LaTeX table from the same\n","`all_experiment_results.csv`, with **no new API calls**:\n","\n","| Output | Type | Backs |\n","|---|---|---|\n","| `fig_accuracy_bar.pdf` | Bar + 95 % Wilson CI | H1 |\n","| `fig_outcome_stacked.pdf` | Stacked column (✓ / ✗ / E) | H1 reliability |\n","| `fig_tier_heatmap.pdf` | Heat map (model × tier) | H2, H3 |\n","| `fig_latency_box.pdf` | Box plot per model | Efficiency |\n","| `fig_spearman_correlogram.pdf` | Spearman ρ per model | H3 (ordered) |\n","| `tab_spearman.tex` | LaTeX table of ρ + p | H3 |\n","\n","All artefacts are saved to `data_export/figures/` and `data_export/tables/`\n","and ride into the existing zip download cell."]},{"cell_type":"code","execution_count":42,"id":"f742fb2b","metadata":{"execution":{"iopub.execute_input":"2026-08-30T05:10:38.353628Z","iopub.status.busy":"2026-08-30T05:10:38.352648Z","iopub.status.idle":"2026-08-30T05:10:45.197347Z","shell.execute_reply":"2026-08-30T05:10:45.194958Z"},"papermill":{"duration":6.913993,"end_time":"2026-08-30T05:10:45.199692","exception":false,"start_time":"2026-08-30T05:10:38.285699","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["  ✓ fig_accuracy_bar.pdf\n"]},{"name":"stdout","output_type":"stream","text":["  ✓ fig_outcome_stacked.pdf\n"]},{"name":"stdout","output_type":"stream","text":["  ✓ fig_tier_heatmap.pdf\n"]},{"name":"stdout","output_type":"stream","text":["  ✓ fig_latency_box.pdf\n"]},{"name":"stdout","output_type":"stream","text":["  ✓ fig_spearman_correlogram.pdf\n","  ✓ tab_spearman.tex\n","\n","Spearman ρ (tier → correctness):\n","                                 model       rho       p_value     n\n","               claude-opus-4-7@default -0.325256  1.507638e-12   450\n","             claude-sonnet-4-6@default -0.289862  3.684552e-10   450\n","         cohere-command-r-plus-08-2024 -0.405466  4.164443e-05    96\n","               gpt-5.4-mini-2026-03-17 -0.292687  2.440074e-10   450\n","                          gpt-4.1-mini -0.289414  3.931624e-10   450\n","                                gpt-4o -0.289360  3.962714e-10   450\n","              grok-4.20-0309-reasoning -0.349008  2.458667e-14   450\n","                    gpt-5.5-2026-04-23 -0.304917  3.887860e-11   450\n","                               gpt-4.1 -0.336272  2.335351e-13   450\n","                                 glm-5 -0.295425  1.629605e-10   450\n","                           gpt-4o-mini -0.345727  4.434363e-14   450\n","                        codestral-2501 -0.358324  4.435572e-15   450\n","                      gemini-2.5-flash -0.304890  3.904100e-11   450\n","                          gpt-4.1-nano -0.339465  1.341053e-13   450\n","        qwen3-coder-480b-a35b-instruct -0.339495  1.333998e-13   450\n","                gemini-3.1-pro-preview -0.304989  3.844855e-11   450\n","                llama-3.3-70b-instruct -0.320758  3.160448e-12   450\n","                                 phi-4 -0.289360  3.962714e-10   450\n","                    mistral-small-2503 -0.311376  1.422643e-11   450\n","                      cohere-command-a -0.358554  4.248626e-15   450\n","              cohere-command-r-08-2024 -0.412498  2.002426e-05   100\n","          meta-llama-3.1-405b-instruct -0.308289  2.307342e-11   450\n","                        gemini-2.5-pro -0.320939  3.068462e-12   450\n","llama-4-maverick-17b-128e-instruct-fp8 -0.317792  5.113842e-12   450\n","                   mistral-medium-2505 -0.316073  6.743352e-12   450\n","                      deepseek-r1-0528 -0.309903  1.793093e-11   450\n","         llama-3.2-90b-vision-instruct -0.311128  1.479429e-11   450\n","            meta-llama-3.1-8b-instruct -0.417146  2.257166e-20   450\n","        llama-4-scout-17b-16e-instruct -0.211420  6.077782e-06   450\n","                          ALL (pooled) -0.316465 3.111944e-285 12346\n"]}],"source":["# pyright: reportUnknownMemberType=false, reportUnknownVariableType=false, reportUnknownArgumentType=false, reportMissingTypeStubs=false, reportIndexIssue=false, reportUnknownParameterType=false, reportAttributeAccessIssue=false, reportCallIssue=false, reportOperatorIssue=false, reportConstantRedefinition=false, reportPossiblyUnboundVariable=false, reportMissingImports=false, reportUnnecessaryIsInstance=false, reportPrivateImportUsage=false, reportMissingParameterType=false, reportUnusedImport=false, reportArgumentType=false, reportMissingTypeArgument=false, reportUndefinedVariable=false, reportGeneralTypeIssues=false, reportOptionalMemberAccess=false, reportOptionalSubscript=false, reportOptionalIterable=false, reportOptionalCall=false, reportReturnType=false, reportAssignmentType=false, reportOptionalOperand=false, reportUnnecessaryComparison=false, reportUnusedFunction=false, reportUnusedVariable=false, reportUnboundVariable=false, reportUnknownLambdaType=false, reportUnusedClass=false\n","# ── Chapter 5 figures + Spearman ρ table ─────────────────────────────────────\n","# Recker §7.8: bar, stacked column, heat map, box plot, correlogram.\n","# Inputs : all_experiment_results.csv (already on disk).\n","# Outputs: data_export/figures/*.pdf  and  data_export/tables/tab_spearman.tex\n","import json\n","from pathlib import Path\n","import numpy as np\n","import pandas as pd\n","import matplotlib.pyplot as plt\n","from matplotlib.colors import LinearSegmentedColormap\n","from matplotlib.ticker import FuncFormatter\n","from scipy import stats\n","\n","# ── Load results ─────────────────────────────────────────────────────────────\n","_root = Path(globals().get(\"WORK_ROOT\", \".\"))\n","# Prefer combined (few-shot + RAG) if present, else few-shot only.\n","_combined = _root / \"data_export\" / \"all_experiment_results_combined.csv\"\n","_RES = _combined if _combined.exists() else _root / \"data_export\" / \"all_experiment_results.csv\"\n","_FIGS_OK = False\n","if not _RES.exists():\n","    print(f\"SKIP figures — {_RES} not found. Run cell 50 (few-shot benchmark) first.\")\n","else:\n","    df_fig = pd.read_csv(_RES)\n","    if df_fig.empty:\n","        print(f\"SKIP figures — {_RES} is empty.\")\n","    else:\n","        df_fig[\"correct\"] = df_fig[\"correct\"].astype(int)\n","        df_fig[\"tier_num\"] = df_fig[\"tier\"].astype(str).str.extract(r\"(\\d+)\").astype(int)\n","        df_fig[\"model_label\"] = df_fig[\"model\"].str.split(\"/\").str[-1]\n","        if \"error_msg\" not in df_fig.columns and \"error\" in df_fig.columns:\n","            df_fig[\"error_msg\"] = df_fig[\"error\"]\n","        if \"error_msg\" not in df_fig.columns:\n","            df_fig[\"error_msg\"] = \"\"\n","        if \"latency_s\" not in df_fig.columns:\n","            df_fig[\"latency_s\"] = float(\"nan\")\n","        _FIGS_OK = True\n","\n","if _FIGS_OK:\n","\n","    _FIG_DIR = _root / \"data_export\" / \"figures\"; _FIG_DIR.mkdir(parents=True, exist_ok=True)\n","    _TAB_DIR = _root / \"data_export\" / \"tables\";  _TAB_DIR.mkdir(parents=True, exist_ok=True)\n","\n","    # Consistent model order (best→worst overall) for every figure\n","    _order = (df_fig.groupby(\"model_label\")[\"correct\"].mean()\n","              .sort_values(ascending=False).index.tolist())\n","\n","    plt.rcParams.update({\n","        \"font.size\": 11, \"axes.titlesize\": 12, \"axes.labelsize\": 11,\n","        \"xtick.labelsize\": 10, \"ytick.labelsize\": 10, \"legend.fontsize\": 10,\n","        \"pdf.fonttype\": 42, \"savefig.bbox\": \"tight\", \"savefig.dpi\": 200,\n","    })\n","\n","    def _wilson_ci(k: int, n: int, z: float = 1.96) -> tuple[float, float]:\n","        \"\"\"Wilson score 95% CI for a proportion (Lind ch. 9 / Walpole §9.7).\"\"\"\n","        if n == 0: return (0.0, 0.0)\n","        p = k / n\n","        denom = 1 + z*z/n\n","        centre = (p + z*z/(2*n)) / denom\n","        half = (z * ((p*(1-p)/n + z*z/(4*n*n)) ** 0.5)) / denom\n","        return (max(0.0, centre - half), min(1.0, centre + half))\n","\n","    # ── Figure 1: Accuracy bar with 95 % Wilson CI (H1) ──────────────────────────\n","    fig, ax = plt.subplots(figsize=(7.0, 4.2))\n","    means, lo, hi = [], [], []\n","    for m in _order:\n","        s = df_fig[df_fig[\"model_label\"] == m]\n","        k, n = int(s[\"correct\"].sum()), len(s)\n","        means.append(k / n)\n","        l, h = _wilson_ci(k, n)\n","        lo.append(means[-1] - l); hi.append(h - means[-1])\n","    xs = np.arange(len(_order))\n","    ax.bar(xs, means, yerr=[lo, hi], capsize=4, color=\"#3B6FB6\", edgecolor=\"black\", linewidth=0.6)\n","    for i, mu in enumerate(means):\n","        ax.text(i, mu + hi[i] + 0.01, f\"{mu*100:.1f}%\", ha=\"center\", fontsize=9)\n","    ax.set_xticks(xs); ax.set_xticklabels(_order, rotation=20, ha=\"right\")\n","    ax.set_ylabel(\"Execution accuracy\"); ax.set_ylim(0, 1.0)\n","    ax.set_title(\"Overall NL→SQL accuracy by model (95% Wilson CI)\")\n","    ax.yaxis.set_major_formatter(FuncFormatter(lambda x, _: f\"{x*100:.0f}%\"))\n","    ax.grid(axis=\"y\", linestyle=\":\", alpha=0.5)\n","    plt.savefig(_FIG_DIR / \"fig_accuracy_bar.pdf\"); plt.close(fig)\n","    print(\"  ✓ fig_accuracy_bar.pdf\")\n","\n","    # ── Figure 2: Stacked outcomes (correct / wrong / error) ─────────────────────\n","    def _outcome(row):\n","        if row[\"correct\"] == 1: return \"correct\"\n","        msg = str(row.get(\"error_msg\", \"\")).strip()\n","        if msg and msg.lower() != \"nan\": return \"error\"\n","        return \"wrong\"\n","    df_fig[\"outcome\"] = df_fig.apply(_outcome, axis=1)\n","    ct = (df_fig.groupby([\"model_label\", \"outcome\"]).size().unstack(fill_value=0)\n","          .reindex(_order).reindex(columns=[\"correct\", \"wrong\", \"error\"], fill_value=0))\n","    totals = ct.sum(axis=1).replace(0, 1)\n","    pct = ct.div(totals, axis=0)\n","\n","    fig, ax = plt.subplots(figsize=(7.0, 4.2))\n","    bottom = np.zeros(len(_order))\n","    colors = {\"correct\": \"#4C9F70\", \"wrong\": \"#D9A441\", \"error\": \"#C7522A\"}\n","    for col in [\"correct\", \"wrong\", \"error\"]:\n","        vals = pct[col].values\n","        ax.bar(_order, vals, bottom=bottom, label=col.capitalize(),\n","               color=colors[col], edgecolor=\"black\", linewidth=0.5)\n","        bottom += vals\n","    ax.set_ylabel(\"Share of questions\"); ax.set_ylim(0, 1.0)\n","    plt.setp(ax.get_xticklabels(), rotation=20, ha=\"right\")\n","    ax.set_title(\"Outcome distribution per model\")\n","    ax.yaxis.set_major_formatter(FuncFormatter(lambda x, _: f\"{x*100:.0f}%\"))\n","    ax.legend(loc=\"lower right\", framealpha=0.9)\n","    ax.grid(axis=\"y\", linestyle=\":\", alpha=0.5)\n","    plt.savefig(_FIG_DIR / \"fig_outcome_stacked.pdf\"); plt.close(fig)\n","    print(\"  ✓ fig_outcome_stacked.pdf\")\n","\n","    # ── Figure 3: Heat map (model × tier accuracy) — H2, H3 ──────────────────────\n","    heat = (df_fig.groupby([\"model_label\", \"tier_num\"])[\"correct\"].mean()\n","            .unstack(fill_value=np.nan).reindex(_order))\n","    heat = heat[sorted(heat.columns)]\n","    fig, ax = plt.subplots(figsize=(6.5, 0.55 * len(_order) + 1.5))\n","    cmap = LinearSegmentedColormap.from_list(\"acc\", [\"#C7522A\", \"#F4E1A4\", \"#4C9F70\"])\n","    im = ax.imshow(heat.values, cmap=cmap, vmin=0, vmax=1, aspect=\"auto\")\n","    ax.set_xticks(range(len(heat.columns)))\n","    ax.set_xticklabels([f\"T{c}\" for c in heat.columns])\n","    ax.set_yticks(range(len(heat.index)))\n","    ax.set_yticklabels(heat.index)\n","    ax.set_xlabel(\"Question complexity tier\"); ax.set_title(\"Accuracy by model × tier\")\n","    for i in range(heat.shape[0]):\n","        for j in range(heat.shape[1]):\n","            v = heat.values[i, j]\n","            if not np.isnan(v):\n","                ax.text(j, i, f\"{v*100:.0f}\", ha=\"center\", va=\"center\",\n","                        color=\"black\" if 0.30 < v < 0.80 else \"white\", fontsize=9)\n","    cbar = plt.colorbar(im, ax=ax, fraction=0.04, pad=0.03)\n","    cbar.ax.set_ylabel(\"Accuracy\", rotation=90, labelpad=8)\n","    plt.savefig(_FIG_DIR / \"fig_tier_heatmap.pdf\"); plt.close(fig)\n","    print(\"  ✓ fig_tier_heatmap.pdf\")\n","\n","    # ── Figure 4: Latency box plot per model ─────────────────────────────────────\n","    fig, ax = plt.subplots(figsize=(7.0, 4.2))\n","    lat_data = [df_fig.loc[df_fig[\"model_label\"] == m, \"latency_s\"].dropna().values\n","                for m in _order]\n","    bp = ax.boxplot(lat_data, tick_labels=_order, showfliers=False, patch_artist=True,\n","                    medianprops={\"color\": \"black\", \"linewidth\": 1.5})\n","    for patch in bp[\"boxes\"]:\n","        patch.set_facecolor(\"#9DB4D6\"); patch.set_edgecolor(\"black\")\n","    ax.set_ylabel(\"Latency (s)\"); ax.set_title(\"Per-call latency by model\")\n","    plt.setp(ax.get_xticklabels(), rotation=20, ha=\"right\")\n","    ax.grid(axis=\"y\", linestyle=\":\", alpha=0.5)\n","    plt.savefig(_FIG_DIR / \"fig_latency_box.pdf\"); plt.close(fig)\n","    print(\"  ✓ fig_latency_box.pdf\")\n","\n","    # ── Figure 5 + Table: Spearman ρ (tier rank vs correctness) per model — H3 ──\n","    rho_rows = []\n","    for m in _order:\n","        s = df_fig[df_fig[\"model_label\"] == m]\n","        if s[\"tier_num\"].nunique() < 2:\n","            rho, p = float(\"nan\"), float(\"nan\")\n","        else:\n","            rho, p = stats.spearmanr(s[\"tier_num\"], s[\"correct\"])\n","        rho_rows.append({\"model\": m, \"rho\": rho, \"p_value\": p, \"n\": len(s)})\n","    # Pooled\n","    rho_all, p_all = stats.spearmanr(df_fig[\"tier_num\"], df_fig[\"correct\"])\n","    rho_rows.append({\"model\": \"ALL (pooled)\", \"rho\": float(rho_all),\n","                     \"p_value\": float(p_all), \"n\": len(df_fig)})\n","    rho_df = pd.DataFrame(rho_rows)\n","\n","    # Correlogram-style figure (one bar per model, signed)\n","    fig, ax = plt.subplots(figsize=(7.0, 4.0))\n","    plot_df = rho_df[rho_df[\"model\"] != \"ALL (pooled)\"]\n","    bar_colors = [\"#C7522A\" if v < 0 else \"#3B6FB6\" for v in plot_df[\"rho\"]]\n","    ax.barh(plot_df[\"model\"], plot_df[\"rho\"], color=bar_colors, edgecolor=\"black\", linewidth=0.6)\n","    for i, (rho, p) in enumerate(zip(plot_df[\"rho\"], plot_df[\"p_value\"])):\n","        star = \"***\" if p < 0.001 else (\"**\" if p < 0.01 else (\"*\" if p < 0.05 else \"\"))\n","        ax.text(rho + (0.01 if rho >= 0 else -0.01), i,\n","                f\"{rho:+.2f}{star}\", va=\"center\",\n","                ha=\"left\" if rho >= 0 else \"right\", fontsize=9)\n","    ax.axvline(0, color=\"black\", linewidth=0.8)\n","    ax.set_xlabel(r\"Spearman $\\rho$ (tier rank vs correctness)\")\n","    ax.set_title(\"H3: Accuracy decreases with question complexity\")\n","    ax.invert_yaxis()\n","    xmax = max(0.05, float(np.nanmax(np.abs(plot_df[\"rho\"].values))) + 0.10)\n","    ax.set_xlim(-xmax, xmax)\n","    ax.grid(axis=\"x\", linestyle=\":\", alpha=0.5)\n","    plt.savefig(_FIG_DIR / \"fig_spearman_correlogram.pdf\"); plt.close(fig)\n","    print(\"  ✓ fig_spearman_correlogram.pdf\")\n","\n","    # Spearman LaTeX table\n","    def _fmt_p(p):\n","        if pd.isna(p): return \"--\"\n","        if p < 0.001: return r\"$<\\!0.001$\"\n","        return f\"{p:.3f}\"\n","    def _star(p):\n","        if pd.isna(p): return \"\"\n","        if p < 0.001: return r\"$^{***}$\"\n","        if p < 0.01:  return r\"$^{**}$\"\n","        if p < 0.05:  return r\"$^{*}$\"\n","        return \"\"\n","    _tex = [\n","        r\"\\begin{table}[ht]\",\n","        r\"\\center