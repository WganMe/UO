le=false, reportOptionalCall=false, reportReturnType=false, reportAssignmentType=false, reportOptionalOperand=false, reportUnnecessaryComparison=false, reportUnusedFunction=false, reportUnusedVariable=false, reportUnboundVariable=false, reportUnknownLambdaType=false, reportUnusedClass=false\n","# Fetch raw JSON to show structure before normalization.\n","# The endpoint can return non-JSON (HTML error page) on transient failures —\n","# guard with status check and fall back to an empty structure for display.\n","r = requests.get(f\"{BASE_URL}/sensors/data/json\",\n","                 params={\"last_n_hours\": 1, \"variables\": [\"NO2\"], \"limit\": 5,\n","                         \"bbox_p1_x\": BBOX_NEWCASTLE[0], \"bbox_p1_y\": BBOX_NEWCASTLE[1],\n","                         \"bbox_p2_x\": BBOX_NEWCASTLE[2], \"bbox_p2_y\": BBOX_NEWCASTLE[3]},\n","                 timeout=30)\n","raw: dict = {}\n","if r.status_code == 200 and r.text.strip().startswith((\"{\", \"[\")):\n","    try:\n","        raw = r.json()\n","    except Exception as _e:\n","        print(f\"  raw JSON parse failed: {_e}\")\n","else:\n","    print(f\"  raw fetch HTTP {r.status_code}, body[:120]={r.text[:120]!r}\")\n","print(\"Raw JSON keys:\", list(raw.keys()) if isinstance(raw, dict) else type(raw).__name__)\n","print(f\"Readings count: {len(raw.get('Readings', [])) if isinstance(raw, dict) else 0}\")\n","_sens = raw.get('Sensors', {}) if isinstance(raw, dict) else {}\n","print(f\"Sensors dict keys: {list(_sens.keys())[:3] if isinstance(_sens, dict) else 'n/a'}\")\n","print()\n","\n","# Normalize using uo-pyfetch (returns DataFrame directly).\n","# The live API frequently returns 500 — fall back to an empty DataFrame\n","# so downstream cells (which use the parquet snapshot) can continue.\n","try:\n","    df_readings = uo_pyfetch.get_sensor_data(\n","        last_n_hours=1,\n","        variables=[\"NO2\"],\n","        bbox=BBOX_NEWCASTLE,\n","        limit=100,\n","    )\n","except Exception as _e:\n","    print(f\"  live API unavailable ({_e.__class__.__name__}): {_e}\")\n","    print(\"  → falling back to parquet snapshot for last-1h NO2 sample\")\n","    df_readings = pd.DataFrame(columns=[\"Timestamp\", \"Sensor Name\", \"Variable\", \"Value\", \"Units\"])\n","    try:\n","        import duckdb, glob, os\n","        _candidates = []\n","        for _root in (\"/kaggle/input\", \".\"):\n","            _candidates.extend(glob.glob(os.path.join(_root, \"**\", \"*.parquet\"),\n","                                         recursive=True))\n","        if _candidates:\n","            _glob = _candidates[0].rsplit(\"/\", 1)[0] + \"/*.parquet\"\n","            _con  = duckdb.connect()\n","            _cols = _con.execute(f\"SELECT * FROM read_parquet('{_glob}') LIMIT 0\").df().columns.tolist()\n","            def _pick(cands):\n","                for c in cands:\n","                    if c in _cols: return c\n","                return None\n","            _name_c = _pick([\"Sensor_Name\", \"Sensor Name\", \"sensor_name\"])\n","            _var_c  = _pick([\"Variable\", \"variable\"])\n","            _val_c  = _pick([\"Value\", \"value\"])\n","            _ts_c   = _pick([\"Timestamp\", \"timestamp\"])\n","            _u_c    = _pick([\"Units\", \"units\", \"Unit\"])\n","            _lon_c  = _pick([\"Sensor_Centroid_Longitude\", \"Sensor Centroid Longitude\"])\n","            _lat_c  = _pick([\"Sensor_Centroid_Latitude\",  \"Sensor Centroid Latitude\"])\n","            if all([_name_c, _var_c, _val_c, _ts_c]):\n","                _max_ts = _con.execute(\n","                    f\"SELECT max(\\\"{_ts_c}\\\") FROM read_parquet('{_glob}') WHERE \\\"{_var_c}\\\"='NO2'\"\n","                ).fetchone()[0]\n","                _bbox_w = \"\"\n","                if _lon_c and _lat_c:\n","                    _bbox_w = (f' AND \"{_lon_c}\" BETWEEN {BBOX_NEWCASTLE[0]} AND {BBOX_NEWCASTLE[2]}'\n","                               f' AND \"{_lat_c}\" BETWEEN {BBOX_NEWCASTLE[1]} AND {BBOX_NEWCASTLE[3]}')\n","                _u_sel = f', \"{_u_c}\" AS Units' if _u_c else \", '' AS Units\"\n","                df_readings = _con.execute(f\"\"\"\n","                    SELECT \"{_ts_c}\" AS Timestamp,\n","                           \"{_name_c}\" AS \"Sensor Name\",\n","                           \"{_var_c}\" AS Variable,\n","                           \"{_val_c}\" AS Value\n","                           {_u_sel}\n","                    FROM read_parquet('{_glob}')\n","                    WHERE \"{_var_c}\" = 'NO2'\n","                      AND \"{_ts_c}\" >= TIMESTAMP '{_max_ts}' - INTERVAL 1 HOUR\n","                      {_bbox_w}\n","                    LIMIT 100\n","                \"\"\").df()\n","            _con.close()\n","    except Exception as _e2:\n","        print(f\"  parquet fallback failed: {_e2}\")\n","\n","# Ensure correct dtypes (only when columns present and non-empty)\n","if \"Timestamp\" in df_readings.columns and len(df_readings):\n","    df_readings[\"Timestamp\"] = pd.to_datetime(df_readings[\"Timestamp\"], utc=True)\n","if \"Value\" in df_readings.columns and len(df_readings):\n","    df_readings[\"Value\"] = pd.to_numeric(df_readings[\"Value\"], errors=\"coerce\")\n","\n","print(f\"DataFrame shape: {df_readings.shape}\")\n","print(f\"Dtypes:\\n{df_readings.dtypes}\")\n","df_readings.head()"]},{"cell_type":"markdown","id":"fe324e41","metadata":{"papermill":{"duration":0.038105,"end_time":"2026-08-30T04:34:23.863521","exception":false,"start_time":"2026-08-30T04:34:23.825416","status":"completed"},"tags":[]},"source":["## 6. Reusable API Helper Functions"]},{"cell_type":"code","execution_count":12,"id":"fc9a1c45","metadata":{"execution":{"iopub.execute_input":"2026-08-30T04:34:23.940579Z","iopub.status.busy":"2026-08-30T04:34:23.940244Z","iopub.status.idle":"2026-08-30T04:34:23.9552Z","shell.execute_reply":"2026-08-30T04:34:23.953732Z"},"papermill":{"duration":0.05668,"end_time":"2026-08-30T04:34:23.957915","exception":false,"start_time":"2026-08-30T04:34:23.901235","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Helper functions defined.\n"]}],"source":["# pyright: reportUnknownMemberType=false, reportUnknownVariableType=false, reportUnknownArgumentType=false, reportMissingTypeStubs=false, reportIndexIssue=false, reportUnknownParameterType=false, reportAttributeAccessIssue=false, reportCallIssue=false, reportOperatorIssue=false, reportConstantRedefinition=false, reportPossiblyUnboundVariable=false, reportMissingImports=false, reportUnnecessaryIsInstance=false, reportPrivateImportUsage=false, reportMissingParameterType=false, reportUnusedImport=false, reportArgumentType=false, reportMissingTypeArgument=false, reportUndefinedVariable=false, reportGeneralTypeIssues=false, reportOptionalMemberAccess=false, reportOptionalSubscript=false, reportOptionalIterable=false, reportOptionalCall=false, reportReturnType=false, reportAssignmentType=false, reportOptionalOperand=false, reportUnnecessaryComparison=false, reportUnusedFunction=false, reportUnusedVariable=false, reportUnboundVariable=false, reportUnknownLambdaType=false, reportUnusedClass=false\n","import time\n","from typing import Optional\n","\n","def fetch_sensor_data_safe(\n","    variables: list[str],\n","    bbox: Optional[list[float]] = None,\n","    last_n_hours: Optional[int] = None,\n","    last_n_days: Optional[int] = None,\n","    start: Optional[datetime] = None,\n","    end: Optional[datetime] = None,\n","    limit: int = 1000,\n","    max_retries: int = 3\n",") -> pd.DataFrame:\n","    \"\"\"Fetch sensor data with retry logic and type enforcement.\"\"\"\n","    if not globals().get(\"API_REACHABLE\", True):\n","        print(\"  fetch_sensor_data_safe: API unreachable, returning empty DataFrame\")\n","        return pd.DataFrame()\n","    for attempt in range(max_retries):\n","        try:\n","            df = uo_pyfetch.get_sensor_data(\n","                variables=variables,\n","                bbox=bbox,\n","                last_n_hours=last_n_hours,\n","                last_n_days=last_n_days,\n","                start=start,\n","                end=end,\n","                limit=limit\n","            )\n","            df[\"Timestamp\"] = pd.to_datetime(df[\"Timestamp\"], utc=True)\n","            df[\"Value\"] = pd.to_numeric(df[\"Value\"], errors=\"coerce\")\n","            return df\n","        except Exception as e:\n","            wait = 2 ** attempt\n","            print(f\"Attempt {attempt+1} failed: {e}. Retrying in {wait}s...\")\n","            time.sleep(wait)\n","    print(\"All retries exhausted.\")\n","    return pd.DataFrame()\n","\n","\n","def fetch_all_sensors(bbox: Optional[list[float]] = None, limit: int = -1) -> pd.DataFrame:\n","    \"\"\"Fetch all sensor locations (set limit=-1 for no pagination).\"\"\"\n","    return uo_pyfetch.get_sensors(limit=limit, bbox=bbox)\n","\n","\n","def fetch_sensor_history(\n","    sensor_name: str,\n","    variables: list[str],\n","    start: datetime,\n","    end: datetime,\n","    limit: int = -1\n",") -> pd.DataFrame:\n","    \"\"\"Fetch full history for a single named sensor (safe when API down).\"\"\"\n","    if not globals().get(\"API_REACHABLE\", True):\n","        print(\"  fetch_sensor_history: API unreachable, returning empty DataFrame\")\n","        return pd.DataFrame()\n","    try:\n","        df = uo_pyfetch.get_sensor_data_by_name(\n","            sensor_name,\n","            start=start,\n","            end=end,\n","            variables=variables,\n","            limit=limit,\n","        )\n","    except Exception as _e:\n","        print(f\"  fetch_sensor_history failed ({_e.__class__.__name__}): {_e}\")\n","        return pd.DataFrame()\n","    if df is None or len(df) == 0:\n","        return pd.DataFrame()\n","    df[\"Timestamp\"] = pd.to_datetime(df[\"Timestamp\"], utc=True)\n","    df[\"Value\"] = pd.to_numeric(df[\"Value\"], errors=\"coerce\")\n","    return df\n","\n","\n","print(\"Helper functions defined.\")"]},{"cell_type":"markdown","id":"05b19414","metadata":{"papermill":{"duration":0.037015,"end_time":"2026-08-30T04:34:24.033183","exception":false,"start_time":"2026-08-30T04:34:23.996168","status":"completed"},"tags":[]},"source":["## 7. All-Theme Sensor Variables — Population Scope\n","\n","This thesis evaluates an LLM-driven NL-to-SQL pipeline against the **entire** Newcastle Urban Observatory, not a single theme. Restricting to air quality (a sample of ~4 variables) would have made every later proportion an estimate $\\hat{p}$ with sampling error in the sense of Lind §8-2:\n","\n","> *\"since the sample is a part or portion of the population, it is unlikely that the sample mean would be exactly equal to the population mean … This difference is called sampling error.\"*  \n","> — Lind, Marchal & Wathen, *Statistical Techniques in Business and Economics* (17e), Ch 8 §8-2.\n","\n","Because the Urban Observatory exposes the **whole** sensor population through an open API, we can — and must — work at the population level. The dictionary below enumerates the variables we actually instrument across the seven core themes that are populated continuously in the live archive (Air Quality, Traffic, Weather, Noise, Water Quality, Environment, Building). The full archive download in §9b then turns these names into observed $\\mu$ and $\\sigma$ rather than estimated $\\bar{x}$ and $s$ (Walpole Ch 1, Definition 1.1; Walpole Ch 9 contrasts the two regimes).\n"]},{"cell_type":"code","execution_count":13,"id":"8fad7694","metadata":{"execution":{"iopub.execute_input":"2026-08-30T04:34:24.111811Z","iopub.status.busy":"2026-08-30T04:34:24.111239Z","iopub.status.idle":"2026-08-30T04:34:37.805048Z","shell.execute_reply":"2026-08-30T04:34:37.803372Z"},"papermill":{"duration":13.736093,"end_time":"2026-08-30T04:34:37.807382","exception":false,"start_time":"2026-08-30T04:34:24.071289","status":"completed"},"tags":[]},"outputs":[{"nam