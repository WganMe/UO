    "# pyright: reportUnknownMemberType=false, reportUnknownVariableType=false, reportUnknownArgumentType=false, reportMissingTypeStubs=false, reportIndexIssue=false, reportUnknownParameterType=false, reportAttributeAccessIssue=false, reportCallIssue=false, reportOperatorIssue=false, reportConstantRedefinition=false, reportPossiblyUnboundVariable=false, reportMissingImports=false, reportUnnecessaryIsInstance=false, reportPrivateImportUsage=false, reportMissingParameterType=false, reportUnusedImport=false, reportArgumentType=false, reportMissingTypeArgument=false, reportUndefinedVariable=false, reportGeneralTypeIssues=false, reportOptionalMemberAccess=false, reportOptionalSubscript=false, reportOptionalIterable=false, reportOptionalCall=false, reportReturnType=false, reportAssignmentType=false, reportOptionalOperand=false, reportUnnecessaryComparison=false, reportUnusedFunction=false, reportUnusedVariable=false, reportUnboundVariable=false, reportUnknownLambdaType=false, reportUnusedClass=false\n",
    "from typing import Any\n",
    "\n",
    "def generate_overall_accuracy_table(analysis: dict[str, Any], caption: str = \"Overall NL-to-SQL Accuracy by Model\",\n",
    "                                   label: str = \"tab:ch3_overall\") -> str:\n",
    "    \"\"\"Table 3.1 — Overall accuracy with Wilson CI.\"\"\"\n",
    "    df = analysis[\"overall\"]\n",
    "    lines = [\n",
    "        r\"\\begin{table}[htbp]\",\n",
    "        r\"\\centering\",\n",
    "        f\"\\\\caption{{{caption}}}\",\n",
    "        f\"\\\\label{{{label}}}\",\n",
    "        r\"\\begin{tabular}{llccc}\",\n",
    "        r\"\\toprule\",\n",
    "        r\"Strategy & Model & Correct/N & Accuracy & 95\\% Wilson CI \\\\\",\n",
    "        r\"\\midrule\",\n",
    "    ]\n",
    "    for _, row in df.iterrows():\n",
    "        ci = row[\"wilson_ci\"]\n",
    "        lines.append(\n",
    "            f\"  {row['strategy']} & {row['model_label']} & \"\n",
    "            f\"{int(row['correct'])}/{int(row['n'])} & \"\n",
    "            f\"{row['accuracy']:.2%} & [{ci[0]:.3f}, {ci[1]:.3f}] \\\\\\\\\"\n",
    "        )\n",
    "    lines += [r\"\\bottomrule\", r\"\\end{tabular}\", r\"\\end{table}\"]\n",
    "    return \"\\n\".join(lines)\n",
    "\n",
    "\n",
    "def generate_tier_accuracy_table(analysis: dict[str, Any], caption: str = \"Accuracy by Complexity Tier\",\n",
    "                                 label: str = \"tab:ch3_tier\") -> str:\n",
    "    \"\"\"Table 3.2 — Accuracy pivot by tier.\"\"\"\n",
    "    df = analysis[\"by_tier\"]\n",
    "    models = df[\"model_label\"].unique()\n",
    "    tiers = [\"T1\", \"T2\", \"T3\", \"T4\", \"T5\"]\n",
    "    col_spec = \"l\" + \"c\" * len(models)\n",
    "    header = \"Tier & \" + \" & \".join(models) + r\" \\\\\"\n",
    "\n",
    "    lines = [\n",
    "        r\"\\begin{table}[htbp]\",\n",
    "        r\"\\centering\",\n",
    "        f\"\\\\caption{{{caption}}}\",\n",
    "        f\"\\\\label{{{label}}}\",\n",
    "        f\"\\\\begin{{tabular}}{{{col_spec}}}\",\n",
    "        r\"\\toprule\",\n",
    "        header,\n",
    "        r\"\\midrule\",\n",
    "    ]\n",
    "    for tier in tiers:\n",
    "        cells = [tier]\n",
    "        for model in models:\n",
    "            mask = (df[\"tier\"] == tier) & (df[\"model_label\"] == model)\n",
    "            sub = df[mask]\n",
    "            if len(sub) > 0:\n",
    "                cells.append(f\"{sub.iloc[0]['accuracy']:.0%}\")\n",
    "            else:\n",
    "                cells.append(\"---\")\n",
    "        lines.append(\"  \" + \" & \".join(cells) + r\" \\\\\")\n",
    "    lines += [r\"\\bottomrule\", r\"\\end{tabular}\", r\"\\end{table}\"]\n",
    "    return \"\\n\".join(lines)\n",
    "\n",
    "\n",
    "def generate_fisher_table(analysis: dict[str, Any], caption: str = \"Fisher's Exact Test Results\",\n",
    "                          label: str = \"tab:ch4_fisher\") -> str:\n",
    "    \"\"\"Table 4.3 — Fisher's exact test with effect sizes.\"\"\"\n",
    "    df = analysis[\"fisher\"]\n",
    "    if len(df) == 0:\n",
    "        return \"% No Fisher test results to display (single strategy only)\"\n",
    "\n",
    "    lines = [\n",
    "        r\"\\begin{table}[htbp]\",\n",
    "        r\"\\centering\",\n",
    "        f\"\\\\caption{{{caption}}}\",\n",
    "        f\"\\\\label{{{label}}}\",\n",
    "        r\"\\begin{tabular}{llcccc}\",\n",
    "        r\"\\toprule\",\n",
    "        r\"Comparison & Model & OR & $p$ & $p_{\\text{Bonf}}$ & Cohen's $h$ \\\\\",\n",
    "        r\"\\midrule\",\n",
    "    ]\n",
    "    for _, row in df.iterrows():\n",
    "        sig = \"*\" if row.get(\"sig_bonf\", False) else \"\"\n",
    "        p_raw = row.get(\"p_fisher\", row.get(\"p_value\", 0.0))\n",
    "        p_bonf = row.get(\"p_bonferroni\", p_raw)\n",
    "        lines.append(\n",
    "            f\"  {row['comparison']} & {row['model']} & \"\n",
    "            f\"{row['odds_ratio']:.2f} & {p_raw:.4f} & \"\n",
    "            f\"{p_bonf:.4f}{sig} & \"\n",
    "            f\"{row['cohens_h']:.3f} \\\\\\\\\"\n",
    "        )\n",
    "    lines += [r\"\\bottomrule\", r\"\\end{tabular}\", r\"\\end{table}\"]\n",
    "    return \"\\n\".join(lines)\n",
    "\n",
    "\n",
    "def generate_mwu_table(analysis: dict[str, Any], caption: str = \"Pairwise Model Comparisons (Mann--Whitney U)\",\n",
    "                       label: str = \"tab:ch4_mwu\") -> str:\n",
    "    \"\"\"Table 4.4 — Pairwise Mann-Whitney U with Cliff's delta.\"\"\"\n",
    "    df = analysis.get(\"mann_whitney\")\n",
    "    if df is None or len(df) == 0:\n",
    "        return \"% No Mann-Whitney results to display\"\n",
    "\n",
    "    lines = [\n",
    "        r\"\\begin{table}[htbp]\",\n",
    "        r\"\\centering\",\n",
    "        f\"\\\\caption{{{caption}}}\",\n",
    "        f\"\\\\label{{{label}}}\",\n",
    "        r\"\\begin{tabular}{llcccc}\",\n",
    "        r\"\\toprule\",\n",
    "        r\"Strategy & Comparison & $U$ & $p$ & Cliff's $\\delta$ & Effect \\\\\",\n",
    "        r\"\\midrule\",\n",
    "    ]\n",
    "    for _, row in df.iterrows():\n",
    "        lines.append(\n",
    "            f\"  {row['strategy']} & {row['model_1']} vs.\\\\ {row['model_2']} & \"\n",
    "            f\"{row['U']:.0f} & {row['p_mwu']:.4f} & \"\n",
    "            f\"{row['cliffs_d']:.3f} & {row['effect_label']} \\\\\\\\\"\n",
    "        )\n",
    "    lines += [r\"\\bottomrule\", r\"\\end{tabular}\", r\"\\end{table}\"]\n",
    "    return \"\\n\".join(lines)\n",
    "\n",
    "\n",
    "def generate_kruskal_table(analysis: dict[str, Any], caption: str = \"Kruskal--Wallis Across Complexity Tiers\",\n",
    "                           label: str = \"tab:ch4_kruskal\") -> str:\n",
    "    \"\"\"Table 4.5 — Kruskal-Wallis H test across tiers.\"\"\"\n",
    "    df = analysis.get(\"kruskal_wallis\")\n",
    "    if df is None or len(df) == 0:\n",
    "        return \"% No Kruskal-Wallis results to display\"\n",
    "\n",
    "    lines = [\n",
    "        r\"\\begin{table}[htbp]\",\n",
    "        r\"\\centering\",\n",
    "        f\"\\\\caption{{{caption}}}\",\n",
    "        f\"\\\\label{{{label}}}\",\n",
    "        r\"\\begin{tabular}{llccc}\",\n",
    "        r\"\\toprule\",\n",
    "        r\"Strategy & Model & $H$ & $p$ & Significant \\\\\",\n",
    "        r\"\\midrule\",\n",
    "    ]\n",
    "    for _, row in df.iterrows():\n",
    "        sig = \"yes\" if row.get(\"significant\", False) else \"no\"\n",
    "        lines.append(\n",
    "            f\"  {row['strategy']} & {row['model']} & \"\n",
    "            f\"{row['H_statistic']:.3f} & {row['p_kruskal']:.4f} & {sig} \\\\\\\\\"\n",
    "        )\n",
    "    lines += [r\"\\bottomrule\", r\"\\end{tabular}\", r\"\\end{table}\"]\n",
    "    return \"\\n\".join(lines)\n",
    "\n",
    "\n",
    "# ─────────────────────────────────────────────────────────────────────────\n",
    "# Build adapter DataFrame from df_results and emit all .tex files\n",
    "# df_results columns: q_id, tier, domain, model, question, gold_sql,\n",
    "#                     generated_sql, correct, error_msg, latency_s\n",
    "# analyse_benchmark_results() expects: strategy, model_label, tier (str\n",
    "# \"T1\"..\"T5\"), correct, question_id\n",
    "# ─────────────────────────────────────────────────────────────────────────\n",
    "import pandas as pd\n",
    "\n",
    "# Make sure df_results is loaded\n",
    "try:\n",
    "    df_results  # type: ignore[name-defined]\n",
    "except NameError:\n",
    "    df_results = pd.read_csv(RESULTS_CSV)\n",
    "\n",
    "_df_tex = df_results.copy()\n",
    "_df_tex[\"strategy\"] = \"FewShot\"\n",
    "_df_tex[\"model_label\"] = _df_tex[\"model\"].apply(lambda m: str(m).split(\"/\")[-1])\n",
