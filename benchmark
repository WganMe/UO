MA, sqlite_master, system table access |"]},{"cell_type":"code","execution_count":36,"id":"7cfa0277","metadata":{"execution":{"iopub.execute_input":"2026-08-30T05:07:16.924893Z","iopub.status.busy":"2026-08-30T05:07:16.924481Z","iopub.status.idle":"2026-08-30T05:07:16.94362Z","shell.execute_reply":"2026-08-30T05:07:16.942082Z"},"papermill":{"duration":0.085122,"end_time":"2026-08-30T05:07:16.94595","exception":false,"start_time":"2026-08-30T05:07:16.860828","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Anomaly detector tests:\n","  PASS: safe=True (expected=True) | SELECT sensor_name FROM sensors;\n","  PASS: safe=False (expected=False) | DROP TABLE sensors;\n","         flags: ['R2_DESTRUCTIVE']\n","  PASS: safe=False (expected=False) | SELECT * FROM readings; -- comment\n","         flags: ['R1_INJECTION', 'R4_UNBOUNDED_SCAN']\n","  PASS: safe=False (expected=False) | SELECT * FROM nonexistent_table;\n","         flags: ['R3_UNKNOWN_TABLE:nonexistent_table']\n","  PASS: safe=False (expected=False) | PRAGMA table_info(sensors);\n","         flags: ['R6_INFO_LEAK']\n","  PASS: safe=False (expected=False) | SELECT sensor_name FROM sensors WHERE broker_name = '' OR '1\n","         flags: ['R1_INJECTION']\n","\n","Anomaly detector defined with 6 rule classes. All tests: PASS\n"]}],"source":["# pyright: reportUnknownMemberType=false, reportUnknownVariableType=false, reportUnknownArgumentType=false, reportMissingTypeStubs=false, reportIndexIssue=false, reportUnknownParameterType=false, reportAttributeAccessIssue=false, reportCallIssue=false, reportOperatorIssue=false, reportConstantRedefinition=false, reportPossiblyUnboundVariable=false, reportMissingImports=false, reportUnnecessaryIsInstance=false, reportPrivateImportUsage=false, reportMissingParameterType=false, reportUnusedImport=false, reportArgumentType=false, reportMissingTypeArgument=false, reportUndefinedVariable=false, reportGeneralTypeIssues=false, reportOptionalMemberAccess=false, reportOptionalSubscript=false, reportOptionalIterable=false, reportOptionalCall=false, reportReturnType=false, reportAssignmentType=false, reportOptionalOperand=false, reportUnnecessaryComparison=false, reportUnusedFunction=false, reportUnusedVariable=false, reportUnboundVariable=false, reportUnknownLambdaType=false, reportUnusedClass=false\n","import re\n","\n","# Known schema elements\n","VALID_TABLES = {\"sensors\", \"variables\", \"readings\"}\n","VALID_COLUMNS = {\n","    \"sensor_name\", \"location_wkt\", \"centroid_lon\", \"centroid_lat\",\n","    \"ground_height\", \"sensor_height\", \"broker_name\", \"raw_id\",\n","    \"variable_name\", \"units\", \"theme\",\n","    \"id\", \"variable\", \"value\", \"timestamp\", \"flagged\",\n","}\n","\n","# CTE aliases allowed in R3 check\n","_KNOWN_ALIASES = {\n","    'sub', 'subquery', 'd', 'd1', 'd2', 'no2', 'pm25', 'pm10', 'aq', 'wx',\n","    'hourly', 'daily', 'pivoted', 'totals', 'no2_counts', 'no2_high',\n","    'pm10_high', 'theme_stats', 'var_avgs', 'daily_exceed', 'normed',\n","    'no2_stats', 'pm25_stats', 'base',\n","}\n","\n","def check_sql_anomaly(sql: str) -> dict[str, object]:\n","    \"\"\"Pre-execution anomaly detector. Returns {safe: bool, flags: list}.\"\"\"\n","    flags: list[str] = []\n","    sql_upper = sql.upper().strip()\n","\n","    # R1: SQL injection patterns\n","    injection_patterns = [\n","        r\"'\\s*OR\\s+'\\d+'\\s*=\\s*'\\d+'\",     # ' OR '1'='1'\n","        r\"'\\s*OR\\s+1\\s*=\\s*1\",              # ' OR 1=1\n","        r\";\\s*--\",                           # ; --\n","        r\"UNION\\s+ALL\\s+SELECT\\s+.+FROM\",   # UNION ALL SELECT ... FROM\n","    ]\n","    for pattern in injection_patterns:\n","        if re.search(pattern, sql, re.IGNORECASE):\n","            flags.append(\"R1_INJECTION\")\n","            break\n","\n","    # R2: Destructive statements (simplified to a single regex)\n","    if re.search(\n","        r'\\b(DROP|DELETE|UPDATE|INSERT|ALTER|TRUNCATE|CREATE\\s+TABLE|REPLACE\\s+INTO)\\b',\n","        sql, re.IGNORECASE\n","    ):\n","        flags.append(\"R2_DESTRUCTIVE\")\n","\n","    # R3: Schema mismatch — extract FROM/JOIN table references\n","    table_refs = re.findall(r'(?:FROM|JOIN)\\s+([a-zA-Z_][a-zA-Z0-9_]*)', sql, re.IGNORECASE)\n","    for t in table_refs:\n","        if t.lower() not in VALID_TABLES and t.lower() not in _KNOWN_ALIASES:\n","            flags.append(f\"R3_UNKNOWN_TABLE:{t}\")\n","\n","    # R4: Unbounded scan (SELECT * FROM readings without WHERE or LIMIT)\n","    if re.search(r'SELECT\\s+\\*\\s+FROM\\s+readings', sql, re.IGNORECASE):\n","        if 'WHERE' not in sql_upper and 'LIMIT' not in sql_upper:\n","            flags.append(\"R4_UNBOUNDED_SCAN\")\n","\n","    # R5: Syntax — unmatched parentheses\n","    if sql.count('(') != sql.count(')'):\n","        flags.append(\"R5_UNMATCHED_PARENS\")\n","\n","    # R5b: Missing FROM in SELECT statement (allow literal-value selects)\n","    if 'SELECT' in sql_upper and 'FROM' not in sql_upper:\n","        if not re.search(r\"SELECT\\s+\\d+|SELECT\\s+'\", sql, re.IGNORECASE):\n","            flags.append(\"R5_MISSING_FROM\")\n","\n","    # R6: Information leak — system table access\n","    leak_patterns = [\"PRAGMA\", \"SQLITE_MASTER\", \"SQLITE_SCHEMA\",\n","                     \"INFORMATION_SCHEMA\", \"SYS.\", \"DBA_\"]\n","    for lp in leak_patterns:\n","        if lp in sql_upper:\n","            flags.append(\"R6_INFO_LEAK\")\n","            break\n","\n","    return {\"safe\": len(flags) == 0, \"flags\": flags}\n","\n","# ── Test anomaly detector ────────────────────────────────────\n","test_cases = [\n","    (\"SELECT sensor_name FROM sensors;\", True),\n","    (\"DROP TABLE sensors;\", False),\n","    (\"SELECT * FROM readings; -- comment\", False),\n","    (\"SELECT * FROM nonexistent_table;\", False),\n","    (\"PRAGMA table_info(sensors);\", False),\n","    (\"SELECT sensor_name FROM sensors WHERE broker_name = '' OR '1'='1';\", False),\n","]\n","\n","print(\"Anomaly detector tests:\")\n","all_pass = True\n","for sql, expected_safe in test_cases:\n","    result = check_sql_anomaly(sql)\n","    status = \"PASS\" if result[\"safe\"] == expected_safe else \"FAIL\"\n","    if status == \"FAIL\":\n","        all_pass = False\n","    print(f\"  {status}: safe={result['safe']} (expected={expected_safe}) | {sql[:60]}\")\n","    if result[\"flags\"]:\n","        print(f\"         flags: {result['flags']}\")\n","\n","print(f\"\\nAnomaly detector defined with 6 rule classes. All tests: {'PASS' if all_pass else 'FAIL'}\")\n"]},{"cell_type":"markdown","id":"904ea76a","metadata":{"papermill":{"duration":0.073039,"end_time":"2026-08-30T05:07:17.088992","exception":false,"start_time":"2026-08-30T05:07:17.015953","status":"completed"},"tags":[]},"source":["## 17. RAG Pipeline — Schema Retrieval (Chapter 4)\n","\n","Two RAG strategies compared against the few-shot baseline from Chapter 3:\n","\n","| Strategy | ρ_exposure | Description |\n","|---|---|---|\n","| **Few-Shot** (baseline) | 1.00 | Full DDL + examples in every prompt |\n","| **Naïve RAG** | ~0.33–0.67 | Embed schema chunks → retrieve top-k by cosine similarity |\n","| **Enhanced RAG** | ~0.33–1.00 | Naïve + theme detection + relationship-aware expansion |"]},{"cell_type":"code","execution_count":37,"id":"c1e7f2d6","metadata":{"execution":{"iopub.execute_input":"2026-08-30T05:07:17.23693Z","iopub.status.busy":"2026-08-30T05:07:17.236262Z","iopub.status.idle":"2026-08-30T05:10:17.726872Z","shell.execute_reply":"2026-08-30T05:10:17.725419Z"},"papermill":{"duration":180.568648,"end_time":"2026-08-30T05:10:17.729921","exception":false,"start_time":"2026-08-30T05:07:17.161273","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["\u001b[31mERROR: pip's dependency resolver does not currently take into account all the packages that are installed. This behaviour is the source of the following dependency c