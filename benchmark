    "def fetch_paginated(\n",
    "    variables: list[str],\n",
    "    start: datetime,\n",
    "    end: datetime,\n",
    "    bbox: Optional[list[float]] = None,\n",
    "    page_size: int = 1000,\n",
    "    max_pages: int = 50,\n",
    "    pause: float = 1.0\n",
    ") -> pd.DataFrame:\n",
    "    \"\"\"Fetch large datasets with pagination and rate-limit backoff.\"\"\"\n",
    "    all_frames: list[pd.DataFrame] = []\n",
    "    offset = 0\n",
    "\n",
    "    for page in range(max_pages):\n",
    "        try:\n",
    "            df = uo_pyfetch.get_sensor_data(\n",
    "                variables=variables,\n",
    "                start=start,\n",
    "                end=end,\n",
    "                bbox=bbox,\n",
    "                limit=page_size,\n",
    "                offset=offset\n",
    "            )\n",
    "        except Exception as e:\n",
    "            print(f\"Page {page} failed: {e}. Backing off...\")\n",
    "            time.sleep(pause * 4)\n",
    "            continue\n",
    "\n",
    "        if df.empty:\n",
    "            print(f\"No more data at offset {offset}. Done.\")\n",
    "            break\n",
    "\n",
    "        all_frames.append(df)\n",
    "        offset += page_size\n",
    "        print(f\"Page {page}: {len(df)} rows (total so far: {sum(len(f) for f in all_frames)})\")\n",
    "\n",
    "        if len(df) < page_size:\n",
    "            print(\"Last page reached.\")\n",
    "            break\n",
    "\n",
    "        time.sleep(pause)  # polite rate limiting\n",
    "\n",
    "    if not all_frames:\n",
    "        return pd.DataFrame()\n",
    "\n",
    "    result = pd.concat(all_frames, ignore_index=True)\n",
    "    result[\"Timestamp\"] = pd.to_datetime(result[\"Timestamp\"], utc=True)\n",
    "    result[\"Value\"] = pd.to_numeric(result[\"Value\"], errors=\"coerce\")\n",
    "    return result\n",
    "\n",
