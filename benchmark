    "# Validate all ground-truth SQL against the SQLite database\n",
    "import hashlib\n",
    "\n",
    "def get_result_hash(conn: sqlite3.Connection, sql: str):\n",
    "    \"\"\"Execute SQL and return a hash of the result set for comparison.\"\"\"\n",
    "    try:\n",
    "        cur = conn.cursor()\n",
    "        cur.execute(sql)\n",
    "        rows = cur.fetchall()\n",
    "        result_str = str(sorted([str(r) for r in rows]))\n",
    "        return hashlib.md5(result_str.encode()).hexdigest(), len(rows), None\n",
    "    except Exception as e:\n",
    "        return None, 0, str(e)\n",
    "\n",
    "# === SQLite UDF helpers (also redefined in next cell) ===\n",
    "import sqlite3, math\n",
    "class _Variance:\n",
    "    \"\"\"Population variance aggregate: VAR_POP / VARIANCE.\"\"\"\n",
    "    def __init__(self):\n",
    "        self.vals: list[float] = []\n",
    "    def step(self, value):\n",
    "        if value is not None:\n",
    "            self.vals.append(float(value))\n",
    "    def finalize(self):\n",
    "        if not self.vals:\n",
    "            return None\n",
    "        mu = sum(self.vals) / len(self.vals)\n",
    "        return sum((x - mu) ** 2 for x in self.vals) / len(self.vals)\n",
    "\n",
    "class _StdDev:\n",
    "    \"\"\"Population standard deviation aggregate: STDDEV / STDEV / STDDEV_POP.\"\"\"\n",
    "    def __init__(self):\n",
    "        self.vals: list[float] = []\n",
    "    def step(self, value):\n",
    "        if value is not None:\n",
    "            self.vals.append(float(value))\n",
    "    def finalize(self):\n",
    "        if not self.vals:\n",
    "            return None\n",
    "        mu = sum(self.vals) / len(self.vals)\n",
    "        var = sum((x - mu) ** 2 for x in self.vals) / len(self.vals)\n",
    "        return math.sqrt(var)\n",
    "\n",
    "class _StdDevSamp:\n",
    "    \"\"\"Sample standard deviation aggregate: STDDEV_SAMP.\"\"\"\n",
    "    def __init__(self):\n",
    "        self.vals: list[float] = []\n",
    "    def step(self, value):\n",
    "        if value is not None:\n",
    "            self.vals.append(float(value))\n",
    "    def finalize(self):\n",
    "        if len(self.vals) < 2:\n",
    "            return None\n",
    "        mu = sum(self.vals) / len(self.vals)\n",
    "        var = sum((x - mu) ** 2 for x in self.vals) / (len(self.vals) - 1)\n",
