  62✗  11E  (51.3%)\n","\n","⚡ Re-scored in 1369.5s (RERUN_FAILED_VIA_API=False)\n"]}],"source":["# pyright: reportUnknownMemberType=false, reportUnknownVariableType=false, reportUnknownArgumentType=false, reportMissingTypeStubs=false, reportIndexIssue=false, reportUnknownParameterType=false, reportAttributeAccessIssue=false, reportCallIssue=false, reportOperatorIssue=false, reportConstantRedefinition=false, reportPossiblyUnboundVariable=false, reportMissingImports=false, reportUnnecessaryIsInstance=false, reportPrivateImportUsage=false, reportMissingParameterType=false, reportUnusedImport=false, reportArgumentType=false, reportMissingTypeArgument=false, reportUndefinedVariable=false, reportGeneralTypeIssues=false, reportOptionalMemberAccess=false, reportOptionalSubscript=false, reportOptionalIterable=false, reportOptionalCall=false, reportReturnType=false, reportAssignmentType=false, reportOptionalOperand=false, reportUnnecessaryComparison=false, reportUnusedFunction=false, reportUnusedVariable=false, reportUnboundVariable=false, reportUnknownLambdaType=false, reportUnusedClass=false\n","# ── RE-EVALUATE existing results + optionally RE-RUN failed rows ──────────────\n","# Phase 1: Re-run every generated SQL against the (rebuilt) DB, re-compare\n","#           with order-insensitive matching.  NO API calls — instant.\n","# Phase 2: Rows that still have errors → strip from CSV.\n","# Phase 3: Re-run only the stripped (q_id, model) pairs via API with fixes\n","#           (R1 gets 4096 tokens, unclosed <think> handled, 200M op limit).\n","# ── Skip-friendly preamble: if no prior benchmark results exist, create an empty\n","# results file with the expected columns so this cell becomes a no-op cleanly.\n","RERUN_FAILED_VIA_API = False  # ← flip to True when you actually want API re-runs\n","\n","from pathlib import Path\n","import pandas as _pd\n","_RC = Path(RESULTS_CSV)\n","if not _RC.exists():\n","    _RC.parent.mkdir(parents=True, exist_ok=True)\n","    _pd.DataFrame(columns=[\n","        \"id\", \"tier\", \"model\", \"generated_sql\", \"gold_sql\",\n","        \"correct\", \"error\", \"rows_returned\"\n","    ]).to_csv(_RC, index=False)\n","    print(f\"SKIP: re-evaluation — no prior {RESULTS_CSV}.\")\n","    print(\"       Created empty file; benchmark cell will fill it on a future run.\")\n","\n","import pandas as pd, sqlite3, time, sys\n","\n","df = pd.read_csv(RESULTS_CSV)\n","# Be tolerant of older / partial CSVs that may be missing some columns\n","# (e.g. an upload that pre-dates the current FIELDNAMES schema).\n","for _col, _default in [\n","    (\"correct\", 0), (\"error_msg\", \"\"), (\"generated_sql\", \"\"), (\"gold_sql\", \"\"),\n","    (\"q_id\", \"\"), (\"tier\", \"\"), (\"domain\", \"\"), (\"model\", \"\"),\n","    (\"question\", \"\"), (\"latency_s\", 0.0),\n","]:\n","    if _col not in df.columns:\n","        # Some upstream versions used \"id\" instead of \"q_id\" and \"error\" instead of \"error_msg\".\n","        if _col == \"q_id\" and \"id\" in df.columns:\n","            df[\"q_id\"] = df[\"id\"]\n","            continue\n","        if _col == \"error_msg\" and \"error\" in df.columns:\n","            df[\"error_msg\"] = df[\"error\"]\n","            continue\n","        df[_col] = _default\n","print(f\"Before re-evaluation: {len(df)} rows, {int(pd.to_numeric(df['correct'], errors='coerce').fillna(0).sum())} correct\", flush=True)\n","\n","# ── Phase 1: Re-evaluate all rows ──\n","# Cache gold-SQL execution per q_id (only ~150 unique vs 552+ rows).\n","_gold_cache: dict[str, tuple] = {}\n","def _gold_for(q_id: str, gold_sql: str):\n","    if q_id not in _gold_cache:\n","        _gold_cache[q_id] = _run_sql(DB_PATH, gold_sql)\n","    return _gold_cache[q_id]\n","\n","reeval = []\n","_t_start = time.time()\n","_PROGRESS_EVERY = 25\n","\n","for idx, row in df.iterrows():\n","    gen_sql = str(row.get(\"generated_sql\", \"\")).strip()\n","    gold_sql = str(row.get(\"gold_sql\", \"\")).strip()\n","    err_msg = \"\"\n","    correct = False\n","\n","    # Re-extract SQL (in case raw reply was stored instead of extracted).\n","    if \"<think>\" in gen_sql or \"```\" in gen_sql or not gen_sql.lower().lstrip().startswith((\"select\", \"with\")):\n","        gen_sql = _extract_sql(gen_sql)\n","\n","    g_rows, g_err = _gold_for(str(row[\"q_id\"]), gold_sql)\n","    if g_err:\n","        err_msg = f\"gold-error: {g_err}\"\n","    elif not gen_sql:\n","        err_msg = \"empty SQL\"\n","    else:\n","        gen_rows, sql_err = _run_sql(DB_PATH, gen_sql, timeout_s=1.0)\n","        if sql_err:\n","            err_msg = sql_err\n","        else:\n","            correct = _rows_equal(gen_rows, g_rows)\n","\n","    reeval.append({\n","        \"q_id\": row[\"q_id\"], \"tier\": row[\"tier\"], \"domain\": row[\"domain\"],\n","        \"model\": row[\"model\"], \"question\": row[\"question\"],\n","        \"gold_sql\": gold_sql, \"generated_sql\": gen_sql,\n","        \"correct\": int(correct), \"error_msg\": err_msg,\n","        \"latency_s\": row[\"latency_s\"]\n","    })\n","\n","    _i = idx + 1 if isinstance(idx, int) else len(reeval)\n","    if _i % _PROGRESS_EVERY == 0 or _i == len(df):\n","        _elapsed = time.time() - _t_start\n","        _ok = sum(r[\"correct\"] for r in reeval)\n","        print(f\"  re-eval {_i}/{len(df)}  ✓={_ok}  elapsed={_elapsed:.1f}s\", flush=True)\n","        sys.stdout.flush()\n","\n","df2 = pd.DataFrame(reeval)\n","if df2.empty:\n","    print(\"No rows to re-evaluate (empty results CSV).\")\n","    c_new = e_new = w_new = 0\n","else:\n","    c_new = int(df2['correct'].sum())\n","    e_new = len(df2[df2['error_msg'].notna() & (df2['error_msg']!='')])\n","    w_new = len(df2) - c_new - e_new\n","print(f\"\\nAfter re-evaluation: ✓={c_new}  ✗={w_new}  E={e_new}\")\n","print(f\"  Gained {c_new - int(df['correct'].sum())} correct answers from re-evaluation alone!\")\n","\n","if not df2.empty:\n","    print(\"\\nRe-evaluated accuracy by model:\")\n","    for m in sorted(df2['model'].dropna().unique()):\n","        s = df2[df2['model']==m]; cc = int(s['correct'].sum())\n","        print(f\"  {m:<45} {cc}/{len(s)} = {cc/len(s)*100:.1f}%\")\n","\n","if not RERUN_FAILED_VIA_API:\n","    # ── Phase 1 only: save re-scored results, skip all API calls ──\n","    df_final = df2.copy()\n","    df_final.to_csv(RESULTS_CSV, index=False)\n","    mirror_save(\"all_experiment_results.csv\")\n","    if df_final.empty:\n","        print(f\"\\n{'='*60}\")\n","        print(\"FINAL: 0 rows — no benchmark results to summarise.\")\n","        df_results = df_final.copy()\n","    else:\n","        c_fin = int(df_final['correct'].sum())\n","        e_fin = len(df_final[df_final['error_msg'].notna() & (df_final['error_msg']!='')])\n","        w_fin = len(df_final) - c_fin - e_fin\n","        print(f\"\\n{'='*60}\")\n","        print(f\"FINAL (re-score only, no API): {len(df_final)} rows  \"\n","              f\"✓={c_fin}({c_fin/len(df_final)*100:.1f}%)  \"\n","              f\"✗={w_fin}({w_fin/len(df_final)*100:.1f}%)  \"\n","              f\"E={e_fin}({e_fin/len(df_final)*100:.1f}%)\")\n","        print(f\"\\nAccuracy by model:\")\n","        for m in sorted(df_final['model'].dropna().unique()):\n","            s = df_final[df_final['model']==m]; cc = int(s['correct'].sum())\n","            ee = len(s[s['error_msg'].notna() & (s['error_msg']!='')])\n","            print(f\"  {m:<45} {cc}✓  {len(s)-cc-ee}✗  {ee}E  ({cc/len(s)*100:.1f}%)\")\n","        df_results = df_final.copy()\n","        df_results[\"correct\"] = df_results[\"correct\"].astype(int)\n","    print(f\"\\n⚡ Re-scored in {time.time() - _t_start:.1f}s (RERUN_FAILED_VIA_API=False)\")\n","\n","else:\n","    # ── Phase 2: Identify rows to strip & re-run ──\n","    if df2.empty:\n","        strip_mask = pd.Series([], dtype=bool)\n","        to_rerun = []\n","        df_keep = df2.copy()\n","    else:\n","        strip_mask = (df2['error_msg'].notna()) & (df2['error_msg']!='') & (~df2['error_msg'].str.startswith('gold-error'))\n","        to_rerun = df2[strip_mask][['q_id','model']].values.tolist()\n","    print(f\"\\nRows to strip and re-run via API: {len(to_rerun)}\")\n","\n","    # Interleave models so we don't hit rate limits on the same model consecutively\n","    _by_model: dict[str, list] = {}\n","    for q_id, model in to_rerun:\n","        _by_model.setdefault(model, []).append((q_id, model))\n","    to_rerun = []\n","    while any(_by_model.values()):\n","        for m in list(_by_model):\n","            if _by_model[m]:\n","                to_rerun.append(_by_model[m].pop(0))\n","            else:\n","                del _by_model[m]\n","    print(f\"  Re-run order interleaved across {len(set(r[1] for r in to_rerun))} models\")\n","\n","    # Keep the good rows (df_keep already set in empty branch)\n","    if not df2.empty:\n","        df_keep = df2[~strip_mask].copy()\n","\n","    # ── Phase 3: Re-run failed rows via API ──\n","    if to_rerun:\n","        print(f\"\\nRe-running {len(to_rerun)} failed (q_id, model) pairs...\")\n","        q_lookup = {q['id']: q for q in BENCHMARK_QUESTIONS}\n","        new_rows = []\n","        gold_cache_rerun = {}\n","\n","        for i, (q_id, model) in enumerate(to_rerun):\n","            q = q_lookup.get(q_id)\n","            if not q:\n","                print(f\"  ⚠ {q_id} not found in BENCHMARK_QUESTIONS, skipping\")\n","                continue\n","\n","            # Gold result (cached)\n","            if q_id not in gold_cache_rerun:\n","                g_rows, g_err = _run_sql(DB_PATH, q[\"sql\"])\n","                gold_cache_rerun[q_id] = g_err if g_err else g_rows\n","            gold = gold_cache_rerun[q_id]\n","\n","            t0 = time.time()\n","            gen_sql = \"\"\n","            err_msg = \"\"\n","            correct = False\n","            try:\n","                _ex = \"\".join(f\"Q: {ex['question']}\\nSQL: {ex['sql']}\\n\\n\" for ex in FEW_SHOT_EXAMPLE