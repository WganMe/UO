    "        f\"Q: {ex['question']}\\nSQL: {ex['sql']}\" for ex in FEW_SHOT_EXAMPLES\n",
    "    )\n",
    "\n",
    "    @kbench.task(\n",
    "        name=\"Urban Observatory NL-to-SQL\",\n",
    "        description=(\n",
    "            \"Evaluates LLM accuracy on natural-language-to-SQL translation \"\n",
    "            \"against a real-world IoT database (Newcastle Urban Observatory). \"\n",
    "            \"150 questions across 5 complexity tiers (T1-T5).\"\n",
    "        ),\n",
    "    )\n",
    "    def nl_to_sql_task(\n",
    "        llm, question: str, gold_sql: str, q_id: str, tier: str\n",
    "    ) -> bool:\n",
    "        \"\"\"Return True if the LLM-generated SQL produces the same results as gold.\"\"\"\n",
    "        prompt = FEW_SHOT_PROMPT.format(\n",
    "            schema=SCHEMA_DDL, examples=_kb_ex_text, question=question\n",
    "        )\n",
    "        with kbench.chats.new(f\"q_{q_id}\"):\n",
    "            response = llm.prompt(prompt, extra_api_params={\"max_completion_tokens\": 512})\n",
    "        gen_sql = _extract_sql(response) or \"\"\n",
    "        if not gen_sql:\n",
    "            return False\n",
    "        gold_rows, gold_err = _run_sql(DB_PATH, gold_sql)\n",
    "        if gold_err:\n",
    "            return False\n",
    "        gen_rows, sql_err = _run_sql(DB_PATH, gen_sql)\n",
    "        if sql_err:\n",
    "            return False\n",
    "        return _rows_equal(gen_rows, gold_rows)\n",
    "\n",
    "    # Build evaluation DataFrame from BENCHMARK_QUESTIONS\n",
    "    _kb_eval_df = _kb_pd.DataFrame([\n",
    "        {\n",
    "            \"question\": q[\"question\"],\n",
    "            \"gold_sql\": q[\"sql\"],\n",
    "            \"q_id\":     q[\"id\"],\n",
    "            \"tier\":     q[\"tier\"],\n",
    "        }\n",
    "        for q in BENCHMARK_QUESTIONS\n",
    "    ])\n",
    "\n",
    "    print(f\"  kbench task registered: 'Urban Observatory NL-to-SQL' \"\n",
    "          f\"({len(_kb_eval_df)} questions)\")\n",
    "\n",
    "    # Run evaluation with the Kaggle Model Proxy LLM\n",
    "    try:\n",
    "        _kb_runs = nl_to_sql_task.evaluate(\n",
    "            llm=[kbench.llm],\n",
    "            evaluation_data=_kb_eval_df,\n",
    "        )\n",
    "    except Exception as _kb_eval_err:\n",
    "        # Quota exhaustion (403) + joblib bug crashes evaluate() and\n",
