    "\n",
    "    _ex_text = \"\".join(f\"Q: {ex['question']}\\nSQL: {ex['sql']}\\n\\n\" for ex in FEW_SHOT_EXAMPLES)\n",
    "    def _build_prompt(q):\n",
    "        return FEW_SHOT_PROMPT.format(schema=SCHEMA_DDL, examples=_ex_text.strip(), question=q)\n",
    "\n",
    "    _i = 0\n",
