   "source": [
    "# pyright: reportUnknownMemberType=false, reportUnknownVariableType=false, reportUnknownArgumentType=false, reportMissingTypeStubs=false, reportIndexIssue=false, reportUnknownParameterType=false, reportAttributeAccessIssue=false, reportCallIssue=false, reportOperatorIssue=false, reportConstantRedefinition=false, reportPossiblyUnboundVariable=false, reportMissingImports=false, reportUnnecessaryIsInstance=false, reportPrivateImportUsage=false, reportMissingParameterType=false, reportUnusedImport=false, reportArgumentType=false, reportMissingTypeArgument=false, reportUndefinedVariable=false, reportGeneralTypeIssues=false, reportOptionalMemberAccess=false, reportOptionalSubscript=false, reportOptionalIterable=false, reportOptionalCall=false, reportReturnType=false, reportAssignmentType=false, reportOptionalOperand=false, reportUnnecessaryComparison=false, reportUnusedFunction=false, reportUnusedVariable=false, reportUnboundVariable=false, reportUnknownLambdaType=false, reportUnusedClass=false\n",
    "# ── LOCAL inference via Ollama (Kaggle P100 16 GB VRAM, 19.5 GB working disk) ──\n",
    "# Adds a curated panel of small Q4-quantized instruct models that run on-GPU\n",
    "# with no API rate limits. Ollama's OpenAI-compatible /v1/chat/completions\n",
    "# endpoint slots into the same chat() interface used by GitHub Models /\n",
    "# kbench. Smart-fail mirrors the API path: any failure cools the model\n",
    "# and the benchmark loop rotates to a different one.\n",
    "import os, time, shutil, subprocess, requests\n",
    "from pathlib import Path\n",
    "\n",
    "# ── Aggressive cleanup of any committed remnants from previous runs ──\n",
    "# A buggy earlier version pulled 13 GB of model blobs into /kaggle/working\n",
    "# and they got persisted to the kernel's output, blowing the 19.5 GB quota.\n",
    "# Nuke everything model-related under /kaggle/working before doing anything;\n",
    "# blobs will live exclusively under /kaggle/temp from now on (session scratch,\n",
    "# NOT persisted, ~70 GB available).\n",
    "def _human(n: int) -> str:\n",
    "    for u in (\"B\",\"KB\",\"MB\",\"GB\",\"TB\"):\n",
    "        if n < 1024: return f\"{n:.1f}{u}\"\n",
    "        n /= 1024\n",
    "    return f\"{n:.1f}PB\"\n",
    "\n",
    "def _du(path: str) -> int:\n",
    "    total = 0\n",
    "    try:\n",
    "        for root, _, files in os.walk(path):\n",
    "            for f in files:\n",
    "                fp = os.path.join(root, f)\n",
    "                if os.path.exists(fp): total += os.path.getsize(fp)\n",
    "    except Exception:\n",
    "        pass\n",
    "    return total\n",
    "\n",
    "# Every run starts from a clean slate so the notebook is fully reproducible\n",
    "# for anyone who clones it: no leftover state, no surprise resumes.\n",
    "# Step 1: stop any ollama daemon left over from a prior run (blobs can't be\n",
    "#         removed while mmap'd).\n",
    "# Step 2: wipe BOTH possible blob locations and the JupyterLab scratch dir.\n",
    "# Step 3: report disk state so the rest of the cell has accurate numbers.\n",
    "print(\"  fresh-start cleanup (every run begins from a clean slate) …\")\n",
    "subprocess.run([\"pkill\", \"-f\", \"ollama serve\"], timeout=10, capture_output=True)\n",
    "time.sleep(1)\n",
    "for victim in (\"/kaggle/working/.ollama\",\n",
    "               \"/kaggle/working/ollama\",\n",
    "               \"/kaggle/working/.virtual_documents\",\n",
    "               \"/kaggle/temp/.ollama\"):\n",
    "    if os.path.isdir(victim):\n",
    "        sz = _du(victim)\n",
    "        print(f\"  cleanup: removing {victim} ({_human(sz)})\")\n",
    "        shutil.rmtree(victim, ignore_errors=True)\n",
    "\n",
    "for label, path in ((\"/kaggle/working\", \"/kaggle/working\"),\n",
    "                    (\"/kaggle/temp   \", \"/kaggle/temp\")):\n",
    "    if os.path.isdir(path):\n",
    "        st = os.statvfs(path)\n",
    "        print(f\"  {label} free: {st.f_bavail*st.f_frsize/(1<<30):.1f} GB\")\n",
    "\n",
    "# Confirm research artifacts are preserved (cleanup ONLY targets re-pullable\n",
    "# binaries: .ollama / .virtual_documents — never data_export/).\n",
    "_DE = \"/kaggle/working/data_export\"\n",
    "if os.path.isdir(_DE):\n",
    "    _files = sorted(os.listdir(_DE))\n",
    "    _total = _du(_DE)\n",
    "    print(f\"  PRESERVED: {_DE}/ ({_human(_total)}, {len(_files)} entries)\")\n",
    "    for _f in _files[:10]:\n",
    "        _p = os.path.join(_DE, _f)\n",
    "        _sz = _du(_p) if os.path.isdir(_p) else os.path.getsize(_p)\n",
    "        _kind = \"dir\" if os.path.isdir(_p) else \"file\"\n",
    "        print(f\"    - {_f:<40} {_kind:<5} {_human(_sz):>8}\")\n",
    "    if len(_files) > 10:\n",
    "        print(f\"    … and {len(_files)-10} more\")\n",
    "else:\n",
    "    print(f\"  data_export/ not present — first run on this kernel session\")\n",
    "\n",
    "OLLAMA_HOST = os.environ.get(\"OLLAMA_HOST\", \"http://127.0.0.1:11434\")\n",
    "OLLAMA_API_URL = f\"{OLLAMA_HOST}/v1/chat/completions\"\n",
    "\n",
    "# Curated panel — total ~17 GB on disk, fits 19.5 GB working budget.\n",
    "# Ollama swaps which model sits in VRAM (~5 GB peak) on demand.\n",
    "# Curated 3-model panel — total ~9.4 GB on disk (fits /kaggle/temp easily).\n",
    "# Single GPU-resident NL→SQL baseline:\n",
    "#   * Qwen 2.5 Coder 14B Q4 (~8.7 GB) — the strongest open SQL model that\n",
    "#     fits comfortably on a 16 GB P100 alongside the KV cache.\n",
    "# (Earlier panel had llama3.2:3b + qwen2.5-coder:7b + llama3.1:8b. The 8B\n",
    "# crashed with CUDA OOM/cgo when co-resident; the smaller two duplicated each\n",
    "# other and were ~2-3x slower than comparable API calls. One strong local\n",
    "# model is the cleanest reproducible baseline.)\n",
    "OLLAMA_MODELS_TO_PULL = [\n",
    "    \"qwen2.5-coder:14b\",\n",
    "]\n",
    "\n",
    "def _ollama_reachable() -> bool:\n",
    "    try:\n",
    "        r = requests.get(f\"{OLLAMA_HOST}/api/tags\", timeout=2)\n",
    "        return r.status_code == 200\n",
    "    except Exception:\n",
    "        return False\n",
    "\n",
    "# Three-tier install ladder, in order of reliability on Kaggle:\n",
    "#   1) `curl ... | sh` (canonical install.sh) — works in 99% of Kaggle kernels\n",
    "#      because they have sudo + outbound internet. Stream stdout/stderr live.\n",
    "#   2) Pre-staged tarball at /kaggle/input/<dataset>/ollama-linux-amd64.tgz\n",
    "#      (attach a dataset containing the binary if option 1 is blocked).\n",
    "#   3) Direct tarball download via python-requests with mirror fallback.\n",
    "import tarfile\n",
    "OLLAMA_VERSION = os.environ.get(\"OLLAMA_VERSION\", \"v0.5.4\")\n",
    "# Both the binary AND the model blobs live under /kaggle/temp (session scratch,\n",
    "# ~70 GB available, NOT persisted to the kernel output). Nothing ollama-related\n",
    "# touches /kaggle/working — that quota is reserved for results, figures, and DB.\n",
    "import os as _os\n",
    "# Ensure /kaggle/temp exists so Ollama blobs (~9 GB) are NOT persisted\n",
    "# to kernel output. /kaggle/working quota is reserved for results only.\n",
    "if not _os.path.isdir(\"/kaggle/temp\"):\n",
    "    _os.makedirs(\"/kaggle/temp\", exist_ok=True)\n",
    "_OLLAMA_BASE = \"/kaggle/temp\"\n",
    "OLLAMA_HOME = Path(f\"{_OLLAMA_BASE}/.ollama\")\n",
    "_OLLAMA_BLOB_ROOT = str(OLLAMA_HOME)\n",
    "OLLAMA_BIN_DIR = OLLAMA_HOME / \"bin\"\n",
    "OLLAMA_BIN = OLLAMA_BIN_DIR / \"ollama\"\n",
    "\n",
    "def _try_install_sh() -> str | None:\n",
    "    \"\"\"Method 1: official install.sh. Returns binary path or None.\n",
    "    Also attempts to install zstd first (newer ollama tarballs require it).\"\"\"\n",
    "    # Best-effort: install zstd + pciutils (lspci) if missing. Non-fatal.\n",
    "    # pciutils is REQUIRED for the install.sh script to detect the GPU and\n",
    "    # pull the CUDA build of ollama (otherwise it silently falls back to\n",
    "    # CPU-only, which is ~10x slower for 8B models).\n",
    "    _need = [p for p in (\"zstd\", \"lspci\") if shutil.which(p) is None]\n",
    "    if _need:\n",
    "        _pkgs = \"zstd pciutils\"\n",
    "        print(f\"  installing {_pkgs} (zstd: extract, pciutils: GPU detection) …\", flush=True)\n",
    "        subprocess.run(\n",
    "            [\"apt-get\", \"-y\", \"install\"] + _pkgs.split(),\n",
    "            timeout=180, capture_output=True,\n",
    "        )\n",
    "    print(\"  [method 1] curl https://ollama.com/install.sh → /tmp/ollama_install.sh\", flush=True)\n",
    "    try:\n",
    "        _dl = subprocess.run(\n",
    "            [\"curl\", \"-fsSL\", \"-o\", \"/tmp/ollama_install.sh\", \"https://ollama.com/install.sh\"],\n",
    "            timeout=120, capture_output=True, text=True,\n",
    "        )\n",
    "        if _dl.returncode != 0:\n",
    "            print(f\"    → download failed (exit {_dl.returncode})\")\n",
    "            return None\n",
    "        import os as _ios\n",
    "        _ios.chmod(\"/tmp/ollama_install.sh\", 0o755)\n",
    "        proc = subprocess.run(\n",
    "            [\"sh\", \"/tmp/ollama_install.sh\"],\n",
    "            timeout=600,\n",
    "            stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True,\n",
    "        )\n",
    "        # Echo the FULL output so we can diagnose any failure\n",
    "        for line in (proc.stdout or \"\").splitlines()[-25:]:\n",
    "            print(f\"    | {line}\")\n",
    "        if proc.returncode == 0 and shutil.which(\"ollama\"):\n",
    "            return shutil.which(\"ollama\")\n",
    "        print(f\"    → exit {proc.returncode}; binary not on PATH\")\n",
    "    except Exception as exc:\n",
    "        print(f\"    → exception: {exc!r}\")\n",
    "    return None\n",
    "\n",
    "def _try_prestaged_tarball() -> str | None:\n",
    "    \"\"\"Method 2: tarball pre-staged in /kaggle/input/.\"\"\"\n",
    "    if not Path(\"/kaggle/input\").exists():\n",
    "        return None\n",
    "    candidates = list(Path(\"/kaggle/input\").rglob(\"ollama-linux-amd64.tgz\"))\n",
    "    if not candidates:\n",
    "        return None\n",
    "    tgz = candidates[0]\n",
    "    print(f\"  [method 2] using pre-staged tarball: {tgz}\", flush=True)\n",
    "    try:\n",
    "        OLLAMA_BIN_DIR.mkdir(parents=True, exist_ok=True)\n",
    "        with tarfile.open(tgz, \"r:gz\") as tf:\n",
    "            tf.extractall(OLLAMA_HOME, filter=\"data\")\n",
    "        if not OLLAMA_BIN.exists():\n",
    "            alt = OLLAMA_HOME / \"ollama\"\n",
    "            if alt.exists():\n",
    "                alt.rename(OLLAMA_BIN)\n",
    "        if OLLAMA_BIN.exists():\n",
    "            OLLAMA_BIN.chmod(0o755)\n",
    "            return str(OLLAMA_BIN)\n",
    "    except Exception as exc:\n",
    "        print(f\"    extract failed: {exc!r}\")\n",
    "    return None\n",
    "\n",
    "def _try_requests_download() -> str | None:\n",
    "    \"\"\"Method 3: download via python-requests with mirror fallback.\"\"\"\n",
    "    urls = [\n",
    "        f\"https://github.com/ollama/ollama/releases/download/{OLLAMA_VERSION}/ollama-linux-amd64.tgz\",\n",
    "        \"https://ollama.com/download/ollama-linux-amd64.tgz\",\n",
    "    ]\n",
    "    OLLAMA_BIN_DIR.mkdir(parents=True, exist_ok=True)\n",
    "    tgz = OLLAMA_HOME / \"ollama-linux-amd64.tgz\"\n",
    "    for url in urls:\n",
    "        print(f\"  [method 3] requests.get {url}\", flush=True)\n",
    "        try:\n",
    "            with requests.get(url, stream=True, timeout=600, allow_redirects=True) as r:\n",
    "                if r.status_code != 200:\n",
    "                    print(f\"    → HTTP {r.status_code}\")\n",
    "                    continue\n",
    "                with open(tgz, \"wb\") as fh:\n",
    "                    for chunk in r.iter_content(1 << 20):\n",
    "                        fh.write(chunk)\n",
    "            print(f\"    → {tgz.stat().st_size/1e6:.0f} MB downloaded\")\n",
    "            with tarfile.open(tgz, \"r:gz\") as tf:\n",
    "                tf.extractall(OLLAMA_HOME)\n",
    "            tgz.unlink(missing_ok=True)\n",
    "            if not OLLAMA_BIN.exists():\n",
    "                alt = OLLAMA_HOME / \"ollama\"\n",
    "                if alt.exists():\n",
    "                    alt.rename(OLLAMA_BIN)\n",
    "            if OLLAMA_BIN.exists():\n",
    "                OLLAMA_BIN.chmod(0o755)\n",
    "                return str(OLLAMA_BIN)\n",
    "        except Exception as exc:\n",
    "            print(f\"    → {exc!r}\")\n",
    "    return None\n",
    "\n",
    "def _ollama_install_and_serve() -> bool:\n",
    "    \"\"\"Install ollama and start `ollama serve` as a background daemon.\n",
    "\n",
    "    Tries three install methods in order. Each method's output is streamed\n",
    "    so any failure is fully diagnosable in the kernel log.\n",
    "    \"\"\"\n",
    "    if _ollama_reachable():\n",
    "        print(\"  Ollama already running.\")\n",
    "        return True\n",
    "    bin_path = shutil.which(\"ollama\") or (str(OLLAMA_BIN) if OLLAMA_BIN.exists() else None)\n",
    "    if bin_path is None:\n",
    "        for method in (_try_install_sh, _try_prestaged_tarball, _try_requests_download):\n",
    "            bin_path = method()\n",
    "            if bin_path:\n",
    "                print(f\"  ollama installed: {bin_path}\")\n",
    "                break\n",
    "        if bin_path is None:\n",
    "            print(\"  All three install methods failed. Falling back to API-only panel.\")\n",
    "            print(\"  Workaround: upload ollama-linux-amd64.tgz as a Kaggle Dataset\")\n",
    "            print(\"  and attach it; method 2 will pick it up from /kaggle/input/.\")\n",
    "            return False\n",
    "    print(f\"  Starting `{bin_path} serve` ...\")\n",
    "    env = os.environ.copy()\n",
    "    env[\"OLLAMA_MODELS\"] = f\"{_OLLAMA_BLOB_ROOT}/models\"\n",
    "    env[\"OLLAMA_HOST\"] = \"127.0.0.1:11434\"\n",
    "    Path(env[\"OLLAMA_MODELS\"]).mkdir(parents=True, exist_ok=True)\n",
    "    # Make sure ollama can find its bundled libs (CUDA shims) under lib/\n",
    "    lib_dir = OLLAMA_HOME / \"lib\" / \"ollama\"\n",
    "    if lib_dir.exists():\n",
    "        env[\"LD_LIBRARY_PATH\"] = f\"{lib_dir}:{env.get('LD_LIBRARY_PATH', '')}\"\n",
    "    Path(env[\"OLLAMA_MODELS\"]).mkdir(parents=True, exist_ok=True)\n",
    "    log_fh = open(\"/tmp/ollama.log\", \"w\")\n",
    "    try:\n",
    "        subprocess.Popen(\n",
    "            [bin_path, \"serve\"], env=env,\n",
    "            stdout=log_fh, stderr=log_fh,\n",
    "            start_new_session=True,\n",
    "        )\n",
    "    except Exception as exc:\n",
    "        log_fh.close()\n",
    "        print(f\"  failed to spawn ollama serve: {exc!r}\")\n",
    "        return False\n",
    "    for _ in range(60):\n",
    "        if _ollama_reachable():\n",
    "            print(\"  ollama daemon up.\")\n",
    "            _maybe_start_ngrok()\n",
    "            return True\n",
    "        time.sleep(1)\n",
    "    log_fh.close()\n",
    "    print(\"  ollama daemon did not start within 60s. /tmp/ollama.log tail:\")\n",
    "    try:\n",
    "        print(\"    \" + Path(\"/tmp/ollama.log\").read_text()[-1200:].replace(chr(10), chr(10) + \"    \"))\n",
    "    except Exception:\n",
    "        pass\n",
    "    return False\n",
    "\n",
    "def _maybe_start_ngrok() -> None:\n",
    "    \"\"\"Optionally expose the local ollama daemon via an ngrok tunnel.\n",
    "\n",
    "    Reads NGROK_AUTHTOKEN from env/Kaggle Secrets. Non-blocking — if pyngrok\n",
    "    is missing, the token is unset, or the tunnel fails, we just print a\n",
    "    notice and continue. The benchmark itself always uses 127.0.0.1:11434\n",
    "    so the tunnel is purely for external monitoring (e.g. hitting it from\n",
    "    your laptop while the kernel runs).\"\"\"\n",
    "    tok = os.environ.get(\"NGROK_AUTHTOKEN\") or os.environ.get(\"NGROK_AUTH_TOKEN\")\n",
    "    if not tok:\n",
    "        return  # not requested\n",
    "    try:\n",
    "        from pyngrok import ngrok, conf  # type: ignore[import-not-found]\n",
    "    except ImportError:\n",
    "        try:\n",
    "            subprocess.run([\n",
    "                \"pip\", \"install\", \"--quiet\", \"pyngrok\"\n",
    "            ], check=True, timeout=120)\n",
    "            from pyngrok import ngrok, conf  # type: ignore[import-not-found]\n",
    "        except Exception as exc:\n",
    "            print(f\"  ngrok skipped (pyngrok install failed): {exc}\")\n",
    "            return\n",
    "    try:\n",
    "        conf.get_default().auth_token = tok\n",
    "        # Disconnect any leftover tunnels from a previous run\n",
    "        for t in ngrok.get_tunnels():\n",
    "            try: ngrok.disconnect(t.public_url)\n",
    "            except Exception: pass\n",
    "        tunnel = ngrok.connect(11434, \"http\",\n",
    "                               host_header=\"localhost:11434\")\n",
    "        print(f\"  ngrok tunnel → {tunnel.public_url}  \"\n",
    "              f\"(call from outside: curl {tunnel.public_url}/api/tags)\")\n",
    "    except Exception as exc:\n",
    "        print(f\"  ngrok tunnel failed: {exc}\")\n",
    "\n",
    "def _disk_free_gb(path: str) -> float:\n",
    "    try:\n",
    "        st = _os.statvfs(path)\n",
    "        return st.f_bavail * st.f_frsize / (1 << 30)\n",
    "    except Exception:\n",
    "        return 0.0\n",
    "\n",
    "def _ollama_pull(model: str, timeout: int = 1200, min_free_gb: float = 6.0) -> bool:\n",
    "    \"\"\"Pull a model if not present; idempotent. Aborts if disk is tight.\"\"\"\n",
    "    try:\n",
    "        r = requests.get(f\"{OLLAMA_HOST}/api/tags\", timeout=5)\n",
    "        existing = {t[\"name\"] for t in r.json().get(\"models\", [])}\n",
    "        if model in existing:\n",
    "            print(f\"    [OK] {model} already cached\")\n",
    "            return True\n",
    "    except Exception:\n",
    "        pass\n",
    "    free = _disk_free_gb(_OLLAMA_BLOB_ROOT)\n",
    "    if free < min_free_gb:\n",
    "        print(f\"    [SKIP] {model} — only {free:.1f} GB free at {_OLLAMA_BLOB_ROOT} \"\n",
    "              f\"(need ≥{min_free_gb:.0f} GB headroom)\")\n",
    "        return False\n",
    "    print(f\"    pulling {model} ...  ({free:.1f} GB free)\", flush=True)\n",
    "    t0 = time.time()\n",
    "    try:\n",
    "        r = requests.post(\n",
    "            f\"{OLLAMA_HOST}/api/pull\",\n",
    "            json={\"model\": model, \"stream\": False},\n",
    "            timeout=timeout,\n",
    "        )\n",
    "        if r.status_code == 200:\n",
    "            print(f\"    [OK] {model} pulled in {time.time()-t0:.0f}s\", flush=True)\n",
    "            return True\n",
    "        print(f\"    [FAIL] {model} HTTP {r.status_code}: {r.text[:120]}\")\n",
    "        return False\n",
    "    except Exception as exc:\n",
    "        print(f\"    [FAIL] {model} pull failed: {exc}\")\n",
    "        return False\n",
    "\n",
    "# ── Smart-fail registry (parallels _OR_COOLDOWN / _GH_COOLDOWN) ──\n",
    "_OLLAMA_COOLDOWN: dict[str, float] = {}\n",
    "_OLLAMA_DEFAULT_COOLDOWN = 60.0\n",
    "_OLLAMA_HARD_COOLDOWN = 24 * 3600.0\n",
    "\n",
    "def _ollama_available(model: str) -> bool:\n",
    "    return _OLLAMA_COOLDOWN.get(f\"ollama/{model}\", 0.0) <= time.time()\n",
    "\n",
    "def _ollama_cool(model: str, secs: float, reason: str) -> None:\n",
    "    full = f\"ollama/{model}\"\n",
    "    _OLLAMA_COOLDOWN[full] = time.time() + max(secs, _OLLAMA_DEFAULT_COOLDOWN)\n",
    "    print(f\"  ✗ Ollama cooldown ({full}) ~{secs:.0f}s — {reason}\")\n",
    "\n",
    "class OllamaModelCooled(ModelCooled):\n",
    "    \"\"\"Local Ollama model is unusable (process died, OOM, missing model, etc.).\"\"\"\n",
    "    pass\n",
    "\n",
    "def _try_ollama(messages: list[dict], model: str, max_tokens: int, temperature: float) -> str:\n",
    "    \"\"\"Call ollama OpenAI-compatible chat endpoint. Smart-fail on any error.\"\"\"\n",
    "    full = f\"ollama/{model}\"\n",
    "    if full in _OLLAMA_COOLDOWN and _OLLAMA_COOLDOWN[full] > time.time():\n",
    "        raise OllamaModelCooled(full, _OLLAMA_COOLDOWN[full], \"still cooled\")\n",
    "    payload = {\n",
    "        \"model\": model,\n",
    "        \"messages\": messages,\n",
    "        \"max_tokens\": max_tokens,\n",
    "        \"temperature\": temperature,\n",
    "    }\n",
    "    try:\n",
    "        r = requests.post(OLLAMA_API_URL, json=payload, timeout=300)\n",
    "    except Exception as exc:\n",
    "        _ollama_cool(model, _OLLAMA_HARD_COOLDOWN, f\"network: {exc}\")\n",
    "        raise OllamaModelCooled(full, _OLLAMA_COOLDOWN[full], str(exc))\n",
    "    if r.status_code == 200:\n",
    "        try:\n",
    "            data = r.json()\n",
    "            content = data[\"choices\"][0][\"message\"].get(\"content\")\n",
    "            if isinstance(content, str) and content.strip():\n",
    "                return content\n",
    "        except Exception:\n",
    "            pass\n",
    "        _ollama_cool(model, _OLLAMA_DEFAULT_COOLDOWN, \"empty/invalid JSON\")\n",
    "        raise OllamaModelCooled(full, _OLLAMA_COOLDOWN[full], \"empty content\")\n",
    "    if r.status_code in (404, 400):\n",
    "        # Model id unknown — cool hard so we don't keep probing.\n",
    "        _ollama_cool(model, _OLLAMA_HARD_COOLDOWN,\n",
    "                     f\"HTTP {r.status_code}: {r.text[:120]}\")\n",
    "        raise OllamaModelCooled(full, _OLLAMA_COOLDOWN[full],\n",
    "                                f\"HTTP {r.status_code}\")\n",
    "    _ollama_cool(model, _OLLAMA_DEFAULT_COOLDOWN,\n",
    "                 f\"HTTP {r.status_code}: {r.text[:120]}\")\n",
    "    raise OllamaModelCooled(full, _OLLAMA_COOLDOWN[full],\n",
    "                            f\"HTTP {r.status_code}\")\n",
    "\n",
    "# ── Bootstrap: install / serve / pull, then add to MODEL_PANEL ──\n",
    "OLLAMA_MODELS: list[str] = []\n",
    "if _ollama_install_and_serve():\n",
    "    print(f\"  Disk: {_disk_free_gb(_OLLAMA_BLOB_ROOT):.1f} GB free at {_OLLAMA_BLOB_ROOT}\")\n",
    "    print(f\"  Pulling {len(OLLAMA_MODELS_TO_PULL)} Q4 quantized models ...\")\n",
    "    for _m in OLLAMA_MODELS_TO_PULL:\n",
    "        if _ollama_pull(_m, timeout=1500):\n",
    "            OLLAMA_MODELS.append(f\"ollama/{_m}\")\n",
    "    print(f\"  Ollama panel ready: {len(OLLAMA_MODELS)} models\")\n",
    "    # Warmup: force model load into VRAM so the first benchmark call\n",
    "    # doesn't time out during cold start (~180s on P100 for 14B Q4).\n",
    "    if OLLAMA_MODELS:\n",
    "        _wm = OLLAMA_MODELS[0][len(\"ollama/\"):]\n",
    "        print(f\"  warmup: loading {_wm} into VRAM ...\", flush=True)\n",
    "        try:\n",
    "            _wr = requests.post(OLLAMA_API_URL,\n",
    "                json={\"model\": _wm,\n",
    "                      \"messages\": [{\"role\": \"user\", \"content\": \"SELECT 1\"}],\n",
    "                      \"max_tokens\": 8, \"temperature\": 0.0},\n",
    "                timeout=300)\n",
    "            if _wr.status_code == 200:\n",
    "                print(f\"  warmup OK ({_wm} loaded into VRAM)\")\n",
    "            else:\n",
    "                print(f\"  warmup HTTP {_wr.status_code}\")\n",
    "        except Exception as _we:\n",
    "            print(f\"  warmup timeout/failed: {_we}\")\n",
    "else:\n",
    "    print(\"  Skipping Ollama (install/serve failed) — using API panel only.\")\n",
    "\n",
    "# Prepend ollama models so the loop tries the FAST local path first;\n",
    "# API models become the fallback for harder questions where small local\n",
    "# models may struggle.\n",
    "if OLLAMA_MODELS:\n",
    "    MODEL_PANEL = list(OLLAMA_MODELS) + [m for m in MODEL_PANEL if m not in OLLAMA_MODELS]\n",
    "    print(f\"  MODEL_PANEL now {len(MODEL_PANEL)} models \"\n",
    "          f\"({len(OLLAMA_MODELS)} local + {len(MODEL_PANEL) - len(OLLAMA_MODELS)} API)\")\n",
    "\n",
    "# Quick smoke test against the first local model (if any)\n",
    "if OLLAMA_MODELS:\n",
    "    try:\n",
    "        _t = _try_ollama(\n",
    "            [{\"role\": \"user\", \"content\": \"Reply with exactly: PONG\"}],\n",
    "            OLLAMA_MODELS[0][len(\"ollama/\"):], max_tokens=10, temperature=0.0,\n",
    "        )\n",
    "        print(f\"  Ollama smoke test ({OLLAMA_MODELS[0]}) → {_t.strip()[:40]}\")\n",
    "    except Exception as _e:\n",
    "        print(f\"  Ollama smoke test failed: {_e}\")\n",
    "        MODEL_PANEL = [m for m in MODEL_PANEL if not m.startswith(\"ollama/\")]\n",
    "\n",
    "        OLLAMA_MODELS.clear()\n",
    "        print(f\"  ⛔ Removed Ollama models from MODEL_PANEL (server unreachable)\")"
   ]
