    "def _run_sql(db_path: str, sql: str, timeout_s: float = 30.0):\n",
    "    \"\"\"Execute SQL with VM-op + wall-time + row caps so a runaway query can't\n",
    "    crash the kernel.  Returns (rows | None, error_string | None).\n",
    "    *timeout_s* caps wall-clock time (default 30 s, use ≤5 for re-eval).\"\"\"\n",
