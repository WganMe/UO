    "# pyright: reportUnknownMemberType=false, reportUnknownVariableType=false, reportUnknownArgumentType=false, reportMissingTypeStubs=false, reportIndexIssue=false, reportUnknownParameterType=false, reportAttributeAccessIssue=false, reportCallIssue=false, reportOperatorIssue=false, reportConstantRedefinition=false, reportPossiblyUnboundVariable=false, reportMissingImports=false, reportUnnecessaryIsInstance=false, reportPrivateImportUsage=false, reportMissingParameterType=false, reportUnusedImport=false, reportArgumentType=false, reportMissingTypeArgument=false, reportUndefinedVariable=false, reportGeneralTypeIssues=false, reportOptionalMemberAccess=false, reportOptionalSubscript=false, reportOptionalIterable=false, reportOptionalCall=false, reportReturnType=false, reportAssignmentType=false, reportOptionalOperand=false, reportUnnecessaryComparison=false, reportUnusedFunction=false, reportUnusedVariable=false, reportUnboundVariable=false, reportUnknownLambdaType=false, reportUnusedClass=false\n",
    "%pip install sentence-transformers chromadb --quiet\n",
    "\n",
    "import os\n",
    "# HF_TOKEN may already be set by the Kaggle Secrets loader (cell 3) or .env.\n",
    "# Only try Colab userdata when actually on Colab (Kaggle ships google.colab too).\n",
    "if not os.environ.get(\"HF_TOKEN\") and globals().get(\"_IN_COLAB\"):\n",
    "    try:\n",
    "        from google.colab import userdata  # type: ignore[import-not-found]\n",
    "        _hf = userdata.get(\"HF_TOKEN\")\n",
    "        if _hf:\n",
    "            os.environ[\"HF_TOKEN\"] = _hf\n",
    "            print(\"HF_TOKEN loaded from Colab secrets\")\n",
    "    except Exception:\n",
    "        pass\n",
    "if not os.environ.get(\"HF_TOKEN\"):\n",
    "    try:\n",
    "        from dotenv import load_dotenv  # type: ignore[import-not-found]\n",
    "        load_dotenv(override=False)\n",
    "    except ImportError:\n",
    "        pass\n",
    "print(f\"HF_TOKEN: {'set' if os.environ.get('HF_TOKEN') else 'not set (public models still work)'}\")\n",
    "\n",
    "import numpy as np\n",
    "from sentence_transformers import SentenceTransformer\n",
    "\n",
    "# ── Embedding model ──────────────────────────────────────────\n",
    "EMBED_MODEL_NAME = \"all-MiniLM-L6-v2\"  # 384-dim, fast\n",
    "embed_model = SentenceTransformer(EMBED_MODEL_NAME)\n",
    "\n",
    "# ── Build vector store from schema chunks ────────────────────\n",
    "chunk_keys = list(SCHEMA_CHUNKS.keys())\n",
    "chunk_texts = list(SCHEMA_CHUNKS.values())\n",
    "chunk_embeddings = embed_model.encode(chunk_texts, normalize_embeddings=True)\n",
    "\n",
    "print(f\"Embedded {len(chunk_keys)} schema chunks with {EMBED_MODEL_NAME}\")\n",
    "print(f\"Embedding dim: {chunk_embeddings.shape[1]}\")\n",
    "\n",
    "# ── Retrieval functions ──────────────────────────────────────\n",
    "def retrieve_naive(question: str, top_k: int = 2) -> list[str]:\n",
    "    \"\"\"Naïve RAG: retrieve top-k schema chunks by cosine similarity.\"\"\"\n",
    "    q_emb = embed_model.encode([question], normalize_embeddings=True)\n",
    "    scores = np.dot(chunk_embeddings, q_emb.T).flatten()\n",
    "    top_indices = np.argsort(scores)[::-1][:top_k]\n",
    "    return [chunk_keys[i] for i in top_indices]\n",
    "\n",
    "def retrieve_enhanced(question: str) -> list[str]:\n",
    "    \"\"\"Enhanced RAG: naïve retrieval + theme detection + relationship expansion.\"\"\"\n",
    "    # Start with naïve top-2\n",
    "    retrieved = set(retrieve_naive(question, top_k=2))\n",
    "\n",
    "    q_lower = question.lower()\n",
    "\n",
    "    # Theme detection: if question mentions reading/measurement data, always include readings\n",
    "    measurement_keywords = [\"reading\", \"value\", \"average\", \"max\", \"min\", \"daily\",\n",
    "                            \"hourly\", \"no2\", \"pm2.5\", \"pm10\", \"o3\", \"temperature\",\n",
    "                            \"humidity\", \"traffic\", \"noise\", \"weather\", \"air quality\"]\n",
    "    if any(kw in q_lower for kw in measurement_keywords):\n",
    "        retrieved.add(\"readings\")\n",
    "\n",
    "    # Relationship expansion: if readings is included, always include sensors + variables\n",
    "    if \"readings\" in retrieved:\n",
    "        # For cross-variable queries (T5), include all tables\n",
    "        cross_keywords = [\"compare\", \"correlation\", \"cross\", \"both\", \"ratio\",\n",
    "                         \"vs\", \"versus\", \"and\", \"between\"]\n",
    "        if any(kw in q_lower for kw in cross_keywords):\n",
    "            retrieved.update([\"sensors\", \"variables\"])\n",
    "        # For join queries, include the joined table\n",
    "        if \"broker\" in q_lower or \"sensor\" in q_lower:\n",
    "            retrieved.add(\"sensors\")\n",
    "        if \"theme\" in q_lower or \"units\" in q_lower or \"variable\" in q_lower:\n",
    "            retrieved.add(\"variables\")\n",
    "\n",
    "    return list(retrieved)\n",
    "\n",
    "def build_rag_prompt(question: str, strategy: str = \"naive\") -> str:\n",
    "    \"\"\"Build RAG prompt with retrieved schema fragments.\"\"\"\n",
    "    if strategy == \"naive\":\n",
    "        retrieved_keys = retrieve_naive(question)\n",
    "    elif strategy == \"enhanced\":\n",
    "        retrieved_keys = retrieve_enhanced(question)\n",
    "    else:\n",
    "        raise ValueError(f\"Unknown RAG strategy: {strategy}\")\n",
    "\n",
    "    schema_fragments = \"\\\n",
    "\\\n",
    "\".join(SCHEMA_CHUNKS[k] for k in retrieved_keys)\n",
    "    return RAG_PROMPT.format(\n",
    "        schema_fragments=schema_fragments,\n",
    "        question=question\n",
    "    )\n",
    "\n",
    "# ── Test retrieval ───────────────────────────────────────────\n",
    "test_questions = [\n",
    "    \"List all sensor names\",                                       # should get sensors\n",
    "    \"What is the average NO2 per sensor?\",                        # should get readings + sensors\n",
    "    \"Compare NO2 and PM2.5 across brokers\",                       # should get all 3\n",
    "]\n",
    "\n",
    "print(\"\\\n",
    "Retrieval tests:\")\n",
    "for tq in test_questions:\n",
    "    naive = retrieve_naive(tq)\n",
    "    enhanced = retrieve_enhanced(tq)\n",
    "    print(f\"  Q: {tq}\")\n",
    "    print(f\"    Naïve:    {naive}\")\n",
    "    print(f\"    Enhanced: {enhanced}\")\n",
    "\n",
    "print(f\"\\\n",
    "RAG pipeline ready. Strategies: naive, enhanced\")"
