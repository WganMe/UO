    "# pyright: reportUnknownMemberType=false, reportUnknownVariableType=false, reportUnknownArgumentType=false, reportMissingTypeStubs=false, reportIndexIssue=false, reportUnknownParameterType=false, reportAttributeAccessIssue=false, reportCallIssue=false, reportOperatorIssue=false, reportConstantRedefinition=false, reportPossiblyUnboundVariable=false, reportMissingImports=false, reportUnnecessaryIsInstance=false, reportPrivateImportUsage=false, reportMissingParameterType=false, reportUnusedImport=false, reportArgumentType=false, reportMissingTypeArgument=false, reportUndefinedVariable=false, reportGeneralTypeIssues=false, reportOptionalMemberAccess=false, reportOptionalSubscript=false, reportOptionalIterable=false, reportOptionalCall=false, reportReturnType=false, reportAssignmentType=false, reportOptionalOperand=false, reportUnnecessaryComparison=false, reportUnusedFunction=false, reportUnusedVariable=false, reportUnboundVariable=false, reportUnknownLambdaType=false, reportUnusedClass=false\n",
    "_KAGGLE_USER_FALLBACK = \"wganme\"  # Kaggle username — change once here to fork\n",
    "\n",
    "# Environment auto-detection (Colab / Kaggle / local) and persistent paths.\n",
    "# - Colab : mount Google Drive; FAIL LOUDLY if /content/drive/MyDrive/... missing.\n",
    "# - Kaggle: read inputs from /kaggle/input/urban-observatory, write to /kaggle/working.\n",
    "# - Local : use repo root.\n",
    "import os\n",
    "from pathlib import Path\n",
    "\n",
    "_IN_KAGGLE = Path('/kaggle/input').exists() and Path('/kaggle/working').exists()\n",
    "\n",
    "# Detect Colab by the runtime marker file, NOT by import — Kaggle ships google.colab too.\n",
    "_IN_COLAB = (not _IN_KAGGLE) and Path('/var/colab/hostname').exists()\n",
    "if _IN_COLAB:\n",
    "    from google.colab import drive  # type: ignore[import-not-found]\n",
    "\n",
    "if _IN_COLAB:\n",
    "    drive.mount('/content/drive')\n",
    "    WORK_ROOT = Path('/content/drive/MyDrive/Colab Notebooks')\n",
    "    if not WORK_ROOT.exists():\n",
    "        raise RuntimeError(\n",
    "            f\"Drive mounted but {WORK_ROOT} not found.\\n\"\n",
    "            \"Refusing to save into the ephemeral /content runtime folder.\\n\"\n",
    "            \"Create the folder in Drive or correct WORK_ROOT before continuing.\"\n",
    "        )\n",
    "    print(f\"Colab + Drive: WORK_ROOT = {WORK_ROOT}\")\n",
    "elif _IN_KAGGLE:\n",
    "    WORK_ROOT = Path('/kaggle/working')\n",
    "    # Cleanup /kaggle/working/* on rerun so stale outputs don't pile up.\n",
    "    # Pattern borrowed from the sparksql.ipynb reference notebook.\n",
    "    import glob, shutil\n",
    "    for _f in glob.glob('/kaggle/working/*'):\n",
    "        try:\n",
    "            if os.path.isfile(_f) or os.path.islink(_f):\n",
    "                os.unlink(_f)\n",
    "            elif os.path.isdir(_f):\n",
    "                shutil.rmtree(_f)\n",
    "        except Exception as _e:\n",
    "            print(f\"  cleanup warn: {_f}: {_e}\")\n",
    "    # ── Resume seed: download the LATEST version of the rolling-results\n",
    "    #     dataset via the Kaggle API, so the benchmark loop picks up where\n",
    "    #     the previous session left off instead of starting from scratch.\n",
    "    #     Fallback: also scan /kaggle/input in case the dataset is attached\n",
    "    #     as a kernel input (mount is pinned to the version at session start).\n",
    "    _seeded = []\n",
    "    _RESULT_CSVS = [\"all_experiment_results.csv\", \"rag_experiment_results.csv\"]\n",
    "    _export_dir = WORK_ROOT / 'data_export'\n",
    "    _export_dir.mkdir(parents=True, exist_ok=True)\n",
    "    # ── Primary: fetch latest via API (always up-to-date) ────────────────\n",
    "    try:\n",
    "        import subprocess as _seed_subp, sys as _seed_sys, zipfile as _seed_zip, tempfile as _seed_tmp\n",
    "        # Ensure kaggle package is available\n",
    "        try:\n",
    "            from kaggle.api.kaggle_api_extended import KaggleApi as _SeedKaggleApi\n",
    "        except ModuleNotFoundError:\n",
    "            _seed_subp.run(\n",
    "                [_seed_sys.executable, \"-m\", \"pip\", \"install\", \"-q\", \"--upgrade\", \"kaggle\"],\n",
    "                capture_output=True, text=True, timeout=180,\n",
    "            )\n",
    "            for _k in [k for k in list(_seed_sys.modules) if k == \"kaggle\" or k.startswith(\"kaggle.\")]:\n",
    "                _seed_sys.modules.pop(_k, None)\n",
    "            from kaggle.api.kaggle_api_extended import KaggleApi as _SeedKaggleApi\n",
    "        # Bridge auth\n",
    "        if os.environ.get(\"KAGGLE_API_TOKEN\") and not os.environ.get(\"KAGGLE_KEY\"):\n",
    "            os.environ[\"KAGGLE_KEY\"] = os.environ[\"KAGGLE_API_TOKEN\"]\n",
    "        if not os.environ.get(\"KAGGLE_USERNAME\"):\n",
    "            os.environ[\"KAGGLE_USERNAME\"] = _KAGGLE_USER_FALLBACK\n",
    "        _api = _SeedKaggleApi(); _api.authenticate()\n",
    "        _user = os.environ.get(\"KAGGLE_USERNAME\", _KAGGLE_USER_FALLBACK)\n",
    "        _slug = \"urban-observatory-results\"\n",
    "        with _seed_tmp.TemporaryDirectory() as _td:\n",
    "            _api.dataset_download_files(\n",
    "                dataset=f\"{_user}/{_slug}\",\n",
    "                path=_td,\n",
    "                unzip=True,\n",
    "                quiet=True,\n",
    "            )\n",
    "            _dl = Path(_td)\n",
    "            for _csv_name in _RESULT_CSVS:\n",
    "                _dst = _export_dir / _csv_name\n",
    "                _candidates = list(_dl.rglob(_csv_name))\n",
    "                if _candidates:\n",
    "                    shutil.copy2(_candidates[0], _dst)\n",
    "                    _n = sum(1 for _ in open(_dst)) - 1\n",
    "                    _seeded.append(f\"{_csv_name}({_n}rows)\")\n",
    "                    print(f\"  resume-seed: {_csv_name} → {_n} rows\")\n",
    "            if _seeded:\n",
    "                print(f\"  resume-seed: downloaded from {_user}/{_slug}\")\n",
    "    except Exception as _api_e:\n",
    "        print(f\"  resume-seed: API download failed ({type(_api_e).__name__}: {_api_e})\")\n",
    "    # ── Fallback: scan /kaggle/input mount (pinned at session-start version) ─\n",
    "    if not _seeded:\n",
    "        _kin = Path('/kaggle/input')\n",
    "        if _kin.exists():\n",
    "            for _csv_name in _RESULT_CSVS:\n",
    "                _dst = _export_dir / _csv_name\n",
    "                if _dst.exists():\n",
    "                    continue\n",
    "                for _src in _kin.rglob(_csv_name):\n",
    "                    try:\n",
    "                        shutil.copy2(_src, _dst)\n",
    "                        _seeded.append(f\"mount:{_src}\")\n",
    "                        break\n",
    "                    except Exception as _e:\n",
    "                        print(f\"  resume-seed warn: {_src}: {_e}\")\n",
    "    if _seeded:\n",
    "        print(f\"Kaggle environment: WORK_ROOT = {WORK_ROOT} (cleaned, RESUMED from {_seeded[0]})\")\n",
    "    else:\n",
    "        print(f\"Kaggle environment: WORK_ROOT = {WORK_ROOT} (cleaned, no prior results to resume)\")\n",
    "else:\n",
    "    WORK_ROOT = Path('/home/bcdr/Documents/phd')\n",
    "    print(f\"Local environment: WORK_ROOT = {WORK_ROOT}\")\n",
    "\n",
    "os.chdir(WORK_ROOT)\n",
    "if _IN_KAGGLE:\n",
    "    # Read-only Kaggle dataset mount; the dataset can sit at any of these locations\n",
    "    # depending on how it's attached. Search candidates in priority order.\n",
    "    _kin = Path('/kaggle/input')\n",
    "    _candidates = [\n",
    "        _kin / 'urban-observatory',\n",
    "        _kin / 'datasets' / _KAGGLE_USER_FALLBACK / 'urban-observatory',\n",
    "    ]\n",
    "    # Add anything else that contains urban_observatory.db (catches custom mount paths).\n",
    "    if _kin.exists():\n",
    "        for _hit in _kin.rglob('urban_observatory.db'):\n",
    "            _candidates.append(_hit.parent)\n",
    "    DATA_EXPORT = next((p for p in _candidates if p.exists()), None)\n",
    "    if DATA_EXPORT is None:\n",
    "        DATA_EXPORT = WORK_ROOT / \"data_export\"\n",
    "        DATA_EXPORT.mkdir(parents=True, exist_ok=True)\n",
    "        print(\"  WARNING: no dataset attached at /kaggle/input. \"\n",
    "              f\"Attach '{_KAGGLE_USER_FALLBACK}/urban-observatory' via Add Data > Your Datasets.\")\n",
    "    else:\n",
    "        print(f\"  Kaggle dataset mounted at: {DATA_EXPORT}\")\n",
    "else:\n",
    "    DATA_EXPORT = WORK_ROOT / \"data_export\"\n",
    "    DATA_EXPORT.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "# ── Triple-save: Drive (persistent) + local (fast) + Drive mirror ─\n",
    "# On Colab, every output is saved to Google Drive, the local\n",
    "# runtime filesystem, AND a dedicated Drive subfolder for desktop sync.\n",
    "# Reads prefer the local copy for speed; the Drive\n",
    "# copy survives runtime disconnects.\n",
    "# Locally, SAVE_ROOTS has a single entry — no mirroring needed.\n",
    "import shutil\n",
    "\n",
    "# On Kaggle, DATA_EXPORT (/kaggle/input/...) is read-only — writes go to /kaggle/working.\n",
    "if _IN_KAGGLE:\n",
    "    _WRITE_EXPORT = Path(WORK_ROOT) / \"data_export\"\n",
    "    _WRITE_EXPORT.mkdir(parents=True, exist_ok=True)\n",
    "    SAVE_ROOTS: list[Path] = [_WRITE_EXPORT]\n",
    "else:\n",
    "    SAVE_ROOTS: list[Path] = [DATA_EXPORT]\n",
    "\n",
    "if _IN_COLAB:\n",
    "    _LOCAL_EXPORT = Path(\"/content/data_export\")\n",
    "    _LOCAL_EXPORT.mkdir(parents=True, exist_ok=True)\n",
    "    SAVE_ROOTS.append(_LOCAL_EXPORT)\n",
    "    # Also mirror into a fixed Drive subfolder so Google Drive desktop\n",
    "    # sync automatically pushes files to the local PC.\n",
    "    _DRIVE_MIRROR = Path(\"/content/drive/MyDrive/phd_data_export\")\n",
    "    _DRIVE_MIRROR.mkdir(parents=True, exist_ok=True)\n",
    "    SAVE_ROOTS.append(_DRIVE_MIRROR)\n",
    "    print(f\"Triple-save: Drive Colab-Notebooks + {_LOCAL_EXPORT} + {_DRIVE_MIRROR}\")\n",
    "\n",
    "def mirror_save(relative_path: str) -> None:\n",
    "    \"\"\"Copy a just-written file from the primary DATA_EXPORT to all mirrors.\"\"\"\n",
    "    src = SAVE_ROOTS[0] / relative_path\n",
    "    if not src.exists():\n",
    "        return\n",
    "    for root in SAVE_ROOTS[1:]:\n",
    "        dst = root / relative_path\n",
    "        dst.parent.mkdir(parents=True, exist_ok=True)\n",
    "        shutil.copy2(src, dst)\n",
    "\n",
    "def all_export_paths(relative_path: str) -> list[Path]:\n",
    "    \"\"\"Return full paths in every SAVE_ROOT for a given relative path.\"\"\"\n",
    "    paths = []\n",
    "    for root in SAVE_ROOTS:\n",
    "        p = root / relative_path\n",
    "        p.parent.mkdir(parents=True, exist_ok=True)\n",
    "        paths.append(p)\n",
    "    return paths\n",
    "\n",
    "# Static path to the pre-converted bulk archive (Parquet, 2013-06 → present).\n",
    "# Same relative location in both environments:\n",
    "#   Colab : /content/drive/MyDrive/Colab Notebooks/data_export/archive_bulk\n",
    "#   Local : <repo>/data_export/archive_bulk\n",
    "# On Kaggle the per-year archive dirs live directly under DATA_EXPORT (the dataset root).\n",
    "# Locally / in Colab they sit under DATA_EXPORT/archive_bulk/.\n",
    "import re as _re_year\n",
    "_YEAR_PAT = _re_year.compile(r'^\\d{4}$')\n",
    "if _IN_KAGGLE and DATA_EXPORT.exists() and any(\n",
    "    _YEAR_PAT.fullmatch(p.name) for p in DATA_EXPORT.iterdir() if p.is_dir()\n",
    "):\n",
    "    ARCHIVE_BULK = DATA_EXPORT\n",
    "else:\n",
    "    ARCHIVE_BULK = DATA_EXPORT / \"archive_bulk\"\n",
    "ARCHIVE_BULK_AVAILABLE = ARCHIVE_BULK.exists() and any(ARCHIVE_BULK.rglob('*.parquet'))\n",
    "\n",
    "print(f\"cwd            = {os.getcwd()}\")\n",
    "print(f\"DATA_EXPORT    = {DATA_EXPORT}\")\n",
    "print(f\"ARCHIVE_BULK   = {ARCHIVE_BULK}  (available={ARCHIVE_BULK_AVAILABLE})\")\n",
    "\n",
    "# ── Tee stdout to a log file so all printed output is captured ────────────────\n",
    "import sys as _sys\n",
    "_LOG_PATH = SAVE_ROOTS[0] / \"notebook_output.log\"\n",
    "\n",
    "class _Tee:\n",
    "    \"\"\"Write to both the original stdout and a log file.\"\"\"\n",
    "    def __init__(self, log_path, original):\n",
    "        self._original = original\n",
    "        self._log = open(log_path, \"w\", encoding=\"utf-8\", buffering=1)\n",
    "    def write(self, data):\n",
    "        self._original.write(data)\n",
    "        self._log.write(data)\n",
    "    def flush(self):\n",
    "        self._original.flush()\n",
    "        self._log.flush()\n",
    "    def close_log(self):\n",
    "        self._log.close()\n",
    "    # Delegate everything else (isatty, fileno, etc.) to the original stream.\n",
    "    def __getattr__(self, name):\n",
    "        return getattr(self._original, name)\n",
    "\n",
    "_orig_stdout = _sys.stdout  # preserve IPython's per-cell stream\n",
    "_sys.stdout = _Tee(_LOG_PATH, _orig_stdout)\n",
    "print(f\"Logging all output to {_LOG_PATH}\")"
   ]
