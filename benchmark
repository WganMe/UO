    "    {\"id\": \"T2_14\", \"tier\": \"T2\", \"domain\": \"traffic\",\n",
    "     \"question\": \"What is the maximum Vehicle_Count recorded by each sensor?\",\n",
    "     \"sql\": \"SELECT sensor_name, MAX(value) AS max_count FROM readings WHERE variable = 'Vehicle_Count' GROUP BY sensor_name ORDER BY max_count DESC;\"},\n",
    "    {\"id\": \"T2_15\", \"tier\": \"T2\", \"domain\": \"noise\",\n",
    "     \"question\": \"What is the average and maximum LAeq_1min noise level per sensor?\",\n",
    "     \"sql\": \"SELECT sensor_name, AVG(value) AS avg_laeq_db, MAX(value) AS max_laeq_db, COUNT(*) AS n FROM readings WHERE variable = 'LAeq_1min' GROUP BY sensor_name ORDER BY avg_laeq_db DESC;\"},\n",
    "    {\"id\": \"T2_16\", \"tier\": \"T2\", \"domain\": \"air_quality\",\n",
    "     \"question\": \"What is the daily average PM2.5 for each sensor?\",\n",
    "     \"sql\": \"SELECT sensor_name, DATE(timestamp) AS day, AVG(value) AS avg_pm25 FROM readings WHERE variable = 'PM2.5' GROUP BY sensor_name, DATE(timestamp) ORDER BY sensor_name, day;\"},\n",
    "    {\"id\": \"T2_17\", \"tier\": \"T2\", \"domain\": \"multi_theme\",\n",
    "     \"question\": \"How many readings were recorded per calendar year across all themes?\",\n",
    "     \"sql\": \"SELECT strftime('%Y', timestamp) AS year, COUNT(*) AS reading_count, COUNT(DISTINCT variable) AS n_variables FROM readings GROUP BY strftime('%Y', timestamp) ORDER BY year;\"},\n",
    "    {\"id\": \"T2_18\", \"tier\": \"T2\", \"domain\": \"multi_theme\",\n",
    "     \"question\": \"How many readings were recorded per hour of the day (0–23) across the full archive?\",\n",
    "     \"sql\": \"SELECT CAST(strftime('%H', timestamp) AS INTEGER) AS hour, COUNT(*) AS reading_count FROM readings GROUP BY strftime('%H', timestamp) ORDER BY hour;\"},\n",
    "    {\"id\": \"T2_19\", \"tier\": \"T2\", \"domain\": \"multi_theme\",\n",
    "     \"question\": \"How many non-flagged (clean) readings exist per variable?\",\n",
    "     \"sql\": \"SELECT variable, COUNT(*) AS clean_count FROM readings WHERE flagged = 0 GROUP BY variable ORDER BY clean_count DESC;\"},\n",
    "    {\"id\": \"T2_20\", \"tier\": \"T2\", \"domain\": \"weather\",\n",
    "     \"question\": \"What is the average Wind_Speed per sensor?\",\n",
    "     \"sql\": \"SELECT sensor_name, AVG(value) AS avg_wind_mps, COUNT(*) AS n FROM readings WHERE variable = 'Wind_Speed' GROUP BY sensor_name ORDER BY avg_wind_mps DESC;\"},\n",
    "    {\"id\": \"T2_21\", \"tier\": \"T2\", \"domain\": \"multi_theme\",\n",
    "     \"question\": \"What is the total flagged reading count and flagging percentage per sensor?\",\n",
    "     \"sql\": \"SELECT sensor_name, SUM(flagged) AS total_flagged, COUNT(*) AS total, ROUND(100.0*SUM(flagged)/COUNT(*),2) AS pct_flagged FROM readings GROUP BY sensor_name ORDER BY pct_flagged DESC;\"},\n",
    "    {\"id\": \"T2_22\", \"tier\": \"T2\", \"domain\": \"weather\",\n",
    "     \"question\": \"What is the average Relative_Humidity per sensor?\",\n",
    "     \"sql\": \"SELECT sensor_name, AVG(value) AS avg_rh_pct, MIN(value) AS min_rh, MAX(value) AS max_rh FROM readings WHERE variable = 'Relative_Humidity' GROUP BY sensor_name;\"},\n",
    "    {\"id\": \"T2_23\", \"tier\": \"T2\", \"domain\": \"multi_theme\",\n",
    "     \"question\": \"What is the data span in days for each sensor (max − min timestamp)?\",\n",
    "     \"sql\": \"SELECT sensor_name, ROUND(JULIANDAY(MAX(timestamp)) - JULIANDAY(MIN(timestamp)), 1) AS span_days FROM readings GROUP BY sensor_name ORDER BY span_days DESC;\"},\n",
    "    {\"id\": \"T2_24\", \"tier\": \"T2\", \"domain\": \"water\",\n",
    "     \"question\": \"What is the maximum River_Level recorded per sensor?\",\n",
    "     \"sql\": \"SELECT sensor_name, MAX(value) AS max_river_level, AVG(value) AS mean_level FROM readings WHERE variable = 'River_Level' GROUP BY sensor_name ORDER BY max_river_level DESC;\"},\n",
    "    {\"id\": \"T2_25\", \"tier\": \"T2\", \"domain\": \"multi_theme\",\n",
    "     \"question\": \"How many readings were recorded per calendar month (year-month) across all themes?\",\n",
    "     \"sql\": \"SELECT strftime('%Y-%m', timestamp) AS month, COUNT(*) AS reading_count FROM readings GROUP BY strftime('%Y-%m', timestamp) ORDER BY month;\"},\n",
    "    {\"id\": \"T2_26\", \"tier\": \"T2\", \"domain\": \"air_quality\",\n",
    "     \"question\": \"What is the overall minimum and maximum NO2 value recorded across all sensors in the full archive?\",\n",
    "     \"sql\": \"SELECT MIN(value) AS min_no2, MAX(value) AS max_no2, AVG(value) AS mean_no2, COUNT(*) AS total_readings FROM readings WHERE variable = 'NO2';\"},\n",
    "    {\"id\": \"T2_27\", \"tier\": \"T2\", \"domain\": \"weather\",\n",
    "     \"question\": \"What is the average Atmospheric_Pressure per sensor?\",\n",
    "     \"sql\": \"SELECT sensor_name, AVG(value) AS avg_pressure_hpa FROM readings WHERE variable = 'Atmospheric_Pressure' GROUP BY sensor_name ORDER BY avg_pressure_hpa DESC;\"},\n",
    "    {\"id\": \"T2_28\", \"tier\": \"T2\", \"domain\": \"weather\",\n",
    "     \"question\": \"What is the cumulative total Rainfall per sensor over the full archive?\",\n",
    "     \"sql\": \"SELECT sensor_name, SUM(value) AS total_rainfall_mm, COUNT(*) AS n FROM readings WHERE variable = 'Rainfall' GROUP BY sensor_name ORDER BY total_rainfall_mm DESC;\"},\n",
    "    {\"id\": \"T2_29\", \"tier\": \"T2\", \"domain\": \"air_quality\",\n",
    "     \"question\": \"How many distinct days have NO2 readings per sensor across the full archive?\",\n",
    "     \"sql\": \"SELECT sensor_name, COUNT(DISTINCT DATE(timestamp)) AS days_with_data FROM readings WHERE variable = 'NO2' GROUP BY sensor_name ORDER BY days_with_data DESC;\"},\n",
    "    {\"id\": \"T2_30\", \"tier\": \"T2\", \"domain\": \"air_quality\",\n",
    "     \"question\": \"Compute the approximate population variance of PM10 readings per sensor using E[X²] − (E[X])².\",\n",
    "     \"sql\": \"SELECT sensor_name, COUNT(*) AS n, AVG(value) AS mean_pm10, AVG(value*value) - AVG(value)*AVG(value) AS pop_variance_pm10 FROM readings WHERE variable = 'PM10' GROUP BY sensor_name ORDER BY pop_variance_pm10 DESC;\"},\n",
    "\n",
    "    # ══════════════════════════════════════════════════════════════════════\n",
    "    # TIER 3 — Exactly two-table JOIN (sensors+readings OR variables+readings)\n",
    "    # Covers: all themes, broker-level analysis\n",
    "    # ══════════════════════════════════════════════════════════════════════\n",
    "    {\"id\": \"T3_01\", \"tier\": \"T3\", \"domain\": \"air_quality\",\n",
    "     \"question\": \"Which sensors recorded PM2.5 readings above 25 µg/m³? Show sensor name and broker.\",\n",
    "     \"sql\": \"SELECT DISTINCT s.sensor_name, s.broker_name FROM sensors s JOIN readings r ON s.sensor_name = r.sensor_name WHERE r.variable = 'PM2.5' AND r.value > 25;\"},\n",
    "    {\"id\": \"T3_02\", \"tier\": \"T3\", \"domain\": \"air_quality\",\n",
    "     \"question\": \"What is the average NO2 reading per broker source over the full archive?\",\n",
    "     \"sql\": \"SELECT s.broker_name, AVG(r.value) AS avg_no2, COUNT(*) AS n FROM sensors s JOIN readings r ON s.sensor_name = r.sensor_name WHERE r.variable = 'NO2' GROUP BY s.broker_name ORDER BY avg_no2 DESC;\"},\n",
    "    {\"id\": \"T3_03\", \"tier\": \"T3\", \"domain\": \"metadata\",\n",
    "     \"question\": \"List the units for each variable that has at least one reading in the database.\",\n",
    "     \"sql\": \"SELECT DISTINCT v.variable_name, v.theme, v.units FROM variables v JOIN readings r ON v.variable_name = r.variable ORDER BY v.theme, v.variable_name;\"},\n",
    "    {\"id\": \"T3_04\", \"tier\": \"T3\", \"domain\": \"multi_theme\",\n",
    "     \"question\": \"Which brokers have sensors that recorded flagged readings?\",\n",
    "     \"sql\": \"SELECT DISTINCT s.broker_name, COUNT(*) AS flagged_count FROM sensors s JOIN readings r ON s.sensor_name = r.sensor_name WHERE r.flagged = 1 GROUP BY s.broker_name ORDER BY flagged_count DESC;\"},\n",
    "    {\"id\": \"T3_05\", \"tier\": \"T3\", \"domain\": \"multi_theme\",\n",
    "     \"question\": \"How many readings exist per theme across the full archive?\",\n",
    "     \"sql\": \"SELECT v.theme, COUNT(*) AS reading_count FROM variables v JOIN readings r ON v.variable_name = r.variable GROUP BY v.theme ORDER BY reading_count DESC;\"},\n",
    "    {\"id\": \"T3_06\", \"tier\": \"T3\", \"domain\": \"multi_theme\",\n",
    "     \"question\": \"Show the average value of each variable along with its theme and units.\",\n",
    "     \"sql\": \"SELECT v.variable_name, v.theme, v.units, AVG(r.value) AS avg_val, COUNT(*) AS n FROM variables v JOIN readings r ON v.variable_name = r.variable GROUP BY v.variable_name, v.theme, v.units ORDER BY v.theme, v.variable_name;\"},\n",
    "    {\"id\": \"T3_07\", \"tier\": \"T3\", \"domain\": \"multi_theme\",\n",
    "     \"question\": \"What is the total number of readings per sensor, including the broker name?\",\n",
    "     \"sql\": \"SELECT s.sensor_name, s.broker_name, COUNT(*) AS total_readings FROM sensors s JOIN readings r ON s.sensor_name = r.sensor_name GROUP BY s.sensor_name, s.broker_name ORDER BY total_readings DESC;\"},\n",
    "    {\"id\": \"T3_08\", \"tier\": \"T3\", \"domain\": \"air_quality\",\n",
    "     \"question\": \"Find sensors whose mean NO2 exceeds the overall population mean NO2 across all sensors.\",\n",
    "     \"sql\": \"SELECT s.sensor_name, s.broker_name, AVG(r.value) AS avg_no2 FROM sensors s JOIN readings r ON s.sensor_name = r.sensor_name WHERE r.variable = 'NO2' GROUP BY s.sensor_name, s.broker_name HAVING AVG(r.value) > (SELECT AVG(value) FROM readings WHERE variable = 'NO2') ORDER BY avg_no2 DESC;\"},\n",
    "    {\"id\": \"T3_09\", \"tier\": \"T3\", \"domain\": \"multi_theme\",\n",
    "     \"question\": \"List the top 10 sensors by number of distinct variable types they measure.\",\n",
    "     \"sql\": \"SELECT r.sensor_name, COUNT(DISTINCT r.variable) AS var_count FROM readings r GROUP BY r.sensor_name ORDER BY var_count DESC LIMIT 10;\"},\n",
    "    {\"id\": \"T3_10\", \"tier\": \"T3\", \"domain\": \"traffic\",\n",
    "     \"question\": \"What is the average Vehicle_Count per broker over the full archive?\",\n",
    "     \"sql\": \"SELECT s.broker_name, AVG(r.value) AS avg_vehicle_count, COUNT(*) AS n FROM sensors s JOIN readings r ON s.sensor_name = r.sensor_name WHERE r.variable = 'Vehicle_Count' GROUP BY s.broker_name ORDER BY avg_vehicle_count DESC;\"},\n",
    "    {\"id\": \"T3_11\", \"tier\": \"T3\", \"domain\": \"weather\",\n",
    "     \"question\": \"Which brokers provide the highest average Temperature readings?\",\n",
    "     \"sql\": \"SELECT s.broker_name, AVG(r.value) AS avg_temp_c, COUNT(*) AS n FROM sensors s JOIN readings r ON s.sensor_name = r.sensor_name WHERE r.variable = 'Temperature' GROUP BY s.broker_name ORDER BY avg_temp_c DESC;\"},\n",
    "    {\"id\": \"T3_12\", \"tier\": \"T3\", \"domain\": \"air_quality\",\n",
    "     \"question\": \"Which sensors have flagged NO2 readings? Show sensor name and broker.\",\n",
    "     \"sql\": \"SELECT DISTINCT s.sensor_name, s.broker_name FROM sensors s JOIN readings r ON s.sensor_name = r.sensor_name WHERE r.variable = 'NO2' AND r.flagged = 1;\"},\n",
    "    {\"id\": \"T3_13\", \"tier\": \"T3\", \"domain\": \"air_quality\",\n",
    "     \"question\": \"What is the average PM10 per broker?\",\n",
    "     \"sql\": \"SELECT s.broker_name, AVG(r.value) AS avg_pm10, COUNT(*) AS n FROM sensors s JOIN readings r ON s.sensor_name = r.sensor_name WHERE r.variable = 'PM10' GROUP BY s.broker_name ORDER BY avg_pm10 DESC;\"},\n",
    "    {\"id\": \"T3_14\", \"tier\": \"T3\", \"domain\": \"multi_theme\",\n",
    "     \"question\": \"Which sensors measure both NO2 and Vehicle_Count (multi-theme sensors)?\",\n",
    "     \"sql\": \"SELECT DISTINCT r1.sensor_name FROM readings r1 WHERE r1.variable = 'NO2' AND EXISTS (SELECT 1 FROM readings r2 WHERE r2.sensor_name = r1.sensor_name AND r2.variable = 'Vehicle_Count');\"},\n",
    "    {\"id\": \"T3_15\", \"tier\": \"T3\", \"domain\": \"multi_theme\",\n",
    "     \"question\": \"Show variable names, themes, and units for variables with more than 1000 readings in the archive.\",\n",
    "     \"sql\": \"SELECT v.variable_name, v.theme, v.units, COUNT(r.id) AS reading_count FROM variables v JOIN readings r ON v.variable_name = r.variable GROUP BY v.variable_name, v.theme, v.units HAVING COUNT(r.id) > 1000 ORDER BY reading_count DESC;\"},\n",
    "    {\"id\": \"T3_16\", \"tier\": \"T3\", \"domain\": \"multi_theme\",\n",
    "     \"question\": \"What is the most recent reading timestamp per broker?\",\n",
    "     \"sql\": \"SELECT s.broker_name, MAX(r.timestamp) AS latest_reading FROM sensors s JOIN readings r ON s.sensor_name = r.sensor_name GROUP BY s.broker_name ORDER BY latest_reading DESC;\"},\n",
    "    {\"id\": \"T3_17\", \"tier\": \"T3\", \"domain\": \"noise\",\n",
    "     \"question\": \"Which sensors have an average LAeq_1min noise level above 60 dB? Show broker.\",\n",
    "     \"sql\": \"SELECT s.sensor_name, s.broker_name, AVG(r.value) AS avg_laeq_db FROM sensors s JOIN readings r ON s.sensor_name = r.sensor_name WHERE r.variable = 'LAeq_1min' GROUP BY s.sensor_name, s.broker_name HAVING AVG(r.value) > 60 ORDER BY avg_laeq_db DESC;\"},\n",
    "    {\"id\": \"T3_18\", \"tier\": \"T3\", \"domain\": \"air_quality\",\n",
    "     \"question\": \"Compare average NO2 between elevated sensors (ground_height > 10 m) and ground-level sensors.\",\n",
    "     \"sql\": \"SELECT CASE WHEN s.ground_height > 10 THEN 'Elevated (>10m)' ELSE 'Ground (≤10m)' END AS elevation_class, AVG(r.value) AS avg_no2, COUNT(*) AS n FROM sensors s JOIN readings r ON s.sensor_name = r.sensor_name WHERE r.variable = 'NO2' AND s.ground_height IS NOT NULL GROUP BY elevation_class;\"},\n",
    "    {\"id\": \"T3_19\", \"tier\": \"T3\", \"domain\": \"air_quality\",\n",
    "     \"question\": \"Which sensors have more than 10000 NO2 readings in the full archive?\",\n",
    "     \"sql\": \"SELECT s.sensor_name, s.broker_name, COUNT(*) AS no2_count FROM sensors s JOIN readings r ON s.sensor_name = r.sensor_name WHERE r.variable = 'NO2' GROUP BY s.sensor_name, s.broker_name HAVING COUNT(*) > 10000 ORDER BY no2_count DESC;\"},\n",
    "    {\"id\": \"T3_20\", \"tier\": \"T3\", \"domain\": \"multi_theme\",\n",
    "     \"question\": \"Which variables have an average value above the overall mean of all readings across all variables?\",\n",
    "     \"sql\": \"SELECT v.variable_name, v.theme, v.units, AVG(r.value) AS avg_val FROM variables v JOIN readings r ON v.variable_name = r.variable GROUP BY v.variable_name, v.theme, v.units HAVING AVG(r.value) > (SELECT AVG(value) FROM readings) ORDER BY avg_val DESC;\"},\n",
    "    {\"id\": \"T3_21\", \"tier\": \"T3\", \"domain\": \"weather\",\n",
    "     \"question\": \"What is the average Wind_Speed per broker?\",\n",
    "     \"sql\": \"SELECT s.broker_name, AVG(r.value) AS avg_wind_mps, COUNT(*) AS n FROM sensors s JOIN readings r ON s.sensor_name = r.sensor_name WHERE r.variable = 'Wind_Speed' GROUP BY s.broker_name ORDER BY avg_wind_mps DESC;\"},\n",
    "    {\"id\": \"T3_22\", \"tier\": \"T3\", \"domain\": \"multi_theme\",\n",
    "     \"question\": \"Which brokers have sensors with a data archive spanning more than 365 days?\",\n",
    "     \"sql\": \"SELECT s.broker_name, s.sensor_name, ROUND(JULIANDAY(MAX(r.timestamp)) - JULIANDAY(MIN(r.timestamp)), 0) AS span_days FROM sensors s JOIN readings r ON s.sensor_name = r.sensor_name GROUP BY s.broker_name, s.sensor_name HAVING span_days > 365 ORDER BY span_days DESC;\"},\n",
    "    {\"id\": \"T3_23\", \"tier\": \"T3\", \"domain\": \"weather\",\n",
    "     \"question\": \"What is the average Relative_Humidity per broker?\",\n",
    "     \"sql\": \"SELECT s.broker_name, AVG(r.value) AS avg_rh_pct, COUNT(*) AS n FROM sensors s JOIN readings r ON s.sensor_name = r.sensor_name WHERE r.variable = 'Relative_Humidity' GROUP BY s.broker_name ORDER BY avg_rh_pct DESC;\"},\n",
    "    {\"id\": \"T3_24\", \"tier\": \"T3\", \"domain\": \"multi_theme\",\n",
    "     \"question\": \"For each sensor and broker, what percentage of readings are flagged?\",\n",
    "     \"sql\": \"SELECT s.sensor_name, s.broker_name, ROUND(100.0 * SUM(r.flagged) / COUNT(*), 2) AS pct_flagged FROM sensors s JOIN readings r ON s.sensor_name = r.sensor_name GROUP BY s.sensor_name, s.broker_name ORDER BY pct_flagged DESC;\"},\n",
    "    {\"id\": \"T3_25\", \"tier\": \"T3\", \"domain\": \"air_quality\",\n",
    "     \"question\": \"What is the average of daily maximum NO2 values per broker (average worst-day NO2)?\",\n",
    "     \"sql\": \"SELECT s.broker_name, AVG(daily_max) AS avg_daily_peak_no2 FROM (SELECT r.sensor_name, DATE(r.timestamp) AS day, MAX(r.value) AS daily_max FROM readings r WHERE r.variable = 'NO2' GROUP BY r.sensor_name, DATE(r.timestamp)) d JOIN sensors s ON d.sensor_name = s.sensor_name GROUP BY s.broker_name ORDER BY avg_daily_peak_no2 DESC;\"},\n",
    "    {\"id\": \"T3_26\", \"tier\": \"T3\", \"domain\": \"multi_theme\",\n",
    "     \"question\": \"Which broker has the earliest archive start date?\",\n",
    "     \"sql\": \"SELECT s.broker_name, MIN(r.timestamp) AS archive_start FROM sensors s JOIN readings r ON s.sensor_name = r.sensor_name GROUP BY s.broker_name ORDER BY archive_start;\"},\n",
    "    {\"id\": \"T3_27\", \"tier\": \"T3\", \"domain\": \"multi_theme\",\n",
    "     \"question\": \"Show each variable's theme, its reading count, and average value in the archive.\",\n",
    "     \"sql\": \"SELECT v.variable_name, v.theme, COUNT(r.id) AS reading_count, ROUND(AVG(r.value), 4) AS avg_val FROM variables v JOIN readings r ON v.variable_name = r.variable GROUP BY v.variable_name, v.theme ORDER BY reading_count DESC;\"},\n",
    "    {\"id\": \"T3_28\", \"tier\": \"T3\", \"domain\": \"air_quality\",\n",
    "     \"question\": \"Show average NO2 per sensor with their geographic coordinates.\",\n",
    "     \"sql\": \"SELECT s.sensor_name, s.centroid_lat, s.centroid_lon, AVG(r.value) AS avg_no2, COUNT(*) AS n FROM sensors s JOIN readings r ON s.sensor_name = r.sensor_name WHERE r.variable = 'NO2' GROUP BY s.sensor_name, s.centroid_lat, s.centroid_lon ORDER BY avg_no2 DESC;\"},\n",
    "    {\"id\": \"T3_29\", \"tier\": \"T3\", \"domain\": \"multi_theme\",\n",
    "     \"question\": \"For each sensor, show the broker name and the date of its first ever reading in the archive.\",\n",
    "     \"sql\": \"SELECT s.sensor_name, s.broker_name, MIN(r.timestamp) AS first_reading FROM sensors s JOIN readings r ON s.sensor_name = r.sensor_name GROUP BY s.sensor_name, s.broker_name ORDER BY first_reading;\"},\n",
    "    {\"id\": \"T3_30\", \"tier\": \"T3\", \"domain\": \"air_quality\",\n",
    "     \"question\": \"Compare average PM2.5 between high-mounted sensors (sensor_height > 3 m) and low-mounted sensors.\",\n",
    "     \"sql\": \"SELECT CASE WHEN s.sensor_height > 3 THEN 'High-mount (>3m)' ELSE 'Low-mount (≤3m)' END AS mount_class, AVG(r.value) AS avg_pm25, COUNT(*) AS n FROM sensors s JOIN readings r ON s.sensor_name = r.sensor_name WHERE r.variable = 'PM2.5' AND s.sensor_height IS NOT NULL GROUP BY mount_class;\"},\n",
    "\n",
    "    # ══════════════════════════════════════════════════════════════════════\n",
    "    # TIER 4 — Window functions OR 3-table JOINs\n",
    "    # Covers: all themes, temporal patterns, ranking, running aggregates\n",
    "    # ══════════════════════════════════════════════════════════════════════\n",
    "    {\"id\": \"T4_01\", \"tier\": \"T4\", \"domain\": \"air_quality\",\n",
    "     \"question\": \"Rank sensors by their worst (highest) monthly average NO2 over the full archive.\",\n",
    "     \"sql\": \"SELECT sensor_name, month, avg_no2, RANK() OVER (ORDER BY avg_no2 DESC) AS overall_rank FROM (SELECT r.sensor_name, strftime('%Y-%m', r.timestamp) AS month, AVG(r.value) AS avg_no2 FROM readings r WHERE r.variable = 'NO2' GROUP BY r.sensor_name, strftime('%Y-%m', r.timestamp)) sub ORDER BY overall_rank;\"},\n",
    "    {\"id\": \"T4_02\", \"tier\": \"T4\", \"domain\": \"air_quality\",\n",
    "     \"question\": \"For each broker, identify the sensor with the highest average PM2.5.\",\n",
    "     \"sql\": \"SELECT broker_name, sensor_name, avg_pm25 FROM (SELECT s.broker_name, r.sensor_name, AVG(r.value) AS avg_pm25, ROW_NUMBER() OVER (PARTITION BY s.broker_name ORDER BY AVG(r.value) DESC) AS rn FROM sensors s JOIN readings r ON s.sensor_name = r.sensor_name WHERE r.variable = 'PM2.5' GROUP BY s.broker_name, r.sensor_name) sub WHERE rn = 1;\"},\n",
    "    {\"id\": \"T4_03\", \"tier\": \"T4\", \"domain\": \"air_quality\",\n",
    "     \"question\": \"Show each NO2 reading alongside the 7-reading rolling average for that sensor.\",\n",
    "     \"sql\": \"SELECT r.sensor_name, r.timestamp, r.value, AVG(r.value) OVER (PARTITION BY r.sensor_name ORDER BY r.timestamp ROWS BETWEEN 6 PRECEDING AND CURRENT ROW) AS rolling_7_avg FROM readings r WHERE r.variable = 'NO2' ORDER BY r.sensor_name, r.timestamp;\"},\n",
    "    {\"id\": \"T4_04\", \"tier\": \"T4\", \"domain\": \"multi_theme\",\n",
    "     \"question\": \"For each theme, identify the variable with the most readings and show its units.\",\n",
    "     \"sql\": \"SELECT theme, variable_name, units, reading_count FROM (SELECT v.theme, v.variable_name, v.units, COUNT(*) AS reading_count, ROW_NUMBER() OVER (PARTITION BY v.theme ORDER BY COUNT(*) DESC) AS rn FROM variables v JOIN readings r ON v.variable_name = r.variable GROUP BY v.theme, v.variable_name, v.units) sub WHERE rn = 1;\"},\n",
    "    {\"id\": \"T4_05\", \"tier\": \"T4\", \"domain\": \"air_quality\",\n",
    "     \"question\": \"Compute the percentile rank of each sensor's mean NO2 across all sensors.\",\n",
    "     \"sql\": \"SELECT sensor_name, avg_no2, ROUND(PERCENT_RANK() OVER (ORDER BY avg_no2) * 100, 2) AS percentile FROM (SELECT sensor_name, AVG(value) AS avg_no2 FROM readings WHERE variable = 'NO2' GROUP BY sensor_name) sub;\"},\n",
    "    {\"id\": \"T4_06\", \"tier\": \"T4\", \"domain\": \"air_quality\",\n",
    "     \"question\": \"Find the day-over-day change in average NO2 for each sensor using LAG.\",\n",
    "     \"sql\": \"SELECT sensor_name, day, avg_no2, ROUND(avg_no2 - LAG(avg_no2) OVER (PARTITION BY sensor_name ORDER BY day), 4) AS daily_change FROM (SELECT sensor_name, DATE(timestamp) AS day, AVG(value) AS avg_no2 FROM readings WHERE variable = 'NO2' GROUP BY sensor_name, DATE(timestamp)) sub ORDER BY sensor_name, day;\"},\n",
    "    {\"id\": \"T4_07\", \"tier\": \"T4\", \"domain\": \"multi_theme\",\n",
    "     \"question\": \"For each broker, identify the sensor with the longest continuous data archive.\",\n",
    "     \"sql\": \"SELECT broker_name, sensor_name, data_span_days FROM (SELECT s.broker_name, r.sensor_name, ROUND(JULIANDAY(MAX(r.timestamp)) - JULIANDAY(MIN(r.timestamp)), 1) AS data_span_days, ROW_NUMBER() OVER (PARTITION BY s.broker_name ORDER BY JULIANDAY(MAX(r.timestamp)) - JULIANDAY(MIN(r.timestamp)) DESC) AS rn FROM sensors s JOIN readings r ON s.sensor_name = r.sensor_name GROUP BY s.broker_name, r.sensor_name) sub WHERE rn = 1;\"},\n",
    "    {\"id\": \"T4_08\", \"tier\": \"T4\", \"domain\": \"air_quality\",\n",
    "     \"question\": \"Classify each sensor-day's average NO2 as Good (<40 µg/m³), Moderate (40–100), or Poor (>100).\",\n",
    "     \"sql\": \"SELECT sensor_name, day, avg_no2, CASE WHEN avg_no2 < 40 THEN 'Good' WHEN avg_no2 <= 100 THEN 'Moderate' ELSE 'Poor' END AS aq_class FROM (SELECT sensor_name, DATE(timestamp) AS day, AVG(value) AS avg_no2 FROM readings WHERE variable = 'NO2' GROUP BY sensor_name, DATE(timestamp)) sub ORDER BY sensor_name, day;\"},\n",
    "    {\"id\": \"T4_09\", \"tier\": \"T4\", \"domain\": \"air_quality\",\n",
    "     \"question\": \"Show each NO2 reading's deviation from its sensor's long-term mean (mean-centred values).\",\n",
    "     \"sql\": \"SELECT r.sensor_name, r.timestamp, r.value, r.value - AVG(r.value) OVER (PARTITION BY r.sensor_name) AS deviation FROM readings r WHERE r.variable = 'NO2' ORDER BY r.sensor_name, r.timestamp;\"},\n",
    "    {\"id\": \"T4_10\", \"tier\": \"T4\", \"domain\": \"air_quality\",\n",
    "     \"question\": \"For each sensor, find the hour of day (0–23) with the highest average NO2.\",\n",
    "     \"sql\": \"SELECT sensor_name, hour, avg_no2 FROM (SELECT sensor_name, CAST(strftime('%H', timestamp) AS INTEGER) AS hour, AVG(value) AS avg_no2, ROW_NUMBER() OVER (PARTITION BY sensor_name ORDER BY AVG(value) DESC) AS rn FROM readings WHERE variable = 'NO2' GROUP BY sensor_name, strftime('%H', timestamp)) sub WHERE rn = 1 ORDER BY avg_no2 DESC;\"},\n",
    "    {\"id\": \"T4_11\", \"tier\": \"T4\", \"domain\": \"traffic\",\n",
    "     \"question\": \"Rank sensors within each broker by their average Vehicle_Count.\",\n",
    "     \"sql\": \"SELECT broker_name, sensor_name, avg_count, RANK() OVER (PARTITION BY broker_name ORDER BY avg_count DESC) AS broker_rank FROM (SELECT s.broker_name, r.sensor_name, AVG(r.value) AS avg_count FROM sensors s JOIN readings r ON s.sensor_name = r.sensor_name WHERE r.variable = 'Vehicle_Count' GROUP BY s.broker_name, r.sensor_name) sub ORDER BY broker_name, broker_rank;\"},\n",
    "    {\"id\": \"T4_12\", \"tier\": \"T4\", \"domain\": \"weather\",\n",
    "     \"question\": \"Show each Temperature reading alongside the 24-reading rolling average for that sensor.\",\n",
    "     \"sql\": \"SELECT r.sensor_name, r.timestamp, r.value, AVG(r.value) OVER (PARTITION BY r.sensor_name ORDER BY r.timestamp ROWS BETWEEN 23 PRECEDING AND CURRENT ROW) AS rolling_24_avg FROM readings r WHERE r.variable = 'Temperature' ORDER BY r.sensor_name, r.timestamp;\"},\n",
    "    {\"id\": \"T4_13\", \"tier\": \"T4\", \"domain\": \"air_quality\",\n",
    "     \"question\": \"Find the day-over-day change in average PM2.5 per sensor using LAG.\",\n",
    "     \"sql\": \"SELECT sensor_name, day, avg_pm25, ROUND(avg_pm25 - LAG(avg_pm25) OVER (PARTITION BY sensor_name ORDER BY day), 4) AS daily_change FROM (SELECT sensor_name, DATE(timestamp) AS day, AVG(value) AS avg_pm25 FROM readings WHERE variable = 'PM2.5' GROUP BY sensor_name, DATE(timestamp)) sub ORDER BY sensor_name, day;\"},\n",
    "    {\"id\": \"T4_14\", \"tier\": \"T4\", \"domain\": \"weather\",\n",
    "     \"question\": \"Show the cumulative total Rainfall per sensor ordered by timestamp (running sum).\",\n",
    "     \"sql\": \"SELECT sensor_name, timestamp, value, SUM(value) OVER (PARTITION BY sensor_name ORDER BY timestamp) AS cumulative_rainfall_mm FROM readings WHERE variable = 'Rainfall' ORDER BY sensor_name, timestamp;\"},\n",
    "    {\"id\": \"T4_15\", \"tier\": \"T4\", \"domain\": \"traffic\",\n",
    "     \"question\": \"Classify each Vehicle_Count reading as Low (<200), Medium (200–600), or High (>600).\",\n",
    "     \"sql\": \"SELECT sensor_name, timestamp, value, CASE WHEN value < 200 THEN 'Low' WHEN value <= 600 THEN 'Medium' ELSE 'High' END AS traffic_class FROM readings WHERE variable = 'Vehicle_Count' ORDER BY sensor_name, timestamp;\"},\n",
    "    {\"id\": \"T4_16\", \"tier\": \"T4\", \"domain\": \"noise\",\n",
    "     \"question\": \"Show the running minimum and maximum LAeq_1min noise level per sensor.\",\n",
    "     \"sql\": \"SELECT sensor_name, timestamp, value, MIN(value) OVER (PARTITION BY sensor_name ORDER BY timestamp) AS running_min_db, MAX(value) OVER (PARTITION BY sensor_name ORDER BY timestamp) AS running_max_db FROM readings WHERE variable = 'LAeq_1min' ORDER BY sensor_name, timestamp;\"},\n",
    "    {\"id\": \"T4_17\", \"tier\": \"T4\", \"domain\": \"air_quality\",\n",
    "     \"question\": \"Assign each sensor to a NO2 quartile (NTILE 4) based on its mean NO2.\",\n",
    "     \"sql\": \"SELECT sensor_name, avg_no2, NTILE(4) OVER (ORDER BY avg_no2) AS no2_quartile FROM (SELECT sensor_name, AVG(value) AS avg_no2 FROM readings WHERE variable = 'NO2' GROUP BY sensor_name) sub ORDER BY no2_quartile, avg_no2;\"},\n",
    "    {\"id\": \"T4_18\", \"tier\": \"T4\", \"domain\": \"air_quality\",\n",
    "     \"question\": \"Find the week-over-week change in average NO2 per sensor using LAG.\",\n",
    "     \"sql\": \"SELECT sensor_name, week, avg_no2, ROUND(avg_no2 - LAG(avg_no2) OVER (PARTITION BY sensor_name ORDER BY week), 4) AS weekly_change FROM (SELECT sensor_name, strftime('%Y-%W', timestamp) AS week, AVG(value) AS avg_no2 FROM readings WHERE variable = 'NO2' GROUP BY sensor_name, strftime('%Y-%W', timestamp)) sub ORDER BY sensor_name, week;\"},\n",
    "    {\"id\": \"T4_19\", \"tier\": \"T4\", \"domain\": \"noise\",\n",
    "     \"question\": \"For each sensor, find the 3 noisiest hours of the day (by average LAeq_1min).\",\n",
    "     \"sql\": \"SELECT sensor_name, hour, avg_laeq_db FROM (SELECT sensor_name, CAST(strftime('%H', timestamp) AS INTEGER) AS hour, AVG(value) AS avg_laeq_db, ROW_NUMBER() OVER (PARTITION BY sensor_name ORDER BY AVG(value) DESC) AS rn FROM readings WHERE variable = 'LAeq_1min' GROUP BY sensor_name, strftime('%H', timestamp)) sub WHERE rn <= 3 ORDER BY sensor_name, rn;\"},\n",
    "    {\"id\": \"T4_20\", \"tier\": \"T4\", \"domain\": \"air_quality\",\n",
    "     \"question\": \"Compute the percentile rank of each sensor's mean PM2.5 within its broker group.\",\n",
    "     \"sql\": \"SELECT broker_name, sensor_name, avg_pm25, ROUND(PERCENT_RANK() OVER (PARTITION BY broker_name ORDER BY avg_pm25) * 100, 2) AS pct_rank_within_broker FROM (SELECT s.broker_name, r.sensor_name, AVG(r.value) AS avg_pm25 FROM sensors s JOIN readings r ON s.sensor_name = r.sensor_name WHERE r.variable = 'PM2.5' GROUP BY s.broker_name, r.sensor_name) sub ORDER BY broker_name, pct_rank_within_broker;\"},\n",
    "    {\"id\": \"T4_21\", \"tier\": \"T4\", \"domain\": \"multi_theme\",\n",
    "     \"question\": \"For each theme, identify the variable with the lowest average value.\",\n",
    "     \"sql\": \"SELECT theme, variable_name, avg_val FROM (SELECT v.theme, v.variable_name, AVG(r.value) AS avg_val, ROW_NUMBER() OVER (PARTITION BY v.theme ORDER BY AVG(r.value) ASC) AS rn FROM variables v JOIN readings r ON v.variable_name = r.variable GROUP BY v.theme, v.variable_name) sub WHERE rn = 1 ORDER BY theme;\"},\n",
    "    {\"id\": \"T4_22\", \"tier\": \"T4\", \"domain\": \"air_quality\",\n",
    "     \"question\": \"For each sensor show today's average NO2 alongside the predicted next day using LEAD.\",\n",
    "     \"sql\": \"SELECT sensor_name, day, avg_no2, LEAD(avg_no2) OVER (PARTITION BY sensor_name ORDER BY day) AS next_day_no2 FROM (SELECT sensor_name, DATE(timestamp) AS day, AVG(value) AS avg_no2 FROM readings WHERE variable = 'NO2' GROUP BY sensor_name, DATE(timestamp)) sub ORDER BY sensor_name, day;\"},\n",
    "    {\"id\": \"T4_23\", \"tier\": \"T4\", \"domain\": \"multi_theme\",\n",
    "     \"question\": \"For each sensor, count the number of distinct calendar years with readings and rank sensors by coverage.\",\n",
    "     \"sql\": \"SELECT sensor_name, COUNT(DISTINCT strftime('%Y', timestamp)) AS years_active, ROUND(JULIANDAY(MAX(timestamp)) - JULIANDAY(MIN(timestamp)), 0) AS archive_span_days, RANK() OVER (ORDER BY COUNT(DISTINCT strftime('%Y', timestamp)) DESC) AS coverage_rank FROM readings GROUP BY sensor_name ORDER BY coverage_rank;\"},\n",
    "    {\"id\": \"T4_24\", \"tier\": \"T4\", \"domain\": \"weather\",\n",
    "     \"question\": \"Classify each Wind_Speed reading as Calm (<5 m/s), Breeze (5–15), Strong (15–30), or Storm (>30).\",\n",
    "     \"sql\": \"SELECT sensor_name, timestamp, value, CASE WHEN value < 5 THEN 'Calm' WHEN value < 15 THEN 'Breeze' WHEN value < 30 THEN 'Strong' ELSE 'Storm' END AS wind_class FROM readings WHERE variable = 'Wind_Speed' ORDER BY sensor_name, timestamp;\"},\n",
    "    {\"id\": \"T4_25\", \"tier\": \"T4\", \"domain\": \"air_quality\",\n",
    "     \"question\": \"Show the monthly NO2 average per sensor alongside the previous month's value using LAG.\",\n",
    "     \"sql\": \"SELECT sensor_name, month, avg_no2, ROUND(avg_no2 - LAG(avg_no2) OVER (PARTITION BY sensor_name ORDER BY month), 4) AS mom_change FROM (SELECT sensor_name, strftime('%Y-%m', timestamp) AS month, AVG(value) AS avg_no2 FROM readings WHERE variable = 'NO2' GROUP BY sensor_name, strftime('%Y-%m', timestamp)) sub ORDER BY sensor_name, month;\"},\n",
    "    {\"id\": \"T4_26\", \"tier\": \"T4\", \"domain\": \"air_quality\",\n",
    "     \"question\": \"For each NO2 reading, show the sensor-level population mean and population variance as window functions.\",\n",
    "     \"sql\": \"SELECT sensor_name, timestamp, value, AVG(value) OVER (PARTITION BY sensor_name) AS sensor_pop_mean, AVG(value*value) OVER (PARTITION BY sensor_name) - AVG(value) OVER (PARTITION BY sensor_name) * AVG(value) OVER (PARTITION BY sensor_name) AS sensor_pop_variance FROM readings WHERE variable = 'NO2' ORDER BY sensor_name, timestamp;\"},\n",
    "    {\"id\": \"T4_27\", \"tier\": \"T4\", \"domain\": \"multi_theme\",\n",
    "     \"question\": \"Show the running cumulative count of flagged readings per sensor per variable.\",\n",
    "     \"sql\": \"SELECT sensor_name, variable, timestamp, flagged, SUM(flagged) OVER (PARTITION BY sensor_name, variable ORDER BY timestamp) AS cumulative_flags FROM readings ORDER BY sensor_name, variable, timestamp;\"},\n",
    "    {\"id\": \"T4_28\", \"tier\": \"T4\", \"domain\": \"multi_theme\",\n",
    "     \"question\": \"Within each broker, rank sensors by total flagged reading count.\",\n",
    "     \"sql\": \"SELECT broker_name, sensor_name, total_flagged, RANK() OVER (PARTITION BY broker_name ORDER BY total_flagged DESC) AS flagged_rank FROM (SELECT s.broker_name, r.sensor_name, SUM(r.flagged) AS total_flagged FROM sensors s JOIN readings r ON s.sensor_name = r.sensor_name GROUP BY s.broker_name, r.sensor_name) sub ORDER BY broker_name, flagged_rank;\"},\n",
    "    {\"id\": \"T4_29\", \"tier\": \"T4\", \"domain\": \"traffic\",\n",
    "     \"question\": \"Assign each hour of the day (0–23) to a Vehicle_Count quintile (NTILE 5).\",\n",
    "     \"sql\": \"SELECT hour, avg_count, NTILE(5) OVER (ORDER BY avg_count) AS count_quintile FROM (SELECT CAST(strftime('%H', timestamp) AS INTEGER) AS hour, AVG(value) AS avg_count FROM readings WHERE variable = 'Vehicle_Count' GROUP BY strftime('%H', timestamp)) sub ORDER BY hour;\"},\n",
    "    {\"id\": \"T4_30\", \"tier\": \"T4\", \"domain\": \"air_quality\",\n",
    "     \"question\": \"For each NO2 reading, classify as Weekday or Weekend and show the group average as a window function.\",\n",
    "     \"sql\": \"SELECT sensor_name, timestamp, value, CASE WHEN CAST(strftime('%w', timestamp) AS INTEGER) IN (0, 6) THEN 'Weekend' ELSE 'Weekday' END AS day_type, AVG(value) OVER (PARTITION BY sensor_name, CASE WHEN CAST(strftime('%w', timestamp) AS INTEGER) IN (0, 6) THEN 'Weekend' ELSE 'Weekday' END) AS day_type_mean_no2 FROM readings WHERE variable = 'NO2' ORDER BY sensor_name, timestamp;\"},\n",
    "\n",
    "    # ══════════════════════════════════════════════════════════════════════\n",
    "    # TIER 5 — Multi-CTE cross-theme strategic analysis (population-level)\n",
    "    # Covers: all themes, long-term trends, cross-variable, strategic decisions\n",
    "    # ══════════════════════════════════════════════════════════════════════\n",
    "    {\"id\": \"T5_01\", \"tier\": \"T5\", \"domain\": \"air_quality\",\n",
    "     \"question\": \"Compare daily average NO2 and PM2.5 at each sensor on the same day.\",\n",
    "     \"sql\": \"WITH no2 AS (SELECT sensor_name, DATE(timestamp) AS day, AVG(value) AS avg_no2 FROM readings WHERE variable = 'NO2' GROUP BY sensor_name, DATE(timestamp)), pm25 AS (SELECT sensor_name, DATE(timestamp) AS day, AVG(value) AS avg_pm25 FROM readings WHERE variable = 'PM2.5' GROUP BY sensor_name, DATE(timestamp)) SELECT no2.sensor_name, no2.day, no2.avg_no2, pm25.avg_pm25 FROM no2 JOIN pm25 ON no2.sensor_name = pm25.sensor_name AND no2.day = pm25.day ORDER BY no2.sensor_name, no2.day;\"},\n",
    "    {\"id\": \"T5_02\", \"tier\": \"T5\", \"domain\": \"air_quality\",\n",
    "     \"question\": \"Find days where sensor-level daily average NO2 exceeds 40 µg/m³ AND PM10 exceeds 50 µg/m³ simultaneously.\",\n",
    "     \"sql\": \"WITH no2_high AS (SELECT sensor_name, DATE(timestamp) AS day, AVG(value) AS avg_no2 FROM readings WHERE variable = 'NO2' GROUP BY sensor_name, DATE(timestamp) HAVING AVG(value) > 40), pm10_high AS (SELECT sensor_name, DATE(timestamp) AS day, AVG(value) AS avg_pm10 FROM readings WHERE variable = 'PM10' GROUP BY sensor_name, DATE(timestamp) HAVING AVG(value) > 50) SELECT n.sensor_name, n.day, n.avg_no2, p.avg_pm10 FROM no2_high n JOIN pm10_high p ON n.sensor_name = p.sensor_name AND n.day = p.day ORDER BY n.day;\"},\n",
    "    {\"id\": \"T5_03\", \"tier\": \"T5\", \"domain\": \"multi_theme\",\n",
    "     \"question\": \"For each broker, compare the total count of Air Quality readings vs Weather readings.\",\n",
    "     \"sql\": \"WITH aq AS (SELECT s.broker_name, COUNT(*) AS aq_count FROM sensors s JOIN readings r ON s.sensor_name = r.sensor_name JOIN variables v ON r.variable = v.variable_name WHERE v.theme = 'Air Quality' GROUP BY s.broker_name), wx AS (SELECT s.broker_name, COUNT(*) AS wx_count FROM sensors s JOIN readings r ON s.sensor_name = r.sensor_name JOIN variables v ON r.variable = v.variable_name WHERE v.theme = 'Weather' GROUP BY s.broker_name), brokers AS (SELECT broker_name FROM aq UNION SELECT broker_name FROM wx) SELECT b.broker_name AS broker, COALESCE(aq.aq_count, 0) AS aq_readings, COALESCE(wx.wx_count, 0) AS weather_readings FROM brokers b LEFT JOIN aq ON b.broker_name = aq.broker_name LEFT JOIN wx ON b.broker_name = wx.broker_name ORDER BY aq_readings DESC;\"},\n",
    "    {\"id\": \"T5_04\", \"tier\": \"T5\", \"domain\": \"air_quality\",\n",
    "     \"question\": \"Identify the top 3 sensors with the most overlapping NO2 and PM2.5 daily observation days (proxy for co-location correlation study).\",\n",
    "     \"sql\": \"WITH daily AS (SELECT r.sensor_name, DATE(r.timestamp) AS day, r.variable, AVG(r.value) AS avg_val FROM readings r WHERE r.variable IN ('NO2', 'PM2.5') GROUP BY r.sensor_name, DATE(r.timestamp), r.variable), pivoted AS (SELECT d1.sensor_name, d1.day, d1.avg_val AS no2_val, d2.avg_val AS pm25_val FROM daily d1 JOIN daily d2 ON d1.sensor_name = d2.sensor_name AND d1.day = d2.day AND d1.variable = 'NO2' AND d2.variable = 'PM2.5') SELECT sensor_name, COUNT(*) AS overlap_days, AVG(no2_val) AS mean_no2, AVG(pm25_val) AS mean_pm25 FROM pivoted GROUP BY sensor_name ORDER BY overlap_days DESC LIMIT 3;\"},\n",
    "    {\"id\": \"T5_05\", \"tier\": \"T5\", \"domain\": \"multi_theme\",\n",
    "     \"question\": \"Produce a theme-level summary: total unique sensors, total readings, population mean value, and data span in days.\",\n",
    "     \"sql\": \"WITH theme_stats AS (SELECT v.theme, COUNT(DISTINCT r.sensor_name) AS n_sensors, COUNT(*) AS n_readings, AVG(r.value) AS pop_mean, JULIANDAY(MAX(r.timestamp)) - JULIANDAY(MIN(r.timestamp)) AS span_days FROM variables v JOIN readings r ON v.variable_name = r.variable GROUP BY v.theme) SELECT * FROM theme_stats ORDER BY n_readings DESC;\"},\n",
    "    {\"id\": \"T5_06\", \"tier\": \"T5\", \"domain\": \"air_quality\",\n",
    "     \"question\": \"Find sensor-days where at least 3 different Air Quality variables all exceeded their population mean simultaneously.\",\n",
    "     \"sql\": \"WITH pop_means AS (SELECT variable, AVG(value) AS pop_mean FROM readings WHERE variable IN (SELECT variable_name FROM variables WHERE theme = 'Air Quality') GROUP BY variable), daily_avgs AS (SELECT r.sensor_name, DATE(r.timestamp) AS day, r.variable, AVG(r.value) AS daily_avg FROM readings r WHERE r.variable IN (SELECT variable_name FROM variables WHERE theme = 'Air Quality') GROUP BY r.sensor_name, DATE(r.timestamp), r.variable), exceed AS (SELECT da.sensor_name, da.day, da.variable FROM daily_avgs da JOIN pop_means pm ON da.variable = pm.variable WHERE da.daily_avg > pm.pop_mean) SELECT sensor_name, day, COUNT(DISTINCT variable) AS vars_exceeded FROM exceed GROUP BY sensor_name, day HAVING COUNT(DISTINCT variable) >= 3 ORDER BY day;\"},\n",
    "    {\"id\": \"T5_07\", \"tier\": \"T5\", \"domain\": \"multi_theme\",\n",
    "     \"question\": \"For each sensor, compute the ratio of NO2 readings to total readings and rank sensors by this specialisation ratio.\",\n",
    "     \"sql\": \"WITH totals AS (SELECT sensor_name, COUNT(*) AS total FROM readings GROUP BY sensor_name), no2_counts AS (SELECT sensor_name, COUNT(*) AS no2_total FROM readings WHERE variable = 'NO2' GROUP BY sensor_name) SELECT t.sensor_name, COALESCE(n.no2_total, 0) AS no2_readings, t.total AS total_readings, ROUND(CAST(COALESCE(n.no2_total, 0) AS REAL) / t.total, 4) AS no2_ratio, RANK() OVER (ORDER BY CAST(COALESCE(n.no2_total, 0) AS REAL) / t.total DESC) AS ratio_rank FROM totals t LEFT JOIN no2_counts n ON t.sensor_name = n.sensor_name ORDER BY ratio_rank;\"},\n",
    "    {\"id\": \"T5_08\", \"tier\": \"T5\", \"domain\": \"air_quality\",\n",
    "     \"question\": \"Compare the hourly NO2 profile between AURN sensors and all other broker sensors.\",\n",
    "     \"sql\": \"WITH hourly AS (SELECT CASE WHEN s.broker_name = 'AURN' THEN 'AURN' ELSE 'Non-AURN' END AS source, CAST(strftime('%H', r.timestamp) AS INTEGER) AS hour, AVG(r.value) AS avg_no2, COUNT(*) AS n FROM sensors s JOIN readings r ON s.sensor_name = r.sensor_name WHERE r.variable = 'NO2' GROUP BY source, strftime('%H', r.timestamp)) SELECT source, hour, avg_no2, n FROM hourly ORDER BY source, hour;\"},\n",
    "    {\"id\": \"T5_09\", \"tier\": \"T5\", \"domain\": \"air_quality\",\n",
    "     \"question\": \"Find the top 5 days with the worst multi-pollutant air quality index (sum of normalised daily NO2 and PM2.5 averages).\",\n",
    "     \"sql\": \"WITH no2_stats AS (SELECT AVG(value) AS mu, MAX(value) - MIN(value) AS range_val FROM readings WHERE variable = 'NO2'), pm25_stats AS (SELECT AVG(value) AS mu, MAX(value) - MIN(value) AS range_val FROM readings WHERE variable = 'PM2.5'), daily AS (SELECT DATE(timestamp) AS day, variable, AVG(value) AS avg_val FROM readings WHERE variable IN ('NO2', 'PM2.5') GROUP BY DATE(timestamp), variable), normed AS (SELECT d.day, d.variable, CASE WHEN d.variable = 'NO2' THEN (d.avg_val - ns.mu) / NULLIF(ns.range_val, 0) ELSE (d.avg_val - ps.mu) / NULLIF(ps.range_val, 0) END AS norm_val FROM daily d, no2_stats ns, pm25_stats ps) SELECT day, SUM(norm_val) AS multi_pollutant_index FROM normed GROUP BY day ORDER BY multi_pollutant_index DESC LIMIT 5;\"},\n",
    "    {\"id\": \"T5_10\", \"tier\": \"T5\", \"domain\": \"multi_theme\",\n",
    "     \"question\": \"Generate a cross-tabulation of brokers vs themes, showing the count of readings in each cell.\",\n",
    "     \"sql\": \"WITH base AS (SELECT s.broker_name, v.theme, COUNT(*) AS cnt FROM sensors s JOIN readings r ON s.sensor_name = r.sensor_name JOIN variables v ON r.variable = v.variable_name GROUP BY s.broker_name, v.theme) SELECT broker_name, theme, cnt FROM base ORDER BY broker_name, theme;\"},\n",
    "    {\"id\": \"T5_11\", \"tier\": \"T5\", \"domain\": \"multi_theme\",\n",
    "     \"question\": \"Identify sensors that measure both Traffic and Air Quality themes, comparing their data volumes.\",\n",
    "     \"sql\": \"WITH aq_sensors AS (SELECT DISTINCT r.sensor_name FROM readings r JOIN variables v ON r.variable = v.variable_name WHERE v.theme = 'Air Quality'), traffic_sensors AS (SELECT DISTINCT r.sensor_name FROM readings r JOIN variables v ON r.variable = v.variable_name WHERE v.theme = 'Traffic'), both_sensors AS (SELECT a.sensor_name FROM aq_sensors a JOIN traffic_sensors t ON a.sensor_name = t.sensor_name) SELECT b.sensor_name, SUM(CASE WHEN v.theme = 'Air Quality' THEN 1 ELSE 0 END) AS aq_readings, SUM(CASE WHEN v.theme = 'Traffic' THEN 1 ELSE 0 END) AS traffic_readings FROM both_sensors b JOIN readings r ON b.sensor_name = r.sensor_name JOIN variables v ON r.variable = v.variable_name GROUP BY b.sensor_name ORDER BY aq_readings + traffic_readings DESC;\"},\n",
    "    {\"id\": \"T5_12\", \"tier\": \"T5\", \"domain\": \"air_quality\",\n",
    "     \"question\": \"Show the year-over-year change in average NO2 across all sensors (2013–present) with percentage change.\",\n",
    "     \"sql\": \"WITH yearly AS (SELECT strftime('%Y', timestamp) AS year, AVG(value) AS avg_no2, COUNT(*) AS n_readings FROM readings WHERE variable = 'NO2' GROUP BY strftime('%Y', timestamp)) SELECT year, avg_no2, n_readings, ROUND(avg_no2 - LAG(avg_no2) OVER (ORDER BY year), 4) AS yoy_change, ROUND(100.0 * (avg_no2 - LAG(avg_no2) OVER (ORDER BY year)) / NULLIF(LAG(avg_no2) OVER (ORDER BY year), 0), 2) AS pct_change FROM yearly ORDER BY year;\"},\n",
    "    {\"id\": \"T5_13\", \"tier\": \"T5\", \"domain\": \"multi_theme\",\n",
    "     \"question\": \"Identify multi-theme sensors that measure at least 3 distinct themes, ranked by theme breadth.\",\n",
    "     \"sql\": \"WITH sensor_themes AS (SELECT r.sensor_name, v.theme FROM readings r JOIN variables v ON r.variable = v.variable_name GROUP BY r.sensor_name, v.theme), theme_count AS (SELECT sensor_name, COUNT(DISTINCT theme) AS n_themes, GROUP_CONCAT(DISTINCT theme) AS theme_list FROM sensor_themes GROUP BY sensor_name) SELECT s.sensor_name, s.broker_name, tc.n_themes, tc.theme_list FROM sensors s JOIN theme_count tc ON s.sensor_name = tc.sensor_name WHERE tc.n_themes >= 3 ORDER BY tc.n_themes DESC;\"},\n",
    "    {\"id\": \"T5_14\", \"tier\": \"T5\", \"domain\": \"air_quality\",\n",
    "     \"question\": \"Seasonal analysis of NO2 (DJF=Winter, MAM=Spring, JJA=Summer, SON=Autumn) per sensor across the full archive.\",\n",
    "     \"sql\": \"WITH seasonal AS (SELECT sensor_name, CASE WHEN CAST(strftime('%m', timestamp) AS INTEGER) IN (12, 1, 2) THEN 'DJF-Winter' WHEN CAST(strftime('%m', timestamp) AS INTEGER) IN (3, 4, 5) THEN 'MAM-Spring' WHEN CAST(strftime('%m', timestamp) AS INTEGER) IN (6, 7, 8) THEN 'JJA-Summer' ELSE 'SON-Autumn' END AS season, AVG(value) AS avg_no2, COUNT(*) AS n FROM readings WHERE variable = 'NO2' GROUP BY sensor_name, season) SELECT sensor_name, season, avg_no2, n, RANK() OVER (PARTITION BY sensor_name ORDER BY avg_no2 DESC) AS season_rank FROM seasonal ORDER BY sensor_name, avg_no2 DESC;\"},\n",
    "    {\"id\": \"T5_15\", \"tier\": \"T5\", \"domain\": \"multi_theme\",\n",
    "     \"question\": \"Detect sensor-days where NO2, PM2.5, and LAeq_1min all simultaneously exceed their population means (multi-theme pollution events).\",\n",
    "     \"sql\": \"WITH pop_means AS (SELECT variable, AVG(value) AS pop_mean FROM readings WHERE variable IN ('NO2', 'PM2.5', 'LAeq_1min') GROUP BY variable), daily_avgs AS (SELECT sensor_name, DATE(timestamp) AS day, variable, AVG(value) AS daily_avg FROM readings WHERE variable IN ('NO2', 'PM2.5', 'LAeq_1min') GROUP BY sensor_name, DATE(timestamp), variable), exceed AS (SELECT da.sensor_name, da.day, da.variable FROM daily_avgs da JOIN pop_means pm ON da.variable = pm.variable WHERE da.daily_avg > pm.pop_mean) SELECT sensor_name, day, COUNT(DISTINCT variable) AS n_exceeding FROM exceed GROUP BY sensor_name, day HAVING COUNT(DISTINCT variable) = 3 ORDER BY day;\"},\n",
    "    {\"id\": \"T5_16\", \"tier\": \"T5\", \"domain\": \"air_quality\",\n",
    "     \"question\": \"Compute average NO2 stratified by sensor ground elevation tier (0–10 m, 10–20 m, 20 m+, Unknown).\",\n",
    "     \"sql\": \"WITH elevation_tiers AS (SELECT s.sensor_name, CASE WHEN s.ground_height IS NULL THEN 'Unknown' WHEN s.ground_height < 10 THEN '0-10m' WHEN s.ground_height < 20 THEN '10-20m' ELSE '20m+' END AS elev_tier FROM sensors s), tier_avg AS (SELECT et.elev_tier, AVG(r.value) AS avg_no2, COUNT(*) AS n FROM elevation_tiers et JOIN readings r ON et.sensor_name = r.sensor_name WHERE r.variable = 'NO2' GROUP BY et.elev_tier) SELECT elev_tier, avg_no2, n, RANK() OVER (ORDER BY avg_no2 DESC) AS tier_rank FROM tier_avg ORDER BY avg_no2 DESC;\"},\n",
    "    {\"id\": \"T5_17\", \"tier\": \"T5\", \"domain\": \"multi_theme\",\n",
    "     \"question\": \"Traffic-to-AQ interaction: compare hourly average Vehicle_Count with hourly average NO2 to detect temporal lag patterns.\",\n",
    "     \"sql\": \"WITH hourly_traffic AS (SELECT CAST(strftime('%H', timestamp) AS INTEGER) AS hour, AVG(value) AS avg_traffic, COUNT(*) AS n_traffic FROM readings WHERE variable = 'Vehicle_Count' GROUP BY strftime('%H', timestamp)), hourly_no2 AS (SELECT CAST(strftime('%H', timestamp) AS INTEGER) AS hour, AVG(value) AS avg_no2, COUNT(*) AS n_no2 FROM readings WHERE variable = 'NO2' GROUP BY strftime('%H', timestamp)) SELECT t.hour, t.avg_traffic, n.avg_no2, RANK() OVER (ORDER BY t.avg_traffic DESC) AS traffic_rank, RANK() OVER (ORDER BY n.avg_no2 DESC) AS no2_rank FROM hourly_traffic t JOIN hourly_no2 n ON t.hour = n.hour ORDER BY t.hour;\"},\n",
    "    {\"id\": \"T5_18\", \"tier\": \"T5\", \"domain\": \"multi_theme\",\n",
    "     \"question\": \"Sensor health audit: for each sensor and theme, compute total readings, flagged count, and flagging rate.\",\n",
    "     \"sql\": \"WITH flag_rates AS (SELECT r.sensor_name, v.theme, COUNT(*) AS total, SUM(r.flagged) AS n_flagged, ROUND(100.0 * SUM(r.flagged) / COUNT(*), 2) AS pct_flagged FROM readings r JOIN variables v ON r.variable = v.variable_name GROUP BY r.sensor_name, v.theme) SELECT f.sensor_name, s.broker_name, f.theme, f.total, f.n_flagged, f.pct_flagged FROM flag_rates f JOIN sensors s ON f.sensor_name = s.sensor_name ORDER BY f.pct_flagged DESC;\"},\n",
    "    {\"id\": \"T5_19\", \"tier\": \"T5\", \"domain\": \"air_quality\",\n",
    "     \"question\": \"Population-period comparison: compare mean NO2 for the pre-2020 period (2013–2019) vs post-2020 period (2020–present) per sensor.\",\n",
    "     \"sql\": \"WITH pre2020 AS (SELECT sensor_name, AVG(value) AS mean_no2_pre, COUNT(*) AS n_pre FROM readings WHERE variable = 'NO2' AND timestamp < '2020-01-01' GROUP BY sensor_name), post2020 AS (SELECT sensor_name, AVG(value) AS mean_no2_post, COUNT(*) AS n_post FROM readings WHERE variable = 'NO2' AND timestamp >= '2020-01-01' GROUP BY sensor_name) SELECT COALESCE(a.sensor_name, b.sensor_name) AS sensor_name, a.n_pre, a.mean_no2_pre, b.n_post, b.mean_no2_post, ROUND(b.mean_no2_post - a.mean_no2_pre, 4) AS period_change FROM pre2020 a LEFT JOIN post2020 b ON a.sensor_name = b.sensor_name ORDER BY period_change;\"},\n",
    "    {\"id\": \"T5_20\", \"tier\": \"T5\", \"domain\": \"air_quality\",\n",
    "     \"question\": \"Compute a composite air quality index per sensor per day as a weighted sum of normalised NO2 (40%), PM2.5 (35%), and PM10 (25%).\",\n",
    "     \"sql\": \"WITH daily_no2 AS (SELECT sensor_name, DATE(timestamp) AS day, AVG(value) AS avg_no2 FROM readings WHERE variable = 'NO2' GROUP BY sensor_name, DATE(timestamp)), daily_pm25 AS (SELECT sensor_name, DATE(timestamp) AS day, AVG(value) AS avg_pm25 FROM readings WHERE variable = 'PM2.5' GROUP BY sensor_name, DATE(timestamp)), daily_pm10 AS (SELECT sensor_name, DATE(timestamp) AS day, AVG(value) AS avg_pm10 FROM readings WHERE variable = 'PM10' GROUP BY sensor_name, DATE(timestamp)) SELECT COALESCE(n.sensor_name, p.sensor_name, q.sensor_name) AS sensor_name, COALESCE(n.day, p.day, q.day) AS day, ROUND(COALESCE(n.avg_no2, 0) * 0.4 + COALESCE(p.avg_pm25, 0) * 0.35 + COALESCE(q.avg_pm10, 0) * 0.25, 3) AS composite_aqi FROM daily_no2 n LEFT JOIN daily_pm25 p ON n.sensor_name = p.sensor_name AND n.day = p.day LEFT JOIN daily_pm10 q ON n.sensor_name = q.sensor_name AND n.day = q.day ORDER BY composite_aqi DESC;\"},\n",
    "    {\"id\": \"T5_21\", \"tier\": \"T5\", \"domain\": \"multi_theme\",\n",
    "     \"question\": \"Show the annual reading volume per sensor from 2013 to 2026, summarised as a year-coverage profile.\",\n",
    "     \"sql\": \"WITH year_coverage AS (SELECT sensor_name, strftime('%Y', timestamp) AS year, COUNT(*) AS n FROM readings GROUP BY sensor_name, strftime('%Y', timestamp)) SELECT sensor_name, GROUP_CONCAT(year || ':' || n, ' | ') AS annual_profile, COUNT(DISTINCT year) AS years_active, SUM(n) AS total_readings FROM year_coverage GROUP BY sensor_name ORDER BY years_active DESC, total_readings DESC;\"},\n",
    "    {\"id\": \"T5_22\", \"tier\": \"T5\", \"domain\": \"multi_theme\",\n",
    "     \"question\": \"Broker reliability report: rank brokers by their clean (non-flagged) reading percentage over the full archive.\",\n",
    "     \"sql\": \"WITH broker_quality AS (SELECT s.broker_name, COUNT(*) AS total, SUM(CASE WHEN r.flagged = 0 THEN 1 ELSE 0 END) AS clean FROM sensors s JOIN readings r ON s.sensor_name = r.sensor_name GROUP BY s.broker_name) SELECT broker_name, total, clean, ROUND(100.0 * clean / total, 2) AS pct_clean, RANK() OVER (ORDER BY 100.0 * clean / total DESC) AS quality_rank FROM broker_quality ORDER BY quality_rank;\"},\n",
    "    {\"id\": \"T5_23\", \"tier\": \"T5\", \"domain\": \"multi_theme\",\n",
    "     \"question\": \"Identify the top 10 sensors by a composite dataset completeness score (clean reading %, day coverage %, and variable breadth).\",\n",
    "     \"sql\": \"WITH coverage AS (SELECT sensor_name, COUNT(DISTINCT DATE(timestamp)) AS active_days, ROUND(JULIANDAY(MAX(timestamp)) - JULIANDAY(MIN(timestamp)), 0) AS span_days, COUNT(DISTINCT variable) AS n_vars, ROUND(100.0 * SUM(CASE WHEN flagged = 0 THEN 1 ELSE 0 END) / COUNT(*), 2) AS pct_clean FROM readings GROUP BY sensor_name), scored AS (SELECT c.sensor_name, s.broker_name, c.pct_clean, c.active_days, c.span_days, c.n_vars, ROUND(c.pct_clean * 0.3 + 100.0 * c.active_days / NULLIF(c.span_days, 0) * 0.4 + c.n_vars * 10 * 0.3, 2) AS quality_score FROM coverage c JOIN sensors s ON c.sensor_name = s.sensor_name) SELECT sensor_name, broker_name, pct_clean, active_days, span_days, n_vars, quality_score, RANK() OVER (ORDER BY quality_score DESC) AS rank FROM scored ORDER BY rank LIMIT 10;\"},\n",
    "    {\"id\": \"T5_24\", \"tier\": \"T5\", \"domain\": \"multi_theme\",\n",
    "     \"question\": \"Find sensor-days where both average LAeq_1min exceeds 65 dB AND average NO2 exceeds 40 µg/m³ (concurrent noise-pollution events).\",\n",
    "     \"sql\": \"WITH noise_days AS (SELECT sensor_name, DATE(timestamp) AS day, AVG(value) AS avg_laeq FROM readings WHERE variable = 'LAeq_1min' GROUP BY sensor_name, DATE(timestamp) HAVING AVG(value) > 65), no2_days AS (SELECT sensor_name, DATE(timestamp) AS day, AVG(value) AS avg_no2 FROM readings WHERE variable = 'NO2' GROUP BY sensor_name, DATE(timestamp) HAVING AVG(value) > 40) SELECT n.sensor_name, n.day, n.avg_laeq, p.avg_no2 FROM noise_days n JOIN no2_days p ON n.sensor_name = p.sensor_name AND n.day = p.day ORDER BY n.day;\"},\n",
    "    {\"id\": \"T5_25\", \"tier\": \"T5\", \"domain\": \"air_quality\",\n",
    "     \"question\": \"Long-term NO2 trend: compare first-year mean vs last-year mean per sensor to quantify 10-year air quality change.\",\n",
    "     \"sql\": \"WITH sensor_years AS (SELECT sensor_name, strftime('%Y', timestamp) AS yr, AVG(value) AS mean_no2 FROM readings WHERE variable = 'NO2' GROUP BY sensor_name, strftime('%Y', timestamp)), bounds AS (SELECT sensor_name, MIN(yr) AS first_yr, MAX(yr) AS last_yr FROM sensor_years GROUP BY sensor_name) SELECT b.sensor_name, b.first_yr AS first_year, ROUND(f.mean_no2, 3) AS first_yr_mean, b.last_yr AS last_year, ROUND(l.mean_no2, 3) AS last_yr_mean, ROUND(l.mean_no2 - f.mean_no2, 3) AS long_term_delta FROM bounds b JOIN sensor_years f ON b.sensor_name = f.sensor_name AND b.first_yr = f.yr JOIN sensor_years l ON b.sensor_name = l.sensor_name AND b.last_yr = l.yr ORDER BY long_term_delta;\"},\n",
    "    {\"id\": \"T5_26\", \"tier\": \"T5\", \"domain\": \"multi_theme\",\n",
    "     \"question\": \"Weather-pollution interaction: compare average NO2 on wet days (rainfall > 1 mm) vs dry days.\",\n",
    "     \"sql\": \"WITH daily_rainfall AS (SELECT sensor_name, DATE(timestamp) AS day, SUM(value) AS total_rain_mm FROM readings WHERE variable = 'Rainfall' GROUP BY sensor_name, DATE(timestamp)), daily_no2 AS (SELECT sensor_name, DATE(timestamp) AS day, AVG(value) AS avg_no2 FROM readings WHERE variable = 'NO2' GROUP BY sensor_name, DATE(timestamp)) SELECT CASE WHEN r.total_rain_mm > 1 THEN 'Wet day (>1 mm)' ELSE 'Dry day (≤1 mm)' END AS day_type, AVG(n.avg_no2) AS avg_no2, COUNT(*) AS n_sensor_days FROM daily_no2 n JOIN daily_rainfall r ON n.sensor_name = r.sensor_name AND n.day = r.day GROUP BY day_type;\"},\n",
    "    {\"id\": \"T5_27\", \"tier\": \"T5\", \"domain\": \"multi_theme\",\n",
    "     \"question\": \"Identify sensors with statistically anomalous flagging rates (exceeding population mean + 2 population standard deviations).\",\n",
    "     \"sql\": \"WITH flag_rates AS (SELECT sensor_name, ROUND(100.0 * SUM(flagged) / COUNT(*), 4) AS pct_flagged FROM readings GROUP BY sensor_name), pop_stats AS (SELECT AVG(pct_flagged) AS pop_mean, AVG(pct_flagged*pct_flagged) - AVG(pct_flagged)*AVG(pct_flagged) AS pop_variance FROM flag_rates) SELECT f.sensor_name, f.pct_flagged, s.pop_mean, ROUND(s.pop_mean + 2 * SQRT(s.pop_variance), 4) AS threshold_2sd, ROUND(f.pct_flagged - s.pop_mean, 4) AS excess FROM flag_rates f, pop_stats s WHERE f.pct_flagged > s.pop_mean + 2 * SQRT(s.pop_variance) ORDER BY f.pct_flagged DESC;\"},\n",
    "    {\"id\": \"T5_28\", \"tier\": \"T5\", \"domain\": \"air_quality\",\n",
    "     \"question\": \"Show the hourly profile of all four core AQ variables (NO2, PM2.5, PM10, O3) simultaneously across the full archive.\",\n",
    "     \"sql\": \"WITH hourly_aq AS (SELECT CAST(strftime('%H', timestamp) AS INTEGER) AS hour, variable, AVG(value) AS avg_val, COUNT(*) AS n FROM readings WHERE variable IN ('NO2', 'PM2.5', 'PM10', 'O3') GROUP BY strftime('%H', timestamp), variable) SELECT hour, MAX(CASE WHEN variable = 'NO2'   THEN avg_val END) AS avg_no2, MAX(CASE WHEN variable = 'PM2.5' THEN avg_val END) AS avg_pm25, MAX(CASE WHEN variable = 'PM10'  THEN avg_val END) AS avg_pm10, MAX(CASE WHEN variable = 'O3'    THEN avg_val END) AS avg_o3 FROM hourly_aq GROUP BY hour ORDER BY hour;\"},\n",
    "    {\"id\": \"T5_29\", \"tier\": \"T5\", \"domain\": \"air_quality\",\n",
    "     \"question\": \"Compute the week-by-week NO2 trend for the full 2013–present archive, including a 5-week rolling average and week-on-week change.\",\n",
    "     \"sql\": \"WITH weekly AS (SELECT strftime('%Y-%W', timestamp) AS week, AVG(value) AS avg_no2, COUNT(*) AS n FROM readings WHERE variable = 'NO2' GROUP BY strftime('%Y-%W', timestamp)) SELECT week, avg_no2, n, AVG(avg_no2) OVER (ORDER BY week ROWS BETWEEN 4 PRECEDING AND CURRENT ROW) AS rolling_5week_avg, ROUND(avg_no2 - LAG(avg_no2) OVER (ORDER BY week), 4) AS wow_change FROM weekly ORDER BY week;\"},\n",
    "    {\"id\": \"T5_30\", \"tier\": \"T5\", \"domain\": \"multi_theme\",\n",
    "     \"question\": \"Strategic sensor ranking: score and rank all sensors by data quality (30%), temporal coverage (40%), and thematic breadth (30%).\",\n",
    "     \"sql\": \"WITH base AS (SELECT sensor_name, ROUND(100.0 * SUM(CASE WHEN flagged=0 THEN 1 ELSE 0 END)/COUNT(*), 2) AS pct_clean, COUNT(DISTINCT DATE(timestamp)) AS active_days, ROUND(JULIANDAY(MAX(timestamp)) - JULIANDAY(MIN(timestamp)), 0) AS span_days, COUNT(DISTINCT variable) AS n_vars FROM readings GROUP BY sensor_name), maxes AS (SELECT MAX(active_days) AS max_active, MAX(n_vars) AS max_vars FROM base), scored AS (SELECT b.sensor_name, s.broker_name, b.pct_clean, b.active_days, b.span_days, b.n_vars, ROUND(b.pct_clean * 0.30 + 100.0 * b.active_days / NULLIF(m.max_active, 0) * 0.40 + 100.0 * b.n_vars / NULLIF(m.max_vars, 0) * 0.30, 2) AS composite_score FROM base b JOIN sensors s ON b.sensor_name = s.sensor_name, maxes m) SELECT sensor_name, broker_name, pct_clean, active_days, span_days, n_vars, composite_score, RANK() OVER (ORDER BY composite_score DESC) AS overall_rank FROM scored ORDER BY overall_rank LIMIT 20;\"},\n",
    "]\n",
    "\n",
    "# ── Summary ───────────────────────────────────────────────────────────────────\n",
