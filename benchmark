    "    print(f\"  {tier}: {count} questions | domains: {sorted(domains)}\")\n",
    "\n",
    "# ── Save ──────────────────────────────────────────────────────────────────────\n",
    "import os\n",
    "os.makedirs('data_export', exist_ok=True)\n",
