    "    analysis[\"mann_whitney\"] = pd.DataFrame(mwu_results)\n",
    "\n",
    "    # ── Kruskal-Wallis: tier-wise accuracy differences ────────────────────\n",
    "    kw_results: list[dict[str, object]] = []\n",
    "    for _key2, grp in df.groupby([\"strategy\", \"model_label\"]):\n",
    "        strategy, model = tuple(_key2) if isinstance(_key2, tuple) else (_key2, \"\")\n",
    "        tier_groups = [grp[grp[\"tier\"] == t][\"correct\"].tolist()\n",
    "                       for t in [\"T1\", \"T2\", \"T3\", \"T4\", \"T5\"]]\n",
    "        tier_groups = [g for g in tier_groups if g]\n",
    "        if len(tier_groups) < 2:\n",
    "            continue\n",
    "        stat, p = kruskal(*tier_groups)\n",
    "        kw_results.append({\n",
    "            \"strategy\": strategy, \"model\": model,\n",
    "            \"H_statistic\": round(stat, 4), \"p_kruskal\": round(p, 6),\n",
    "            \"significant\": p < 0.05,\n",
    "        })\n",
    "    analysis[\"kruskal_wallis\"] = pd.DataFrame(kw_results)\n",
    "\n",
    "    # ── Fisher's Exact: strategy comparisons ──────────────────────────────\n",
    "    fisher_results: list[dict[str, object]] = []\n",
    "    for i, s1 in enumerate(strategies):\n",
    "        for s2 in strategies[i + 1:]:\n",
    "            for model in models:\n",
    "                d1 = df[(df[\"strategy\"] == s1) & (df[\"model_label\"] == model)]\n",
    "                d2 = df[(df[\"strategy\"] == s2) & (df[\"model_label\"] == model)]\n",
    "                if d1.empty or d2.empty:\n",
    "                    continue\n",
    "                _s1 = d1[\"correct\"].sum()  # type: ignore[assignment]\n",
    "                _s2 = d2[\"correct\"].sum()  # type: ignore[assignment]\n",
    "                a, b   = int(_s1), int(len(d1) - int(_s1))  # type: ignore[arg-type]\n",
    "                c, dv  = int(_s2), int(len(d2) - int(_s2))  # type: ignore[arg-type]\n",
    "                or_, p = fisher_exact([[a, b], [c, dv]])\n",
    "                h      = cohens_h(a / len(d1), c / len(d2))\n",
    "                fisher_results.append({\n",
    "                    \"comparison\": f\"{s1} vs {s2}\", \"model\": model,\n",
    "                    \"odds_ratio\": round(float(or_), 4), \"p_fisher\": round(float(p), 6),  # pyright: ignore[reportArgumentType]\n",
    "                    \"cohens_h\": h, \"significant\": p < 0.05,\n",
    "                })\n",
    "    analysis[\"fisher\"] = pd.DataFrame(fisher_results)\n",
    "\n",
    "    # ── McNemar's: paired question-level comparison ───────────────────────\n",
    "    mcnemar_results: list[dict[str, object]] = []\n",
    "    if \"question_id\" in df.columns:\n",
    "        for i, s1 in enumerate(strategies):\n",
    "            for s2 in strategies[i + 1:]:\n",
    "                for model in models:\n",
    "                    d1 = df[(df[\"strategy\"] == s1) & (df[\"model_label\"] == model)].set_index(\"question_id\")\n",
    "                    d2 = df[(df[\"strategy\"] == s2) & (df[\"model_label\"] == model)].set_index(\"question_id\")\n",
    "                    common = d1.index.intersection(d2.index)\n",
    "                    if len(common) < 5:\n",
    "                        continue\n",
    "                    y1    = d1.loc[common, \"correct\"].astype(int).values\n",
    "                    y2    = d2.loc[common, \"correct\"].astype(int).values\n",
    "                    b_cnt = int(((y1 == 1) & (y2 == 0)).sum())  # s1 correct, s2 wrong\n",
    "                    c_cnt = int(((y1 == 0) & (y2 == 1)).sum())  # s1 wrong, s2 correct\n",
    "                    table = [[int(((y1==1)&(y2==1)).sum()), b_cnt],\n",
    "                             [c_cnt, int(((y1==0)&(y2==0)).sum())]]\n",
    "                    result = _mcnemar_exact(table)\n",
    "                    mcnemar_results.append({\n",
    "                        \"comparison\": f\"{s1} vs {s2}\", \"model\": model,\n",
    "                        \"b (s1+,s2-)\": b_cnt, \"c (s1-,s2+)\": c_cnt,\n",
    "                        \"p_mcnemar\": round(result.pvalue, 6),\n",
    "                        \"significant\": result.pvalue < 0.05,\n",
    "                    })\n",
    "    analysis[\"mcnemar\"] = pd.DataFrame(mcnemar_results)\n",
    "\n",
    "    # ── Multiple-comparison correction (across all Fisher tests) ──────────\n",
    "    if not analysis[\"fisher\"].empty:\n",
    "        pvals   = analysis[\"fisher\"][\"p_fisher\"].tolist()\n",
    "        analysis[\"fisher\"][\"p_bonferroni\"] = bonferroni_correction(pvals)\n",
    "        analysis[\"fisher\"][\"p_holm\"]       = holm_bonferroni(pvals)\n",
    "        analysis[\"fisher\"][\"p_bh_fdr\"]     = benjamini_hochberg(pvals)\n",
    "        analysis[\"fisher\"][\"sig_bonf\"]     = analysis[\"fisher\"][\"p_bonferroni\"] < 0.05\n",
    "        analysis[\"fisher\"][\"sig_holm\"]     = analysis[\"fisher\"][\"p_holm\"]       < 0.05\n",
    "        analysis[\"fisher\"][\"sig_bh\"]       = analysis[\"fisher\"][\"p_bh_fdr\"]     < 0.05\n",
    "\n",
    "    return analysis\n",
    "\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "# 19H. Verification with synthetic data\n",
