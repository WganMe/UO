[\"id\"],\n","                \"tier\": q[\"tier\"],\n","                \"domain\": q[\"domain\"],\n","                \"question\": q[\"question\"],\n","                \"ground_truth_sql\": q[\"sql\"],\n","                \"generated_sql\": generated_sql,\n","                \"raw_response\": raw_response,\n","                \"prompt_tokens\": prompt_tokens,\n","                \"rho_exposure\": rho,\n","                \"latency_s\": round(latency, 2),\n","                \"anomaly_safe\": anomaly[\"safe\"],\n","                \"anomaly_flags\": anomaly.get(\"flags\", []),\n","                \"executed\": eval_result[\"executed\"],\n","                \"correct\": eval_result[\"correct\"],\n","                \"error\": eval_result.get(\"error\"),\n","                \"result_rows\": eval_result.get(\"rows\", 0),\n","                \"timestamp\": _dt.now(_tz.utc).isoformat(),\n","            }\n","            records.append(record)\n","\n","            status = \"PASS\" if record[\"correct\"] else (\"EXEC\" if record[\"executed\"] else \"FAIL\")\n","            print(f\"  [{done}/{total}] {q['id']} ({q['tier']}): {status} ({latency:.1f}s)\")\n","    if _own_conn:\n","        conn.close()\n","    df_results = pd.DataFrame(records)\n","    return df_results\n","\n","print(\"Evaluation pipeline defined: run_benchmark()\")\n","\n","print(f\"Total evaluations per run: {len(MODEL_PANEL)} models × {len(BENCHMARK_QUESTIONS)} questions = {len(MODEL_PANEL) * len(BENCHMARK_QUESTIONS)}\")\n"]},{"cell_type":"code","execution_count":33,"id":"d686fe3f","metadata":{"execution":{"iopub.execute_input":"2026-08-30T04:58:18.332543Z","iopub.status.busy":"2026-08-30T04:58:18.332147Z","iopub.status.idle":"2026-08-30T04:58:21.521243Z","shell.execute_reply":"2026-08-30T04:58:21.519234Z"},"papermill":{"duration":3.259328,"end_time":"2026-08-30T04:58:21.524221","exception":false,"start_time":"2026-08-30T04:58:18.264893","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","out