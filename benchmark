    "# pyright: reportUnknownMemberType=false, reportUnknownVariableType=false, reportUnknownArgumentType=false, reportMissingTypeStubs=false, reportIndexIssue=false, reportUnknownParameterType=false, reportAttributeAccessIssue=false, reportCallIssue=false, reportOperatorIssue=false, reportConstantRedefinition=false, reportPossiblyUnboundVariable=false, reportMissingImports=false, reportUnnecessaryIsInstance=false, reportPrivateImportUsage=false, reportMissingParameterType=false, reportUnusedImport=false, reportArgumentType=false, reportMissingTypeArgument=false, reportUndefinedVariable=false, reportGeneralTypeIssues=false, reportOptionalMemberAccess=false, reportOptionalSubscript=false, reportOptionalIterable=false, reportOptionalCall=false, reportReturnType=false, reportAssignmentType=false, reportOptionalOperand=false, reportUnnecessaryComparison=false, reportUnusedFunction=false, reportUnusedVariable=false, reportUnboundVariable=false, reportUnknownLambdaType=false, reportUnusedClass=false\n",
    "def compute_rho_exposure(question: str, strategy: str) -> float:\n",
    "    \"\"\"Compute schema exposure ratio for a given question and strategy.\"\"\"\n",
    "    if strategy == \"few_shot\":\n",
    "        return 1.0  # Full DDL always included\n",
    "\n",
    "    if strategy == \"naive\":\n",
    "        retrieved_keys = retrieve_naive(question)\n",
    "    elif strategy == \"enhanced\":\n",
    "        retrieved_keys = retrieve_enhanced(question)\n",
    "    else:\n",
    "        return 1.0\n",
    "\n",
    "    schema_fragment = \"\\\n",
    "\\\n",
    "\".join(SCHEMA_CHUNKS[k] for k in retrieved_keys)\n",
    "    fragment_tokens = len(enc.encode(schema_fragment))\n",
    "    return round(fragment_tokens / SCHEMA_TOKEN_COUNT, 4)\n",
    "\n",
    "# ── Compute average ρ_exposure per strategy ──────────────────\n",
    "for strategy in [\"few_shot\", \"naive\", \"enhanced\"]:\n",
    "    rhos = [compute_rho_exposure(q[\"question\"], strategy) for q in BENCHMARK_QUESTIONS]\n",
    "    mean_rho = np.mean(rhos)\n",
    "    min_rho = np.min(rhos)\n",
    "    max_rho = np.max(rhos)\n",
    "    print(f\"{strategy:15s}: ρ_exposure = {mean_rho:.4f} (min={min_rho:.4f}, max={max_rho:.4f})\")\n",
    "\n",
    "# ── Per-tier breakdown for enhanced RAG ──────────────────────\n",
    "print(\"\\\n",
    "Enhanced RAG ρ_exposure by tier:\")\n",
    "for tier in [\"T1\", \"T2\", \"T3\", \"T4\", \"T5\"]:\n",
    "    tier_qs = [q for q in BENCHMARK_QUESTIONS if q[\"tier\"] == tier]\n",
    "    rhos = [compute_rho_exposure(q[\"question\"], \"enhanced\") for q in tier_qs]\n",
    "    print(f\"  {tier}: {np.mean(rhos):.4f} (n={len(tier_qs)})\")"
