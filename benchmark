    "# pyright: reportUnknownMemberType=false, reportUnknownVariableType=false, reportUnknownArgumentType=false, reportMissingTypeStubs=false, reportIndexIssue=false, reportUnknownParameterType=false, reportAttributeAccessIssue=false, reportCallIssue=false, reportOperatorIssue=false, reportConstantRedefinition=false, reportPossiblyUnboundVariable=false, reportMissingImports=false, reportUnnecessaryIsInstance=false, reportPrivateImportUsage=false, reportMissingParameterType=false, reportUnusedImport=false, reportArgumentType=false, reportMissingTypeArgument=false, reportUndefinedVariable=false, reportGeneralTypeIssues=false, reportOptionalMemberAccess=false, reportOptionalSubscript=false, reportOptionalIterable=false, reportOptionalCall=false, reportReturnType=false, reportAssignmentType=false, reportOptionalOperand=false, reportUnnecessaryComparison=false, reportUnusedFunction=false, reportUnusedVariable=false, reportUnboundVariable=false, reportUnknownLambdaType=false, reportUnusedClass=false\n",
    "import math\n",
    "from collections.abc import Callable, Sequence\n",
    "from typing import Any\n",
    "import numpy as np\n",
    "from scipy import stats\n",
    "from scipy.stats import (mannwhitneyu, kruskal,\n",
    "                         shapiro, kstest, fisher_exact,\n",
    "                         binomtest)\n",
    "\n",
    "def _mcnemar_exact(table):\n",
    "    \"\"\"Exact McNemar test (two-sided binomial on discordant cells).\"\"\"\n",
    "    b, c = table[0][1], table[1][0]\n",
    "    n = b + c\n",
    "    if n == 0:\n",
    "        return type('R', (), {'pvalue': 1.0})()\n",
    "    return binomtest(b, n, 0.5, alternative='two-sided')\n",
    "\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "# 19A. Wilson Score Confidence Interval (95%)\n",
    "#      Walpole et al. (2017) §9.3 — for accuracy proportions\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "def wilson_ci(successes: int, n: int, alpha: float = 0.05) -> tuple[float, float]:\n",
    "    \"\"\"Wilson score 95% CI for a proportion. Returns (lower, upper).\"\"\"\n",
    "    if n == 0:\n",
    "        return (0.0, 0.0)\n",
    "    z      = float(stats.norm.ppf(1 - alpha / 2))\n",
    "    p_hat  = successes / n\n",
    "    denom  = 1 + z**2 / n\n",
    "    centre = (p_hat + z**2 / (2 * n)) / denom\n",
    "    margin = z * math.sqrt((p_hat * (1 - p_hat) + z**2 / (4 * n)) / n) / denom\n",
    "    return (round(max(centre - margin, 0), 4), round(min(centre + margin, 1), 4))\n",
    "\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "# 19B. Cohen's h — Effect size for two proportions\n",
    "#      Walpole et al. (2017) §9.4\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "def cohens_h(p1: float, p2: float) -> float:\n",
    "    \"\"\"Cohen's h effect size. |h| < 0.2 = small, 0.5 = medium, 0.8 = large.\"\"\"\n",
    "    return round(2 * (math.asin(math.sqrt(max(p1, 0))) -\n",
    "                      math.asin(math.sqrt(max(p2, 0)))), 4)\n",
    "\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "# 19C. Cliff's Delta — Non-parametric effect size\n",
    "#      Lind et al. (2021) §15.4; range −1 to +1\n",
    "#      |d| < 0.147 = negligible, 0.33 = medium, 0.474 = large\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "def cliffs_delta(x: list[float], y: list[float]) -> float:\n",
    "    \"\"\"Cliff's delta non-parametric effect size between two samples.\"\"\"\n",
    "    n, m    = len(x), len(y)\n",
    "    greater = sum(1 for xi in x for yi in y if xi > yi)\n",
    "    less    = sum(1 for xi in x for yi in y if xi < yi)\n",
    "    return round((greater - less) / (n * m), 4)\n",
    "\n",
    "def cliffs_delta_label(d: float) -> str:\n",
    "    a = abs(d)\n",
    "    if a < 0.147: return \"negligible\"\n",
    "    if a < 0.330: return \"small\"\n",
    "    if a < 0.474: return \"medium\"\n",
    "    return \"large\"\n",
    "\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "# 19D. Bootstrap Confidence Interval\n",
    "#      Lind et al. (2021) Appendix — non-parametric, model-free\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "def bootstrap_ci(data: Sequence[float], stat_fn: Callable[..., Any] = np.mean, n_boot: int = 5000,\n",
    "                 alpha: float = 0.05, seed: int = 42) -> tuple[float, float]:\n",
    "    \"\"\"Bootstrap percentile CI. Works for any statistic (mean, median, std).\"\"\"\n",
    "    rng      = np.random.default_rng(seed)\n",
    "    samples  = [stat_fn(rng.choice(data, size=len(data), replace=True))\n",
    "                for _ in range(n_boot)]\n",
    "    lo = round(float(np.percentile(samples, 100 * alpha / 2)), 4)\n",
    "    hi = round(float(np.percentile(samples, 100 * (1 - alpha / 2))), 4)\n",
    "    return (lo, hi)\n",
    "\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "# 19E. Normality Testing\n",
    "#      Walpole §13.2 — Shapiro-Wilk (n < 5 000), Kolmogorov-Smirnov (larger)\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "def test_normality(data: Sequence[float], alpha: float = 0.05) -> dict[str, object]:\n",
    "    \"\"\"Run Shapiro-Wilk (n < 5000) or KS test. Returns dict with result.\"\"\"\n",
    "    n = len(data)\n",
    "    if n < 3:\n",
    "        return {\"test\": \"insufficient_data\", \"statistic\": None, \"p\": None,\n",
    "                \"normal\": None}\n",
    "    if n < 5000:\n",
    "        stat, p = shapiro(data)\n",
    "        test_name = \"Shapiro-Wilk\"\n",
    "    else:\n",
    "        stat, p = kstest(data, 'norm',\n",
    "                         args=(float(np.mean(data)), float(np.std(data, ddof=1))))\n",
    "        test_name = \"Kolmogorov-Smirnov\"\n",
    "    return {\"test\": test_name, \"statistic\": round(stat, 4),\n",
    "            \"p\": round(p, 6), \"normal\": bool(p >= alpha)}\n",
    "\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "# 19F. Multiple-Comparison Correction\n",
    "#      Walpole §13.6 — Bonferroni; Benjamini-Hochberg FDR\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "def bonferroni_correction(p_values: list[float]) -> list[float]:\n",
    "    \"\"\"Bonferroni: multiply each p by n_tests, clip at 1.\"\"\"\n",
    "    n = len(p_values)\n",
    "    return [min(round(p * n, 6), 1.0) for p in p_values]\n",
    "\n",
    "def holm_bonferroni(p_values: list[float]) -> list[float | None]:\n",
    "    \"\"\"Holm-Bonferroni step-down correction. Less conservative than Bonferroni.\"\"\"\n",
    "    n    = len(p_values)\n",
    "    idx  = sorted(range(n), key=lambda i: p_values[i])\n",
    "    adj: list[float | None]  = [None] * n\n",
    "    prev = 0.0\n",
    "    for rank, i in enumerate(idx):\n",
    "        adj_p = min(p_values[i] * (n - rank), 1.0)\n",
    "        adj_p = max(adj_p, prev)   # monotonicity\n",
    "        adj[i] = round(adj_p, 6)\n",
    "        prev   = adj_p\n",
    "    return adj\n",
    "\n",
    "def benjamini_hochberg(p_values: list[float]) -> list[float | None]:\n",
    "    \"\"\"Benjamini-Hochberg FDR correction.\"\"\"\n",
    "    n   = len(p_values)\n",
    "    idx = sorted(range(n), key=lambda i: p_values[i])\n",
    "    adj: list[float | None] = [None] * n\n",
    "    cum_min = 1.0\n",
    "    for rank in range(n - 1, -1, -1):\n",
    "        i         = idx[rank]\n",
    "        adj_p     = p_values[i] * n / (rank + 1)\n",
    "        cum_min   = min(cum_min, adj_p)\n",
    "        adj[i]    = round(min(cum_min, 1.0), 6)\n",
    "    return adj\n",
    "\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "# 19G. Full Analysis Function\n",
    "#      Runs on completed benchmark results DataFrame\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "def analyse_benchmark_results(df: pd.DataFrame) -> dict[str, object]:\n",
    "    \"\"\"\n",
    "    Comprehensive PhD-level statistical analysis of benchmark results.\n",
    "\n",
    "    Tests run per Walpole et al. (2017) and Lind et al. (2021):\n",
    "    - Wilson CI on overall accuracy proportions\n",
    "    - Normality test on per-question accuracy vectors\n",
    "    - Mann-Whitney U for pairwise model comparisons (non-parametric)\n",
    "    - Kruskal-Wallis for tier-wise accuracy differences (non-parametric)\n",
    "    - Fisher's exact for strategy comparisons (few-shot vs RAG)\n",
    "    - McNemar's for paired question-level comparison\n",
    "    - Bonferroni + Holm-BH + BH-FDR multiple comparison corrections\n",
    "    - Cliff's delta effect sizes\n",
    "    - Bootstrap CIs on accuracy proportions\n",
    "    \"\"\"\n",
    "    analysis: dict[str, Any] = {}\n",
    "\n",
    "    # ── Overall accuracy by model × strategy ──────────────────────────────\n",
    "    summary = df.groupby([\"strategy\", \"model_label\"]).agg(\n",
