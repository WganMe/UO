() for m in MODEL_PANEL}\n","        for _q in BENCHMARK_QUESTIONS:\n","            for _m in MODEL_PANEL:\n","                if (str(_q[\"id\"]), str(_m)) not in _done:\n","                    _pending[_m].append(_q)\n","        _total = sum(len(v) for v in _pending.values())\n","        _models_active = [m for m in MODEL_PANEL if _pending[m]]\n","        _skip_msg = f\" ({len(_done)} already done, skipped)\" if _done else \"\"\n","        print(f\"  Work queue: {_total} pending calls \"\n","              f\"across {len(_models_active)} models{_skip_msg}\")\n","\n","        # Catch the unified ModelCooled (parent of GitHubModelCooled,\n","        # KBenchModelCooled) so the loop rotates whichever provider is failing.\n","        _COOLED_CLS = globals().get(\"ModelCooled\", type(\"X\", (Exception,), {}))\n","        _gh_cool_reg = globals().get(\"_GH_COOLDOWN\", {})\n","        _gh_avail_fn = globals().get(\"_gh_available\", lambda m: True)\n","\n","        _consecutive_stalls = 0\n","        while _models_active:\n","            _progress = False\n","            for _model in list(_models_active):\n","                if not _pending[_model]:\n","                    _models_active.remove(_model); continue\n","                # Skip GitHub Models that are still in cooldown.\n","                if not _gh_avail_fn(_model):\n","                    continue\n","                    continue\n","                _q = _pending[_model].popleft()\n","                _i += 1\n","                _prompt = _build_prompt(_q[\"question\"])\n","                _t0 = time.time()\n","                try:\n","                    _raw = github_models_chat(\n","                        [{\"role\": \"user\", \"content\": _prompt}],\n","                        model=_model, max_tokens=512, temperature=0.0,\n","                        retries=1,\n","                    )\n","                except _COOLED_CLS as _ec:\n","                    _pending[_model].appendleft(_q); _i -= 1\n","                    _wait_s = max(0.0, getattr(_ec, \"soonest_avail\", 0.0) - time.time())\n","                    _disp = _model.split('/')[-1] or _model\n","                    if _disp in ('free', ''):\n","                        _disp = _model\n","                    _reason = getattr(_ec, \"reason\", \"cooled\")\n","                    print(f\"  ~ {_disp} cooled ~{_wait_s:.0f}s \"\n","                          f\"({_reason}); switching model\")\n","                    # Drop the model from the active rotation if its cooldown\n","                    # is longer than the rest of the run is likely to take\n","                    # (≥1 h) — keeps the loop fast.\n","                    if _wait_s > 3600 and _model in _models_active:\n","                        _models_active.remove(_model)\n","                        print(f\"    (removed {_disp} from active rotation: \"\n","                              f\"cooled >1h)\")\n","                    continue\n","                except Exception as _e:\n","                    _raw = f\"ERROR: {_e}\"\n","                _lat = time.time() - _t0\n","                _gen = _extract_sql(_raw) or \"\"\n","                _gold_rows, _gold_err = _run_sql(DB_PATH, _q[\"sql\"])\n","                _err_msg, _correct = \"\", False\n","                if _gold_err:\n","                    _err_msg = f\"gold-error: {_gold_err}\"\n","                elif not _gen:\n","                    _err_msg = \"empty SQL\"\n","                else:\n","                    _gen_rows, _sql_err = _run_sql(DB_PATH, _gen)\n","                    if _sql_err:\n","                        # ── Self-correction: one retry with error feedback ──\n","                        try:\n","                            _fix_prompt = (\n","                                f\"Your SQL query:\\n{_gen}\\n\\n\"\n","                                f\"failed with error: {_sql_err}\\n\\n\"\n","                                f\"Original question: {_q['question']}\\n\"\n","                                f\"Fix the query using only standard SQLite \"\n","                                f\"functions and columns from the schema.\"\n","                            )\n","                            _raw2 = github_models_chat(\n","                                [{\"role\": \"user\", \"content\": _prompt},\n","                                 {\"role\": \"assistant\", \"content\": _gen},\n","                                 {\"role\": \"user\", \"content\": _fix_prompt}],\n","                                model=_model, max_tokens=512, temperature=0.0,\n","                                retries=1,\n","                            )\n","                            _gen2 = _extract_sql(_raw2) or \"\"\n","                            if _gen2 and _gen2 != _gen:\n","                                _gen_rows2, _sql_err2 = _run_sql(DB_PATH, _gen2)\n","                                if not _sql_err2:\n","                                    _gen, _gen_rows, _sql_err = _gen2, _gen_rows2, \"\"\n","                                    print(f\"    \\u21bb self-corrected\")\n","                        except _COOLED_CLS:\n","                            pass  # skip retry if model is cooled\n","                        except Exception:\n","                            pass  # skip retry on any other error\n","                    if _sql_err:\n","                        _err_msg = _sql_err\n","                    else:\n","                        _correct = _rows_equal(_gen_rows, _gold_rows)\n","                _row = {\n","                    \"q_id\": _q[\"id\"], \"tier\": _q[\"tier\"],\n","                    \"domain\": _q.get(\"domain\", \"\"), \"model\": _model,\n","                    \"question\": _q[\"question\"], \"gold_sql\": _q[\"sql\"],\n","                    \"generated_sql\": _gen, \"correct\": int(_correct),\n","                    \"error_msg\": _err_msg, \"latency_s\": round(_lat, 2),\n","                }\n","                _writer.writerow(_row); _fout.flush()\n","                if _i % 200 == 0 or _i == 50:\n","                    _snapshot_results_csv(reason=f\"@row{_i}\")\n","                _status = \"PASS\" if _correct else (\"ERR\" if _err_msg else \"WRONG\")\n","                _disp = _model.split('/')[-1] or _model\n","                if _disp in ('free', ''):\n","                    _disp = _model\n","                print(f\"  [{_i}/{_total}] {_q['id']} {_q['tier']} \"\n","                      f\"{_disp}: {_status} ({_lat:.1f}s)\")\n","                _progress = True\n","                _consecutive_stalls = 0\n","                time.sleep(INTER_PAUSE)\n","                if not _pending[_model]:\n","                    _models_active.remove(_model)\n","            # All active models tried this round — sleep until the soonest\n","            # cooled model becomes available (capped 5-120s).\n","            if not _progress and _models_active:\n","                _now = time.time()\n","                _gh_ts = [t for (m, t) in _gh_cool_reg.items()\n","                          if m in _models_active and t > _now]\n","                _ol_ts = [t for (m, t) in _ol_reg.items()\n","                          if m in _models_active and t > _now]\n","                _kb_reg = globals().get(\"_KBENCH_COOLDOWN\", {})\n","                _kb_ts = [t for (m, t) in _kb_reg.items()\n","                          if f\"kbench/{m}\" in _models_active and t > _now]\n","                _ts = _gh_ts + _ol_ts + _kb_ts\n","                _wait = (min(_ts) - _now) if _ts else 30.0\n","                _wait = max(5.0, min(_wait, 120.0))\n","                _consecutive_stalls += 1\n","                if _consecutive_stalls >= 3:\n","                    _stuck = list(_models_active)\n","                    _stuck_disp = [m.split(\"/\")[-1] for m in _stuck]\n","                    print(f\"  ⛔ {_consecutive_stalls} consecutive stalls — \"\n","                          f\"dropping stuck models: {_stuck_dis