    "# pyright: reportUnknownMemberType=false, reportUnknownVariableType=false, reportUnknownArgumentType=false, reportMissingTypeStubs=false, reportIndexIssue=false, reportUnknownParameterType=false, reportAttributeAccessIssue=false, reportCallIssue=false, reportOperatorIssue=false, reportConstantRedefinition=false, reportPossiblyUnboundVariable=false, reportMissingImports=false, reportUnnecessaryIsInstance=false, reportPrivateImportUsage=false, reportMissingParameterType=false, reportUnusedImport=false, reportArgumentType=false, reportMissingTypeArgument=false, reportUndefinedVariable=false, reportGeneralTypeIssues=false, reportOptionalMemberAccess=false, reportOptionalSubscript=false, reportOptionalIterable=false, reportOptionalCall=false, reportReturnType=false, reportAssignmentType=false, reportOptionalOperand=false, reportUnnecessaryComparison=false, reportUnusedFunction=false, reportUnusedVariable=false, reportUnboundVariable=false, reportUnknownLambdaType=false, reportUnusedClass=false\n",
    "import re\n",
    "\n",
    "# Known schema elements\n",
    "VALID_TABLES = {\"sensors\", \"variables\", \"readings\"}\n",
    "VALID_COLUMNS = {\n",
    "    \"sensor_name\", \"location_wkt\", \"centroid_lon\", \"centroid_lat\",\n",
    "    \"ground_height\", \"sensor_height\", \"broker_name\", \"raw_id\",\n",
    "    \"variable_name\", \"units\", \"theme\",\n",
    "    \"id\", \"variable\", \"value\", \"timestamp\", \"flagged\",\n",
    "}\n",
    "\n",
    "# CTE aliases allowed in R3 check\n",
    "_KNOWN_ALIASES = {\n",
    "    'sub', 'subquery', 'd', 'd1', 'd2', 'no2', 'pm25', 'pm10', 'aq', 'wx',\n",
    "    'hourly', 'daily', 'pivoted', 'totals', 'no2_counts', 'no2_high',\n",
    "    'pm10_high', 'theme_stats', 'var_avgs', 'daily_exceed', 'normed',\n",
    "    'no2_stats', 'pm25_stats', 'base',\n",
    "}\n",
    "\n",
    "def check_sql_anomaly(sql: str) -> dict[str, object]:\n",
    "    \"\"\"Pre-execution anomaly detector. Returns {safe: bool, flags: list}.\"\"\"\n",
    "    flags: list[str] = []\n",
    "    sql_upper = sql.upper().strip()\n",
    "\n",
    "    # R1: SQL injection patterns\n",
    "    injection_patterns = [\n",
    "        r\"'\\s*OR\\s+'\\d+'\\s*=\\s*'\\d+'\",     # ' OR '1'='1'\n",
    "        r\"'\\s*OR\\s+1\\s*=\\s*1\",              # ' OR 1=1\n",
    "        r\";\\s*--\",                           # ; --\n",
    "        r\"UNION\\s+ALL\\s+SELECT\\s+.+FROM\",   # UNION ALL SELECT ... FROM\n",
    "    ]\n",
    "    for pattern in injection_patterns:\n",
    "        if re.search(pattern, sql, re.IGNORECASE):\n",
    "            flags.append(\"R1_INJECTION\")\n",
    "            break\n",
    "\n",
    "    # R2: Destructive statements (simplified to a single regex)\n",
    "    if re.search(\n",
    "        r'\\b(DROP|DELETE|UPDATE|INSERT|ALTER|TRUNCATE|CREATE\\s+TABLE|REPLACE\\s+INTO)\\b',\n",
    "        sql, re.IGNORECASE\n",
    "    ):\n",
    "        flags.append(\"R2_DESTRUCTIVE\")\n",
    "\n",
    "    # R3: Schema mismatch — extract FROM/JOIN table references\n",
    "    table_refs = re.findall(r'(?:FROM|JOIN)\\s+([a-zA-Z_][a-zA-Z0-9_]*)', sql, re.IGNORECASE)\n",
    "    for t in table_refs:\n",
    "        if t.lower() not in VALID_TABLES and t.lower() not in _KNOWN_ALIASES:\n",
    "            flags.append(f\"R3_UNKNOWN_TABLE:{t}\")\n",
    "\n",
    "    # R4: Unbounded scan (SELECT * FROM readings without WHERE or LIMIT)\n",
    "    if re.search(r'SELECT\\s+\\*\\s+FROM\\s+readings', sql, re.IGNORECASE):\n",
    "        if 'WHERE' not in sql_upper and 'LIMIT' not in sql_upper:\n",
    "            flags.append(\"R4_UNBOUNDED_SCAN\")\n",
    "\n",
    "    # R5: Syntax — unmatched parentheses\n",
    "    if sql.count('(') != sql.count(')'):\n",
    "        flags.append(\"R5_UNMATCHED_PARENS\")\n",
    "\n",
    "    # R5b: Missing FROM in SELECT statement (allow literal-value selects)\n",
    "    if 'SELECT' in sql_upper and 'FROM' not in sql_upper:\n",
    "        if not re.search(r\"SELECT\\s+\\d+|SELECT\\s+'\", sql, re.IGNORECASE):\n",
    "            flags.append(\"R5_MISSING_FROM\")\n",
    "\n",
    "    # R6: Information leak — system table access\n",
    "    leak_patterns = [\"PRAGMA\", \"SQLITE_MASTER\", \"SQLITE_SCHEMA\",\n",
    "                     \"INFORMATION_SCHEMA\", \"SYS.\", \"DBA_\"]\n",
    "    for lp in leak_patterns:\n",
    "        if lp in sql_upper:\n",
    "            flags.append(\"R6_INFO_LEAK\")\n",
    "            break\n",
    "\n",
    "    return {\"safe\": len(flags) == 0, \"flags\": flags}\n",
    "\n",
    "# ── Test anomaly detector ────────────────────────────────────\n",
    "test_cases = [\n",
    "    (\"SELECT sensor_name FROM sensors;\", True),\n",
    "    (\"DROP TABLE sensors;\", False),\n",
    "    (\"SELECT * FROM readings; -- comment\", False),\n",
    "    (\"SELECT * FROM nonexistent_table;\", False),\n",
    "    (\"PRAGMA table_info(sensors);\", False),\n",
    "    (\"SELECT sensor_name FROM sensors WHERE broker_name = '' OR '1'='1';\", False),\n",
    "]\n",
    "\n",
    "print(\"Anomaly detector tests:\")\n",
    "all_pass = True\n",
    "for sql, expected_safe in test_cases:\n",
    "    result = check_sql_anomaly(sql)\n",
    "    status = \"PASS\" if result[\"safe\"] == expected_safe else \"FAIL\"\n",
    "    if status == \"FAIL\":\n",
    "        all_pass = False\n",
    "    print(f\"  {status}: safe={result['safe']} (expected={expected_safe}) | {sql[:60]}\")\n",
    "    if result[\"flags\"]:\n",
    "        print(f\"         flags: {result['flags']}\")\n",
    "\n",
    "print(f\"\\nAnomaly detector defined with 6 rule classes. All tests: {'PASS' if all_pass else 'FAIL'}\")\n"
   ]
