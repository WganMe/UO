    "# pyright: reportUnknownMemberType=false, reportUnknownVariableType=false, reportUnknownArgumentType=false, reportMissingTypeStubs=false, reportIndexIssue=false, reportUnknownParameterType=false, reportAttributeAccessIssue=false, reportCallIssue=false, reportOperatorIssue=false, reportConstantRedefinition=false, reportPossiblyUnboundVariable=false, reportMissingImports=false, reportUnnecessaryIsInstance=false, reportPrivateImportUsage=false, reportMissingParameterType=false, reportUnusedImport=false, reportArgumentType=false, reportMissingTypeArgument=false, reportUndefinedVariable=false, reportGeneralTypeIssues=false, reportOptionalMemberAccess=false, reportOptionalSubscript=false, reportOptionalIterable=false, reportOptionalCall=false, reportReturnType=false, reportAssignmentType=false, reportOptionalOperand=false, reportUnnecessaryComparison=false, reportUnusedFunction=false, reportUnusedVariable=false, reportUnboundVariable=false, reportUnknownLambdaType=false, reportUnusedClass=false, reportMissingModuleSource=false\n",
    "from IPython.display import display\n",
    "# ── All-theme variable registry ───────────────────────────────────────────────\n",
    "# Covers all 15 Urban Observatory themes.\n",
    "# Variable names match the Urban Observatory API variable column exactly.\n",
    "ALL_THEME_VARIABLES = {\n",
    "    \"Air Quality\":      [\"NO2\", \"PM2.5\", \"PM10\", \"O3\", \"CO\"],\n",
    "    \"Traffic\":          [\"Vehicle_Count\", \"Vehicle_Speed\", \"Occupancy\", \"Pedestrian_Count\"],\n",
    "    \"Weather\":          [\"Temperature\", \"Relative_Humidity\", \"Wind_Speed\", \"Wind_Direction\",\n",
    "                         \"Rainfall\", \"Atmospheric_Pressure\", \"Solar_Radiation\"],\n",
    "    \"Noise\":            [\"LAeq_1min\", \"LA90_1min\"],\n",
    "    \"Water Quality\":    [\"River_Level\", \"River_Discharge\", \"Conductivity\", \"pH\", \"Turbidity\"],\n",
    "    \"Environment\":      [\"Soil_Moisture\", \"Leaf_Wetness\"],\n",
    "    \"Building\":         [\"Indoor_Temperature\", \"CO2_Indoor\"],\n",
    "}\n",
    "ALL_VARIABLES = [v for vlist in ALL_THEME_VARIABLES.values() for v in vlist]\n",
    "AQ_VARS       = ALL_THEME_VARIABLES[\"Air Quality\"]  # kept for backward compatibility\n",
    "\n",
    "print(f\"All-theme variable registry: {len(ALL_VARIABLES)} variables across {len(ALL_THEME_VARIABLES)} themes\")\n",
    "for theme, vars_ in ALL_THEME_VARIABLES.items():\n",
    "    print(f\"  {theme:20s}: {vars_}\")\n",
    "print()\n",
    "\n",
    "# ── Fetch last 24 h across ALL themes ─────────────────────────────────────────\n",
    "df_aq = fetch_sensor_data_safe(\n",
    "    variables=ALL_VARIABLES,\n",
    "    bbox=BBOX_NEWCASTLE,\n",
    "    last_n_hours=24,\n",
    "    limit=-1\n",
    ")\n",
    "\n",
    "if not df_aq.empty:\n",
    "    print(f\"Rows retrieved : {len(df_aq):,}\")\n",
    "    print(f\"Sensors        : {df_aq['Sensor_Name'].nunique()}\")\n",
    "    print(f\"Variables found: {sorted(df_aq['Variable'].unique().tolist())}\")\n",
    "    print(f\"Time range     : {df_aq['Timestamp'].min()} → {df_aq['Timestamp'].max()}\")\n",
    "    print()\n",
    "    display(df_aq.head(10))\n",
    "else:\n",
    "    print(\"No data returned for the last 24 h in this bounding box.\")\n",
    "    print(\"Falling back to parquet snapshot for last-24h ALL_VARIABLES sample…\")\n",
    "    try:\n",
    "        import duckdb, glob, os\n",
    "        _candidates = []\n",
    "        for _root in (\"/kaggle/input\", \".\"):\n",
    "            _candidates.extend(glob.glob(os.path.join(_root, \"**\", \"*.parquet\"),\n",
    "                                         recursive=True))\n",
    "        if not _candidates:\n",
    "            raise RuntimeError(\"no parquet files found\")\n",
    "        _glob = _candidates[0].rsplit(\"/\", 1)[0] + \"/*.parquet\"\n",
    "        _con  = duckdb.connect()\n",
    "        _cols = _con.execute(f\"SELECT * FROM read_parquet('{_glob}') LIMIT 0\").df().columns.tolist()\n",
    "        def _pick(cands):\n",
    "            for c in cands:\n",
    "                if c in _cols: return c\n",
    "            return None\n",
    "        _name_c = _pick([\"Sensor_Name\", \"Sensor Name\", \"sensor_name\"])\n",
    "        _var_c  = _pick([\"Variable\", \"variable\"])\n",
    "        _val_c  = _pick([\"Value\", \"value\"])\n",
    "        _ts_c   = _pick([\"Timestamp\", \"timestamp\"])\n",
    "        _lon_c  = _pick([\"Sensor_Centroid_Longitude\", \"Sensor Centroid Longitude\", \"longitude\"])\n",
    "        _lat_c  = _pick([\"Sensor_Centroid_Latitude\",  \"Sensor Centroid Latitude\",  \"latitude\"])\n",
    "        if not all([_name_c, _var_c, _val_c, _ts_c]):\n",
    "            raise RuntimeError(f\"missing columns; have {_cols[:8]}…\")\n",
    "        # Use the most recent 24-hour window present in the snapshot\n",
    "        _max_ts = _con.execute(\n",
    "            f\"SELECT max(\\\"{_ts_c}\\\") FROM read_parquet('{_glob}')\"\n",
    "        ).fetchone()[0]\n",
    "        _vars_in = \",\".join(f\"'{v}'\" for v in ALL_VARIABLES)\n",
    "        _bbox_w = \"\"\n",
    "        if _lon_c and _lat_c:\n",
    "            _bbox_w = (f' AND \"{_lon_c}\" BETWEEN {BBOX_NEWCASTLE[0]} AND {BBOX_NEWCASTLE[2]}'\n",
    "                       f' AND \"{_lat_c}\" BETWEEN {BBOX_NEWCASTLE[1]} AND {BBOX_NEWCASTLE[3]}')\n",
    "        df_aq = _con.execute(f\"\"\"\n",
