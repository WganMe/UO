    "# pyright: reportUnknownMemberType=false, reportUnknownVariableType=false, reportUnknownArgumentType=false, reportMissingTypeStubs=false, reportIndexIssue=false, reportUnknownParameterType=false, reportAttributeAccessIssue=false, reportCallIssue=false, reportOperatorIssue=false, reportConstantRedefinition=false, reportPossiblyUnboundVariable=false, reportMissingImports=false, reportUnnecessaryIsInstance=false, reportPrivateImportUsage=false, reportMissingParameterType=false, reportUnusedImport=false, reportArgumentType=false, reportMissingTypeArgument=false, reportUndefinedVariable=false, reportGeneralTypeIssues=false, reportOptionalMemberAccess=false, reportOptionalSubscript=false, reportOptionalIterable=false, reportOptionalCall=false, reportReturnType=false, reportAssignmentType=false, reportOptionalOperand=false, reportUnnecessaryComparison=false, reportUnusedFunction=false, reportUnusedVariable=false, reportUnboundVariable=false, reportUnknownLambdaType=false, reportUnusedClass=false\n",
    "import time\n",
    "from typing import Optional\n",
    "\n",
    "def fetch_sensor_data_safe(\n",
    "    variables: list[str],\n",
    "    bbox: Optional[list[float]] = None,\n",
    "    last_n_hours: Optional[int] = None,\n",
    "    last_n_days: Optional[int] = None,\n",
    "    start: Optional[datetime] = None,\n",
    "    end: Optional[datetime] = None,\n",
    "    limit: int = 1000,\n",
    "    max_retries: int = 3\n",
    ") -> pd.DataFrame:\n",
    "    \"\"\"Fetch sensor data with retry logic and type enforcement.\"\"\"\n",
    "    if not globals().get(\"API_REACHABLE\", True):\n",
    "        print(\"  fetch_sensor_data_safe: API unreachable, returning empty DataFrame\")\n",
    "        return pd.DataFrame()\n",
    "    for attempt in range(max_retries):\n",
    "        try:\n",
    "            df = uo_pyfetch.get_sensor_data(\n",
    "                variables=variables,\n",
    "                bbox=bbox,\n",
    "                last_n_hours=last_n_hours,\n",
    "                last_n_days=last_n_days,\n",
    "                start=start,\n",
    "                end=end,\n",
    "                limit=limit\n",
    "            )\n",
    "            df[\"Timestamp\"] = pd.to_datetime(df[\"Timestamp\"], utc=True)\n",
    "            df[\"Value\"] = pd.to_numeric(df[\"Value\"], errors=\"coerce\")\n",
    "            return df\n",
    "        except Exception as e:\n",
    "            wait = 2 ** attempt\n",
    "            print(f\"Attempt {attempt+1} failed: {e}. Retrying in {wait}s...\")\n",
    "            time.sleep(wait)\n",
    "    print(\"All retries exhausted.\")\n",
    "    return pd.DataFrame()\n",
    "\n",
    "\n",
    "def fetch_all_sensors(bbox: Optional[list[float]] = None, limit: int = -1) -> pd.DataFrame:\n",
    "    \"\"\"Fetch all sensor locations (set limit=-1 for no pagination).\"\"\"\n",
    "    return uo_pyfetch.get_sensors(limit=limit, bbox=bbox)\n",
    "\n",
    "\n",
    "def fetch_sensor_history(\n",
    "    sensor_name: str,\n",
    "    variables: list[str],\n",
    "    start: datetime,\n",
    "    end: datetime,\n",
    "    limit: int = -1\n",
    ") -> pd.DataFrame:\n",
    "    \"\"\"Fetch full history for a single named sensor (safe when API down).\"\"\"\n",
    "    if not globals().get(\"API_REACHABLE\", True):\n",
    "        print(\"  fetch_sensor_history: API unreachable, returning empty DataFrame\")\n",
    "        return pd.DataFrame()\n",
    "    try:\n",
    "        df = uo_pyfetch.get_sensor_data_by_name(\n",
    "            sensor_name,\n",
    "            start=start,\n",
    "            end=end,\n",
    "            variables=variables,\n",
    "            limit=limit,\n",
    "        )\n",
    "    except Exception as _e:\n",
    "        print(f\"  fetch_sensor_history failed ({_e.__class__.__name__}): {_e}\")\n",
    "        return pd.DataFrame()\n",
    "    if df is None or len(df) == 0:\n",
    "        return pd.DataFrame()\n",
    "    df[\"Timestamp\"] = pd.to_datetime(df[\"Timestamp\"], utc=True)\n",
    "    df[\"Value\"] = pd.to_numeric(df[\"Value\"], errors=\"coerce\")\n",
    "    return df\n",
    "\n",
    "\n",
    "print(\"Helper functions defined.\")"
   ]
