nboundVariable=false, reportUnknownLambdaType=false, reportUnusedClass=false\n","# === Bulk archive loader (read-only, static path) ===\n","# Reads the entire pre-converted Urban Observatory archive as a single\n","# pyarrow Dataset. Layouts vary by year:\n","#   <year>/<theme>/<year>-<variable>.parquet                         (full-year files)\n","#   <year>/<theme>/<month-name>/<year>-<m>-<variable>.parquet        (monthly chunks, 2026+)\n","# Years are detected by 4-digit regex; month-name dirs are excluded\n","# from the theme list. Footer-only metadata reads — no row data loaded.\n","\n","import re\n","try:\n","    import pyarrow.dataset as ds\n","    import pyarrow.parquet as pq\n","except ImportError:\n","    import subprocess as _sp, sys as _sys\n","    print(\"  installing pyarrow ...\")\n","    _sp.run([_sys.executable, \"-m\", \"pip\", \"install\", \"-q\", \"pyarrow\"], check=True)\n","    import pyarrow.dataset as ds\n","    import pyarrow.parquet as pq\n","\n","_YEAR_RE = re.compile(r\"^\\d{4}$\")\n","_MONTHS = {\n","    \"January\", \"February\", \"March\", \"April\", \"May\", \"June\",\n","    \"July\", \"August\", \"September\", \"October\", \"November\", \"December\",\n","}\n","\n","ARCHIVE_DATASET = None\n","ARCHIVE_FILES: list[Path] = []\n","ARCHIVE_TOTAL_ROWS = 0\n","\n","if ARCHIVE_BULK_AVAILABLE:\n","    ARCHIVE_FILES = sorted(ARCHIVE_BULK.rglob(\"*.parquet\"))\n","    ARCHIVE_DATASET = ds.dataset(\n","        [str(p) for p in ARCHIVE_FILES],\n","        format=\"parquet\",\n","    )\n","    # Sum row counts via parquet footers (no data read).\n","    for p in ARCHIVE_FILES:\n","        try:\n","            ARCHIVE_TOTAL_ROWS += pq.ParquetFile(p).metadata.num_rows\n","        except Exception:\n","            pass\n","\n","    years: set[str] = set()\n","    themes: set[str] = set()\n","    for p in ARCHIVE_FILES:\n","        for part in p.relative_to(ARCHIVE_BULK).parts:\n","            if _YEAR_RE.fullmatch(part):\n","                years.add(part)\n","            elif part not in _MONTHS and not part.endswith(\".parquet\"):\n","                themes.add(part)\n","\n","    years_s = sorted(years)\n","    themes_s = sorted(themes)\n","    print(f\"Bulk archive: {len(ARCHIVE_FILES):,} parquet files\")\n","    print(f\"  total rows : {ARCHIVE_TOTAL_ROWS:,}\")\n","    if years_s:\n","        print(f\"  years      : {years_s[0]} → {years_s[-1]} ({len(years_s)} years)\")\n","    print(f\"  themes     : {len(themes_s)}  ({', '.join(themes_s)})\")\n","    print(f\"  schema     : {ARCHIVE_DATASET.schema.names}\")\n","    print()\n","    print(\"Use:  ARCHIVE_DATASET.to_table(filter=..., columns=...)\")\n","    print(\"Or :  ARCHIVE_DATASET.scanner(...).to_reader()  # streaming\")\n","else:\n","    print(f\"Bulk archive NOT FOUND at {ARCHIVE_BULK}\")\n","    print(\"Either run scripts/convert_archive_safe.py locally,\")\n","    print(\"or upload the archive_bulk/ folder to Google Drive.\")"]},{"cell_type":"code","execution_count":6,"id":"4dde4dee","metadata":{"execution":{"iopub.execute_input":"2026-08-30T04:33:55.853682Z","iopub.status.busy":"2026-08-30T04:33:55.853089Z","iopub.status.idle":"2026-08-30T04:33:55.863734Z","shell.execute_reply":"2026-08-30T04:33:55.862168Z"},"papermill":{"duration":0.053495,"end_time":"2026-08-30T04:33:55.866213","exception":false,"start_time":"2026-08-30T04:33:55.812718","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["No GPU detected (nvidia-smi not found). Currently running on CPU.\n","To enable GPU: Runtime > Change runtime type > GPU > A100\n"]}],"source":["# pyright: reportUnknownMemberType=false, reportUnknownVariableType=false, reportUnknownArgumentType=false, reportMissingTypeStubs=false, reportIndexIssue=false, reportUnknownParameterType=false, reportAttributeAccessIssue=false, reportCallIssue=false, reportOperatorIssue=false, reportConstantRedefinition=false, reportPossiblyUnboundVariable=false, reportMissingImports=false, re