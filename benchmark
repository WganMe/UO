    "# pyright: reportUnknownMemberType=false, reportUnknownVariableType=false, reportUnknownArgumentType=false, reportMissingTypeStubs=false, reportIndexIssue=false, reportUnknownParameterType=false, reportAttributeAccessIssue=false, reportCallIssue=false, reportOperatorIssue=false, reportConstantRedefinition=false, reportPossiblyUnboundVariable=false, reportMissingImports=false, reportUnnecessaryIsInstance=false, reportPrivateImportUsage=false, reportMissingParameterType=false, reportUnusedImport=false, reportArgumentType=false, reportMissingTypeArgument=false, reportUndefinedVariable=false, reportGeneralTypeIssues=false, reportOptionalMemberAccess=false, reportOptionalSubscript=false, reportOptionalIterable=false, reportOptionalCall=false, reportReturnType=false, reportAssignmentType=false, reportOptionalOperand=false, reportUnnecessaryComparison=false, reportUnusedFunction=false, reportUnusedVariable=false, reportUnboundVariable=false, reportUnknownLambdaType=false, reportUnusedClass=false\n",
    "# ── Chapter 5 figures + Spearman ρ table ─────────────────────────────────────\n",
    "# Recker §7.8: bar, stacked column, heat map, box plot, correlogram.\n",
    "# Inputs : all_experiment_results.csv (already on disk).\n",
    "# Outputs: data_export/figures/*.pdf  and  data_export/tables/tab_spearman.tex\n",
    "import json\n",
    "from pathlib import Path\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "from matplotlib.colors import LinearSegmentedColormap\n",
    "from matplotlib.ticker import FuncFormatter\n",
    "from scipy import stats\n",
    "\n",
    "# ── Load results ─────────────────────────────────────────────────────────────\n",
    "_root = Path(globals().get(\"WORK_ROOT\", \".\"))\n",
    "# Prefer combined (few-shot + RAG) if present, else few-shot only.\n",
    "_combined = _root / \"data_export\" / \"all_experiment_results_combined.csv\"\n",
    "_RES = _combined if _combined.exists() else _root / \"data_export\" / \"all_experiment_results.csv\"\n",
    "_FIGS_OK = False\n",
    "if not _RES.exists():\n",
    "    print(f\"SKIP figures — {_RES} not found. Run cell 50 (few-shot benchmark) first.\")\n",
    "else:\n",
    "    df_fig = pd.read_csv(_RES)\n",
    "    if df_fig.empty:\n",
    "        print(f\"SKIP figures — {_RES} is empty.\")\n",
    "    else:\n",
    "        df_fig[\"correct\"] = df_fig[\"correct\"].astype(int)\n",
    "        df_fig[\"tier_num\"] = df_fig[\"tier\"].astype(str).str.extract(r\"(\\d+)\").astype(int)\n",
    "        df_fig[\"model_label\"] = df_fig[\"model\"].str.split(\"/\").str[-1]\n",
    "        if \"error_msg\" not in df_fig.columns and \"error\" in df_fig.columns:\n",
    "            df_fig[\"error_msg\"] = df_fig[\"error\"]\n",
    "        if \"error_msg\" not in df_fig.columns:\n",
    "            df_fig[\"error_msg\"] = \"\"\n",
    "        if \"latency_s\" not in df_fig.columns:\n",
    "            df_fig[\"latency_s\"] = float(\"nan\")\n",
    "        _FIGS_OK = True\n",
    "\n",
    "if _FIGS_OK:\n",
    "\n",
    "    _FIG_DIR = _root / \"data_export\" / \"figures\"; _FIG_DIR.mkdir(parents=True, exist_ok=True)\n",
    "    _TAB_DIR = _root / \"data_export\" / \"tables\";  _TAB_DIR.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "    # Consistent model order (best→worst overall) for every figure\n",
    "    _order = (df_fig.groupby(\"model_label\")[\"correct\"].mean()\n",
    "              .sort_values(ascending=False).index.tolist())\n",
    "\n",
    "    plt.rcParams.update({\n",
    "        \"font.size\": 11, \"axes.titlesize\": 12, \"axes.labelsize\": 11,\n",
    "        \"xtick.labelsize\": 10, \"ytick.labelsize\": 10, \"legend.fontsize\": 10,\n",
    "        \"pdf.fonttype\": 42, \"savefig.bbox\": \"tight\", \"savefig.dpi\": 200,\n",
    "    })\n",
    "\n",
    "    def _wilson_ci(k: int, n: int, z: float = 1.96) -> tuple[float, float]:\n",
    "        \"\"\"Wilson score 95% CI for a proportion (Lind ch. 9 / Walpole §9.7).\"\"\"\n",
    "        if n == 0: return (0.0, 0.0)\n",
    "        p = k / n\n",
    "        denom = 1 + z*z/n\n",
    "        centre = (p + z*z/(2*n)) / denom\n",
    "        half = (z * ((p*(1-p)/n + z*z/(4*n*n)) ** 0.5)) / denom\n",
    "        return (max(0.0, centre - half), min(1.0, centre + half))\n",
    "\n",
    "    # ── Figure 1: Accuracy bar with 95 % Wilson CI (H1) ──────────────────────────\n",
    "    fig, ax = plt.subplots(figsize=(7.0, 4.2))\n",
    "    means, lo, hi = [], [], []\n",
    "    for m in _order:\n",
    "        s = df_fig[df_fig[\"model_label\"] == m]\n",
    "        k, n = int(s[\"correct\"].sum()), len(s)\n",
    "        means.append(k / n)\n",
    "        l, h = _wilson_ci(k, n)\n",
    "        lo.append(means[-1] - l); hi.append(h - means[-1])\n",
    "    xs = np.arange(len(_order))\n",
    "    ax.bar(xs, means, yerr=[lo, hi], capsize=4, color=\"#3B6FB6\", edgecolor=\"black\", linewidth=0.6)\n",
    "    for i, mu in enumerate(means):\n",
    "        ax.text(i, mu + hi[i] + 0.01, f\"{mu*100:.1f}%\", ha=\"center\", fontsize=9)\n",
    "    ax.set_xticks(xs); ax.set_xticklabels(_order, rotation=20, ha=\"right\")\n",
    "    ax.set_ylabel(\"Execution accuracy\"); ax.set_ylim(0, 1.0)\n",
    "    ax.set_title(\"Overall NL→SQL accuracy by model (95% Wilson CI)\")\n",
    "    ax.yaxis.set_major_formatter(FuncFormatter(lambda x, _: f\"{x*100:.0f}%\"))\n",
    "    ax.grid(axis=\"y\", linestyle=\":\", alpha=0.5)\n",
    "    plt.savefig(_FIG_DIR / \"fig_accuracy_bar.pdf\"); plt.close(fig)\n",
    "    print(\"  ✓ fig_accuracy_bar.pdf\")\n",
    "\n",
    "    # ── Figure 2: Stacked outcomes (correct / wrong / error) ─────────────────────\n",
    "    def _outcome(row):\n",
    "        if row[\"correct\"] == 1: return \"correct\"\n",
    "        msg = str(row.get(\"error_msg\", \"\")).strip()\n",
    "        if msg and msg.lower() != \"nan\": return \"error\"\n",
    "        return \"wrong\"\n",
    "    df_fig[\"outcome\"] = df_fig.apply(_outcome, axis=1)\n",
    "    ct = (df_fig.groupby([\"model_label\", \"outcome\"]).size().unstack(fill_value=0)\n",
    "          .reindex(_order).reindex(columns=[\"correct\", \"wrong\", \"error\"], fill_value=0))\n",
    "    totals = ct.sum(axis=1).replace(0, 1)\n",
    "    pct = ct.div(totals, axis=0)\n",
    "\n",
    "    fig, ax = plt.subplots(figsize=(7.0, 4.2))\n",
    "    bottom = np.zeros(len(_order))\n",
    "    colors = {\"correct\": \"#4C9F70\", \"wrong\": \"#D9A441\", \"error\": \"#C7522A\"}\n",
    "    for col in [\"correct\", \"wrong\", \"error\"]:\n",
    "        vals = pct[col].values\n",
    "        ax.bar(_order, vals, bottom=bottom, label=col.capitalize(),\n",
    "               color=colors[col], edgecolor=\"black\", linewidth=0.5)\n",
    "        bottom += vals\n",
    "    ax.set_ylabel(\"Share of questions\"); ax.set_ylim(0, 1.0)\n",
    "    plt.setp(ax.get_xticklabels(), rotation=20, ha=\"right\")\n",
    "    ax.set_title(\"Outcome distribution per model\")\n",
    "    ax.yaxis.set_major_formatter(FuncFormatter(lambda x, _: f\"{x*100:.0f}%\"))\n",
    "    ax.legend(loc=\"lower right\", framealpha=0.9)\n",
    "    ax.grid(axis=\"y\", linestyle=\":\", alpha=0.5)\n",
    "    plt.savefig(_FIG_DIR / \"fig_outcome_stacked.pdf\"); plt.close(fig)\n",
    "    print(\"  ✓ fig_outcome_stacked.pdf\")\n",
    "\n",
    "    # ── Figure 3: Heat map (model × tier accuracy) — H2, H3 ──────────────────────\n",
    "    heat = (df_fig.groupby([\"model_label\", \"tier_num\"])[\"correct\"].mean()\n",
    "            .unstack(fill_value=np.nan).reindex(_order))\n",
    "    heat = heat[sorted(heat.columns)]\n",
    "    fig, ax = plt.subplots(figsize=(6.5, 0.55 * len(_order) + 1.5))\n",
    "    cmap = LinearSegmentedColormap.from_list(\"acc\", [\"#C7522A\", \"#F4E1A4\", \"#4C9F70\"])\n",
    "    im = ax.imshow(heat.values, cmap=cmap, vmin=0, vmax=1, aspect=\"auto\")\n",
    "    ax.set_xticks(range(len(heat.columns)))\n",
    "    ax.set_xticklabels([f\"T{c}\" for c in heat.columns])\n",
    "    ax.set_yticks(range(len(heat.index)))\n",
    "    ax.set_yticklabels(heat.index)\n",
    "    ax.set_xlabel(\"Question complexity tier\"); ax.set_title(\"Accuracy by model × tier\")\n",
    "    for i in range(heat.shape[0]):\n",
    "        for j in range(heat.shape[1]):\n",
    "            v = heat.values[i, j]\n",
    "            if not np.isnan(v):\n",
    "                ax.text(j, i, f\"{v*100:.0f}\", ha=\"center\", va=\"center\",\n",
    "                        color=\"black\" if 0.30 < v < 0.80 else \"white\", fontsize=9)\n",
    "    cbar = plt.colorbar(im, ax=ax, fraction=0.04, pad=0.03)\n",
    "    cbar.ax.set_ylabel(\"Accuracy\", rotation=90, labelpad=8)\n",
    "    plt.savefig(_FIG_DIR / \"fig_tier_heatmap.pdf\"); plt.close(fig)\n",
    "    print(\"  ✓ fig_tier_heatmap.pdf\")\n",
    "\n",
    "    # ── Figure 4: Latency box plot per model ─────────────────────────────────────\n",
    "    fig, ax = plt.subplots(figsize=(7.0, 4.2))\n",
    "    lat_data = [df_fig.loc[df_fig[\"model_label\"] == m, \"latency_s\"].dropna().values\n",
    "                for m in _order]\n",
    "    bp = ax.boxplot(lat_data, tick_labels=_order, showfliers=False, patch_artist=True,\n",
    "                    medianprops={\"color\": \"black\", \"linewidth\": 1.5})\n",
    "    for patch in bp[\"boxes\"]:\n",
    "        patch.set_facecolor(\"#9DB4D6\"); patch.set_edgecolor(\"black\")\n",
    "    ax.set_ylabel(\"Latency (s)\"); ax.set_title(\"Per-call latency by model\")\n",
    "    plt.setp(ax.get_xticklabels(), rotation=20, ha=\"right\")\n",
    "    ax.grid(axis=\"y\", linestyle=\":\", alpha=0.5)\n",
    "    plt.savefig(_FIG_DIR / \"fig_latency_box.pdf\"); plt.close(fig)\n",
    "    print(\"  ✓ fig_latency_box.pdf\")\n",
    "\n",
    "    # ── Figure 5 + Table: Spearman ρ (tier rank vs correctness) per model — H3 ──\n",
    "    rho_rows = []\n",
    "    for m in _order:\n",
    "        s = df_fig[df_fig[\"model_label\"] == m]\n",
    "        if s[\"tier_num\"].nunique() < 2:\n",
    "            rho, p = float(\"nan\"), float(\"nan\")\n",
    "        else:\n",
    "            rho, p = stats.spearmanr(s[\"tier_num\"], s[\"correct\"])\n",
    "        rho_rows.append({\"model\": m, \"rho\": rho, \"p_value\": p, \"n\": len(s)})\n",
    "    # Pooled\n",
    "    rho_all, p_all = stats.spearmanr(df_fig[\"tier_num\"], df_fig[\"correct\"])\n",
    "    rho_rows.append({\"model\": \"ALL (pooled)\", \"rho\": float(rho_all),\n",
    "                     \"p_value\": float(p_all), \"n\": len(df_fig)})\n",
    "    rho_df = pd.DataFrame(rho_rows)\n",
    "\n",
    "    # Correlogram-style figure (one bar per model, signed)\n",
    "    fig, ax = plt.subplots(figsize=(7.0, 4.0))\n",
    "    plot_df = rho_df[rho_df[\"model\"] != \"ALL (pooled)\"]\n",
    "    bar_colors = [\"#C7522A\" if v < 0 else \"#3B6FB6\" for v in plot_df[\"rho\"]]\n",
    "    ax.barh(plot_df[\"model\"], plot_df[\"rho\"], color=bar_colors, edgecolor=\"black\", linewidth=0.6)\n",
    "    for i, (rho, p) in enumerate(zip(plot_df[\"rho\"], plot_df[\"p_value\"])):\n",
    "        star = \"***\" if p < 0.001 else (\"**\" if p < 0.01 else (\"*\" if p < 0.05 else \"\"))\n",
    "        ax.text(rho + (0.01 if rho >= 0 else -0.01), i,\n",
    "                f\"{rho:+.2f}{star}\", va=\"center\",\n",
    "                ha=\"left\" if rho >= 0 else \"right\", fontsize=9)\n",
    "    ax.axvline(0, color=\"black\", linewidth=0.8)\n",
    "    ax.set_xlabel(r\"Spearman $\\rho$ (tier rank vs correctness)\")\n",
    "    ax.set_title(\"H3: Accuracy decreases with question complexity\")\n",
    "    ax.invert_yaxis()\n",
    "    xmax = max(0.05, float(np.nanmax(np.abs(plot_df[\"rho\"].values))) + 0.10)\n",
    "    ax.set_xlim(-xmax, xmax)\n",
    "    ax.grid(axis=\"x\", linestyle=\":\", alpha=0.5)\n",
    "    plt.savefig(_FIG_DIR / \"fig_spearman_correlogram.pdf\"); plt.close(fig)\n",
    "    print(\"  ✓ fig_spearman_correlogram.pdf\")\n",
    "\n",
    "    # Spearman LaTeX table\n",
    "    def _fmt_p(p):\n",
    "        if pd.isna(p): return \"--\"\n",
    "        if p < 0.001: return r\"$<\\!0.001$\"\n",
    "        return f\"{p:.3f}\"\n",
    "    def _star(p):\n",
    "        if pd.isna(p): return \"\"\n",
    "        if p < 0.001: return r\"$^{***}$\"\n",
    "        if p < 0.01:  return r\"$^{**}$\"\n",
    "        if p < 0.05:  return r\"$^{*}$\"\n",
    "        return \"\"\n",
    "    _tex = [\n",
    "        r\"\\begin{table}[ht]\",\n",
    "        r\"\\centering\",\n",
    "        r\"\\caption{Spearman rank correlation between question complexity tier (T1--T5) \"\n",
    "        r\"and per-question SQL execution accuracy. Negative $\\rho$ supports H3 \"\n",
    "        r\"(accuracy decreases as complexity increases). $^{*}p<0.05$, $^{**}p<0.01$, $^{***}p<0.001$.}\",\n",
    "        r\"\\label{tab:spearman}\",\n",
    "        r\"\\begin{tabular}{lrrr}\",\n",
    "        r\"\\toprule\",\n",
    "        r\"Model & $\\rho$ & $p$-value & $N$ \\\\\",\n",
    "        r\"\\midrule\",\n",
    "    ]\n",
    "    for r in rho_rows:\n",
    "        name = r[\"model\"].replace(\"_\", r\"\\_\")\n",
    "        rho_s = \"--\" if pd.isna(r[\"rho\"]) else f\"{r['rho']:+.3f}{_star(r['p_value'])}\"\n",
